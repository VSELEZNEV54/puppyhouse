{#- /podbor-porody/ — breed quiz (assets/js/choice.js), quick answers to the semantic queries, the 4-breed table,
    links to the four breed pages «Чем хорош щенок …», «Щенки в наличии» (8: two of every breed), collapsed SEO text.
    Context from routes/choice.py: qz (copy + breeds + results + catalog), why_links.
    Client 21.10: main buttons coral and white as on the homepage (body .page-quiz, main.css); «Всё о породе»,
    «Сравнить породы», «Все породы в таблице» are plain white outline buttons, not coral. -#}
{% extends "layouts/page.html.j2" %}
{% import "choice/_parts.html.j2" as part %}

{% block body_attrs %} class="page-quiz"{% endblock %}

{% block page_css %}
  <link rel="stylesheet" href="/assets/css/choice.css">
{% endblock %}
{% block page_js %}
  <script src="/assets/js/choice.js" defer></script>
{% endblock %}

{% block sprite_extra %}{{ part.icons() }}{% endblock %}

{% block hero %}
    {% call ui.page_hero(qz.h1, lead=qz.lead, tone='lilac', faces=true, eyebrow=qz.eyebrow) %}
      <a class="btn btn--ink btn--lg" href="#test" data-quiz-start>{{ qz.start }} {{ ui.icon('arrow') }}</a>
      <a class="btn btn--white btn--lg" href="#sravnenie">Сравнить породы</a>
    {% endcall %}
{% endblock %}

{% block body %}
    {%- set n = qz.questions|length %}
    <section class="section section--tight container" id="test" aria-labelledby="test-title">
      {{ ui.section_head(qz.test_title, id='test-title', lead=qz.test_lead) }}
      <p class="cho-nojs">{{ qz.nojs|typo }}</p>
      <div class="cho-quiz" data-quiz data-order="{{ qz.breeds|map(attribute='slug')|join(',') }}" data-hint="{{ qz.pick_hint }}">
        <form class="cho-q" data-quiz-form novalidate>
          <div class="cho-q__top">
            <p class="cho-q__count" aria-hidden="true"><span data-quiz-count>1</span> из&nbsp;{{ n }}</p>
            <div class="cho-q__bar" aria-hidden="true"><span class="cho-q__fill" data-quiz-bar style="--p:{{ (1 / n)|round(4) }}"></span></div>
            <button class="cho-q__back" type="button" data-quiz-back disabled>{{ ui.icon('arrow') }}Назад</button>
          </div>
          {% for q in qz.questions %}
          {%- set qi = loop.index %}
          <fieldset class="cho-q__step" data-step="{{ loop.index0 }}" data-key="{{ q.key }}"{% if not loop.first %} hidden{% endif %}>
            <legend class="cho-q__title" tabindex="-1"><span class="sr-only">Вопрос {{ qi }} из&nbsp;{{ n }}. </span>{{ q.q|typo }}</legend>
            <div class="cho-q__opts cho-q__opts--{{ q.options|length }}">
              {% for o in q.options %}
              {%- set c = ('coral', 'sun', 'sky', 'mint')[loop.index0 % 4] %}
              <input class="cho-opt__input" type="radio" name="{{ q.key }}" id="q-{{ q.key }}-{{ o.key }}" value="{{ o.key }}" data-s="{{ o.s }}">
              <label class="cho-opt" for="q-{{ q.key }}-{{ o.key }}" style="--c:var(--{{ c }});--bg:var(--{{ c }}-50, var(--sand))">
                {{ ui.ico(o.icon, c) }}
                <span class="cho-opt__txt"><span class="cho-opt__label">{{ o.label|typo }}</span><span class="cho-opt__line">{{ o.line|typo }}</span></span>
                <span class="cho-opt__mark" aria-hidden="true">{{ ui.icon('check', sm=true) }}</span>
              </label>
              {% endfor %}
            </div>
          </fieldset>
          {% endfor %}
          <div class="cho-q__foot">
            <p class="cho-q__hint" data-quiz-hint role="status" aria-live="polite"></p>
            <button class="btn btn--ink btn--lg cho-q__next" type="submit" data-quiz-next data-last="Показать результат">Дальше {{ ui.icon('arrow') }}</button>
          </div>
        </form>

        <div class="cho-res" data-quiz-result hidden>
          {% for r in qz.results %}
          {%- set b = r.b %}
          <div class="cho-res__item" id="rezultat-{{ b.slug }}" data-result="{{ b.slug }}" hidden>
            <div class="phero__tile phero--photo tone--{{ b.tone }} cho-res__tile" style="{{ tone_style(b.studio.src) }}">
              <div class="phero__photo"><img src="{{ b.studio.src }}" alt="{{ b.studio.alt|typo }}" width="{{ b.studio.w }}" height="{{ b.studio.h }}" loading="lazy" decoding="async"></div>
              <div class="phero__copy cho-res__copy">
                <p class="eyebrow"><span class="eyebrow__dot" aria-hidden="true"></span>{{ qz.result_eyebrow }}</p>
                <h3 class="cho-res__title" tabindex="-1">{{ b.name|typo }}</h3>
                <p class="phero__lead">{{ r.description|typo }}</p>
                <ul class="cho-res__why">
                  {% for x in r.reasons %}<li data-reason="{{ x.key }}" hidden><span class="cho-res__tick" aria-hidden="true">{{ ui.icon('check', sm=true) }}</span><span>{{ x.text|typo }}</span></li>{% endfor %}
                  {% for t in r.defaults %}<li data-reason-default><span class="cho-res__tick" aria-hidden="true">{{ ui.icon('check', sm=true) }}</span><span>{{ t|typo }}</span></li>{% endfor %}
                </ul>
                <div class="phero__actions">
                  <a class="btn btn--ink btn--lg" href="{{ b.urls.hub }}#shchenki">Смотреть щенков {{ ui.icon('arrow') }}</a>
                  <button class="btn btn--white btn--lg" type="button" data-open-modal data-modal-kind="price" data-modal-breed="{{ b.slug }}" data-modal-sub="Пришлём щенков {{ b.name_gen }} в наличии с ценами и видео">Узнать цену</button>
                </div>
              </div>
            </div>
          </div>
          {% endfor %}

          <div class="cho-res__row">
            <div class="cho-res__card cho-res__notes">
              {% for r in qz.results %}<p class="cho-res__note" data-honest="{{ r.b.slug }}" hidden>{{ ui.ico('info', 'sky', sm=true) }}<span>{{ r.honest|typo }}</span></p>{% endfor %}
              <p class="cho-res__note" data-quiz-allergy hidden>{{ ui.ico('alert', 'sun', sm=true) }}<span>{{ qz.allergy_note|typo }}</span></p>
            </div>
            <div class="cho-res__card cho-res__alt">
              {% for s in qz.breeds %}
              <div class="cho-alt" data-alt="{{ s.slug }}" hidden>
                <div class="cho-alt__head">
                  {{ ui.face(s) }}
                  <p class="cho-alt__txt"><span class="cho-alt__label">{{ qz.second_label }}</span><span class="cho-alt__name">{{ s.name|typo }}</span></p>
                </div>
                <p class="cho-alt__links">
                  <a class="btn btn--white" href="{{ s.urls.hub }}">Всё о&nbsp;породе</a>
                  {#- the comparison table of all breeds on the second breed's page «Чем хорош щенок …» -#}
                  {% for w in qz.breeds if w.slug != s.slug %}
                  <a class="btn btn--white" href="/sravnenie/{{ s.slug }}/#sravnenie" data-win="{{ w.slug }}" hidden>Сравнить породы</a>
                  {% endfor %}
                </p>
              </div>
              {% endfor %}
            </div>
            <div class="cho-res__card cho-res__again">
              <p class="cho-alt__txt"><span class="cho-alt__label">Не&nbsp;тот результат?</span><span class="cho-alt__name">Ответьте ещё раз</span></p>
              <p class="cho-alt__links">
                <button class="btn btn--white" type="button" data-quiz-restart>{{ ui.icon('reset', sm=true) }}{{ qz.restart }}</button>
                <a class="btn btn--white" href="#sravnenie">Все породы в&nbsp;таблице</a>
              </p>
            </div>
          </div>
        </div>
      </div>
    </section>

    <section class="section container" id="otvety" aria-labelledby="otvety-title">
      {{ ui.section_head(qz.answers_title, id='otvety-title', lead=qz.answers_lead) }}
      <ul class="cho-ans" data-reveal="items">
        {% for a in qz.answers %}
        <li class="cho-ans__card">
          {{ ui.ico(a.icon, a.color) }}
          <h3 class="cho-ans__title">{{ a.title|typo }}</h3>
          <p class="cho-ans__line">{{ a.line|typo }}</p>
          <ul class="cho-ans__breeds">
            {% for b in a.breeds %}<li><a class="cho-chip" href="{{ b.urls.hub }}">{{ ui.face(b) }}<span>{{ b.name|typo }}</span></a></li>{% endfor %}
          </ul>
        </li>
        {% endfor %}
      </ul>
    </section>

    <section class="section container" id="sravnenie" aria-labelledby="sravnenie-title">
      {{ ui.section_head(qz.table_title, id='sravnenie-title', lead=qz.table_lead) }}
      {{ ui.cmp_table(qz.cols, qz.rows, caption='Сравнение четырёх пород: мальтипу, французский бульдог, той-пудель, бордер-колли') }}
      {{ part.pills(why_links, qz.pairs_label, 'pary-label') }}
    </section>

{% endblock %}

{#- «Щенки в наличии»: 8 карточек, по две каждой породы (в каждом ряду из четырёх — все породы), кнопка под ними -#}
{% block pups %}
    <section class="section container" id="pups" aria-labelledby="pups-title">
      {{ ui.section_head('Щенки в наличии', id='pups-title') }}
      <ul class="pups hm-pups cho-pups" data-reveal="items">
        {% for p in qz.catalog %}
        <li class="pups__item">
          {{ cards.puppy_card(p) }}
        </li>
        {% endfor %}
      </ul>
      <div class="hm-pups__foot">
        <a class="btn btn--ink btn--lg" href="/shchenki/">Весь каталог {{ ui.icon('arrow') }}</a>
      </div>
    </section>
{% endblock %}

{% block seo %}
    {% call blocks.seo_block(qz.seo.title, qz.seo.lead, id='kak-vybrat') %}
        {% for s in qz.seo.blocks %}
        <h3>{{ s.h|typo }}</h3>
        <p>{{ s.p|typo }}</p>
        {% endfor %}
    {% endcall %}
{% endblock %}
