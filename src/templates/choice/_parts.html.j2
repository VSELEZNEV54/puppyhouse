{#- Pill links (round faces + label): items = [{url, faces: [breed, …], label}] (routes/choice.py: _why_links) -#}
{% macro pills(items, label, id) -%}
<div class="cho-pairs">
  <p class="cho-pairs__label" id="{{ id }}">{{ label|typo }}</p>
  <ul class="cho-pairs__list" aria-labelledby="{{ id }}">
    {% for p in items %}
    <li><a class="cho-pair" href="{{ p.url }}"><span class="cho-pair__faces" aria-hidden="true">{% for f in p.faces %}{{ ui.face(f) }}{% endfor %}</span><span class="cho-pair__label">{{ p.label|typo }}</span></a></li>
    {% endfor %}
  </ul>
</div>
{%- endmacro %}
