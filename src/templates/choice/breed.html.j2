{#- /sravnenie/<breed>/ — «Чем хорош щенок …» (×4, one template; «Сравнение пород» in the menu). Context from routes/choice.py:
    b (breeds.json item), pg (copy, Markup: advantages, «Кому подойдёт» photo cards, three «Лучше подобрать другую
    породу» plates, the comparison table, 8 puppies, FAQ, SEO text), com (choice-breeds.json → common), links (hub, price,
    varieties, two articles, quiz), faces (the breed's colours).
    Order (client 21.10): hero (why choose the breed) → advantages → «Кому подойдёт» → «Лучше подобрать другую породу» →
    the comparison table → 8 puppies of the breed → «Пришлём видео и цену» → FAQ → «Читайте также» → SEO text →
    «Полезные статьи» → lead form. Buttons are coral as on the homepage (body .page-compare, main.css). -#}
{% extends "layouts/page.html.j2" %}
{% import "choice/_parts.html.j2" as part %}

{% block body_attrs %} class="page-compare"{% endblock %}

{% block page_css %}
  <link rel="stylesheet" href="/assets/css/choice.css">
{% endblock %}

{% block sprite_extra %}{{ part.icons() }}{% endblock %}

{% block hero %}
    {% call ui.page_hero(pg.h1, lead=pg.lead, breed=b, eyebrow=com.eyebrow) %}
      {{ forms.price_button(cls='btn btn--ink btn--lg', breed=b.name) }}
      <a class="btn btn--white btn--lg" href="#katalog">Щенки в&nbsp;наличии</a>
    {% endcall %}
{% endblock %}

{% block body %}
    {{ ui.advantages(pg.adv, title=pg.adv_title, lead=pg.adv_lead, cols=3, tight=true) }}

    <!-- ================= КОМУ ПОДОЙДЁТ — карточки с фото, как на странице щенка ================= -->
    <section class="section container" id="komu" aria-labelledby="komu-title">
      {{ ui.section_head(pg.fit_title, id='komu-title') }}
      <ul class="cho-fits" data-reveal="items">
        {% for f in pg.fits %}
        {%- set fs = imgsize(f.photo) or [928, 1152] %}
        <li class="cho-fitc {{ b.tone_class }}">
          <span class="cho-fitc__photo"><img src="{{ f.photo }}" alt="{{ f.alt|typo }}" width="{{ fs[0] }}" height="{{ fs[1] }}" style="object-position:{{ f.pos }}" loading="lazy" decoding="async"></span>
          <h3 class="cho-fitc__title">{{ f.title|typo }}</h3>
          <p class="cho-fitc__line">{{ f.line|typo }}</p>
        </li>
        {% endfor %}
      </ul>
    </section>

    <!-- ================= ЛУЧШЕ ПОДОБРАТЬ ДРУГУЮ ПОРОДУ — три плашки с пояснением ================= -->
    <section class="section container" id="drugaya-poroda" aria-labelledby="drugaya-poroda-title">
      {{ ui.section_head(pg.unfit_title, id='drugaya-poroda-title', lead=pg.unfit_lead, link={'url': '/podbor-porody/', 'label': com.unfit_link}) }}
      <ul class="cho-unfit" data-reveal="items">
        {% for u in pg.unfit %}
        <li class="cho-unfit__item">
          <span class="cho-unfit__mark" aria-hidden="true">{{ ui.icon('close', sm=true) }}</span>
          <h3 class="cho-unfit__title">{{ u.title|typo }}</h3>
          <p class="cho-unfit__text">{{ u.text|typo }}</p>
        </li>
        {% endfor %}
      </ul>
    </section>

    <!-- ================= СРАВНЕНИЕ СО ВСЕМИ ПОРОДАМИ — таблица (эта порода первой) ================= -->
    <section class="section container" id="sravnenie" aria-labelledby="sravnenie-title">
      {{ ui.section_head(pg.table_title, id='sravnenie-title', lead=pg.table_lead) }}
      {{ ui.cmp_table(pg.table_cols, pg.table_rows, caption='Сравнение пород: ' ~ (pg.table_cols|map(attribute='name')|join(', '))) }}
    </section>

    <!-- ================= ЩЕНКИ ПОРОДЫ — 8 карточек, как каталог на главной ================= -->
    <section class="section container" id="katalog" aria-labelledby="katalog-title">
      {{ ui.section_head(pg.pups_title, id='katalog-title') }}
      {% if pg.catalog %}
      <ul class="pups hm-pups cho-pups" data-reveal="items">
        {% for p in pg.catalog %}
        <li class="pups__item">
          {{ cards.puppy_card(p) }}
        </li>
        {% endfor %}
      </ul>
      <div class="hm-pups__foot">
        <a class="btn btn--ink btn--lg" href="{{ b.urls.hub }}#shchenki">{{ pg.catalog_button|typo }} {{ ui.icon('arrow') }}</a>
      </div>
      {% else %}
      {{ ui.empty_state('Сейчас щенков нет в наличии', 'Оставьте заявку — напишем, когда появится новый помёт.') }}
      {% endif %}
    </section>

    <section class="section container" id="cena" aria-labelledby="cena-title">
      <div class="cta-band tone--{{ pg.tint }}">
        <div class="cta-band__txt">
          <h2 class="cta-band__title" id="cena-title">{{ com.band_title|typo }}</h2>
          <p class="cta-band__line">{{ pg.band_line|typo }}</p>
        </div>
        {% if faces %}
        <span class="cta-band__faces cho-band__faces" aria-hidden="true">{% for f in faces %}<span class="face"{% if photo_tone(f.src) %} style="--tone:{{ photo_tone(f.src).top }}"{% endif %}><img src="{{ f.src }}" alt="" width="{{ imgsize(f.src)[0] }}" height="{{ imgsize(f.src)[1] }}" loading="lazy" decoding="async"></span>{% endfor %}</span>
        {% endif %}
        <div class="cta-band__actions">
          {{ forms.price_button(cls='btn btn--ink btn--lg', breed=b.name) }}
        </div>
      </div>
    </section>

    {{ blocks.faq_section(pg.faq, title=com.faq_title) }}

    <section class="section container cho-links" id="eshche" aria-labelledby="eshche-title">
      {{ ui.section_head(com.links_title, id='eshche-title') }}
      {{ ui.link_tiles(links) }}
    </section>

    {% call blocks.seo_block(pg.seo.title, pg.seo.lead, id='podrobnee') %}
        {% for s in pg.seo.blocks %}
        <h3>{{ s.h|typo }}</h3>
        <p>{{ s.p|typo }}</p>
        {% endfor %}
    {% endcall %}
{% endblock %}

{#- the breed's puppies are higher on the page (#katalog) — no second strip -#}
{% block pups %}{% endblock %}

{% block lead %}
    {{ forms.lead_form(title=pg.lead_title, line=com.lead_line, tone=b.tone, breed=b.slug) }}
{% endblock %}
