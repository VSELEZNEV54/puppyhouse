{#- Blog parts (group blog): article card, article copy blocks, extra icons.
    Import: {% import "blog/_parts.html.j2" as blg %} -#}
{% import "macros/ui.html.j2" as ui %}
{% import "macros/forms.html.j2" as forms %}

{#- Extra icons for {% block sprite_extra %} (24×24, stroke = currentColor like the shared sprite). Prefix i-blg-. -#}
{% macro icons() -%}
    <symbol id="i-blg-minus" viewBox="0 0 24 24"><path d="M5.5 12h13"/></symbol>
{%- endmacro %}

{#- Article card. c: card dict from routes/blog.py (url, title, line, topic, read, cover, studio, tone_class, style).
    A studio cover stands on the card «floor» in its measured colours (like the puppy card); a lifestyle cover sits
    inside the tile with an inset and a 20 px radius. eager=true: the card is on the first screen (no lazy loading). -#}
{% macro card(c, eager=false) -%}
{%- set size = imgsize(c.cover.src) -%}
{#- studio cover: --tone / --tone-floor for the card -#}
{%- set st = (c.style ~ ';' ~ tone_style(c.cover.src)) if c.studio else '' -%}
<article class="blg-card {{ c.tone_class }}{{ ' blg-card--studio' if c.studio }}"{% if st %} style="{{ st }}"{% endif %}>
  <div class="blg-card__media{{ ' blg-card__media--studio' if c.studio }}">
    <img src="{{ c.cover.src }}" alt="{{ c.cover.alt|typo }}" width="{{ size[0] }}" height="{{ size[1] }}"{% if c.cover.pos is defined and c.cover.pos %} style="object-position:{{ c.cover.pos }}"{% endif %}{% if not eager %} loading="lazy"{% endif %} decoding="async">
    <span class="blg-card__topic">{{ c.topic }}</span>
  </div>
  <div class="blg-card__body">
    <h3 class="blg-card__title"><a class="blg-card__link" href="{{ c.url }}">{{ c.title|typo }}</a></h3>
    <p class="blg-card__line">{{ c.line|typo }}</p>
    <p class="blg-card__foot"><span class="blg-card__time">{{ ui.icon('clock', sm=true) }}<span class="sr-only">Время чтения: </span>{{ c.read }}</span>{{ ui.tile_cta('Читать') }}</p>
  </div>
</article>
{%- endmacro %}

{#- Open request form in the article's right column (client 21.10, instead of «Коротко»): name, phone, «Куда написать»,
    consent. main.js wires every form[data-lead-form] like the form at the bottom; kind «help» (подбор щенка), the
    hidden note names the article, a breed article sends its breed. -#}
{% macro aside_form(post, breed=none) -%}
<section class="blg-form" aria-labelledby="af-title" data-lead-box>
  <p class="blg-form__title" id="af-title">Пришлём варианты щенков</p>
  <p class="blg-form__line">Оставьте телефон — пришлём щенков в&nbsp;наличии, цены и&nbsp;видео</p>
  <form class="form blg-form__form" id="article-form" data-lead-form data-prefix="af" data-kind="help" data-note="Статья блога: {{ post.h1 }}" aria-labelledby="af-title" novalidate>
    <div class="form__grid">
      <div class="field">
        <label class="field__label" for="af-name">Имя</label>
        <input class="input" id="af-name" name="name" type="text" autocomplete="given-name" placeholder="Как к&nbsp;вам обращаться" required aria-describedby="af-name-err">
        <p class="field__err" id="af-name-err" hidden></p>
      </div>
      <div class="field">
        <label class="field__label" for="af-phone">Телефон</label>
        <input class="input" id="af-phone" name="phone" type="tel" inputmode="tel" autocomplete="tel" placeholder="+7 (___) ___-__-__" required aria-describedby="af-phone-err" data-phone>
        <p class="field__err" id="af-phone-err" hidden></p>
      </div>
      {% if breed %}<input type="hidden" name="breed" value="{{ breed.slug }}">{% endif %}
      {{ forms.contact_field('af')|indent(6) }}
      {{ forms.honeypot('af')|indent(6) }}
      {{ forms.consent_check('af')|indent(6) }}
    </div>
    <button class="btn btn--ink btn--lg btn--block form__submit" type="submit" data-submit data-label="Подобрать щенка">Подобрать щенка</button>
  </form>
  <div class="form-fail" data-fail role="alert" hidden>
    {{ forms.send_fail()|indent(4) }}
  </div>
  <div class="form-done" data-done tabindex="-1" hidden>
    <span class="form-done__ico" aria-hidden="true">{{ ui.icon('check') }}</span>
    <p class="form-done__title" data-done-text>Спасибо! Свяжемся с&nbsp;вами в&nbsp;течение рабочего дня</p>
  </div>
</section>
{%- endmacro %}

{#- Article copy: blocks from routes/blog.py (Markup already escaped, links and <b> resolved). -#}
{% macro copy(blocks) -%}
{% for b in blocks %}
{% if b.type == 'p' %}
          <p>{{ b.html|typo }}</p>
{% elif b.type == 'h3' %}
          <h3>{{ b.html|typo }}</h3>
{% elif b.type in ('ul', 'ol') %}
          <{{ b.type }}>
            {% for i in b['items'] %}<li>{{ i|typo }}</li>
            {% endfor %}
          </{{ b.type }}>
{% elif b.type == 'table' %}
          {#- 3+ columns: on phones every row becomes a small card, the column name comes from data-label #}
          <div class="table-wrap blg-table{{ ' blg-table--stack' if b.head|length > 2 }}" role="region" aria-label="{{ b.caption }}" tabindex="0">
            <table>
              <caption class="sr-only">{{ b.caption }}</caption>
              <thead><tr>{% for h in b.head %}{% if h %}<th scope="col">{{ h|typo }}</th>{% else %}<td></td>{% endif %}{% endfor %}</tr></thead>
              <tbody>
                {% for r in b.rows %}<tr><th scope="row">{{ r[0]|typo }}</th>{% for v in r[1:] %}<td data-label="{{ b.labels[loop.index] }}"><span>{{ v|typo }}</span></td>{% endfor %}</tr>
                {% endfor %}
              </tbody>
            </table>
          </div>
{% elif b.type == 'callout' %}
          {% call ui.callout(b.kind, b.title) %}<p>{{ b.html|typo }}</p>{% endcall %}
{% elif b.type == 'proscons' %}
          <div class="blg-pc">
            <div class="blg-pc__col blg-pc__col--pro">
              <h3 class="blg-pc__title">{{ ui.ico('check', 'mint', sm=true) }}Плюсы</h3>
              <ul class="blg-pc__list">
                {% for i in b.pros %}<li>{{ i|typo }}</li>
                {% endfor %}
              </ul>
            </div>
            <div class="blg-pc__col blg-pc__col--con">
              <h3 class="blg-pc__title">{{ ui.ico('blg-minus', 'coral', sm=true) }}Минусы</h3>
              <ul class="blg-pc__list">
                {% for i in b.cons %}<li>{{ i|typo }}</li>
                {% endfor %}
              </ul>
            </div>
          </div>
{% elif b.type == 'figure' %}
          <figure class="blg-figure">{{ ui.img(b.src, b.alt) }}{% if b.caption %}<figcaption>{{ b.caption|typo }}</figcaption>{% endif %}</figure>
{% elif b.type == 'photos' %}
          <div class="blg-photos">{% for p in b['items'] %}{{ ui.img(p.src, p.alt) }}{% endfor %}</div>
{% endif %}
{% endfor %}
{%- endmacro %}
