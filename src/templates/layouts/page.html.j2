{#- Layout for every inner page. READ-ONLY for page-group agents.
    {% extends "layouts/page.html.j2" %} and fill the blocks:
      hero      — ui.page_hero(...) (renders the single H1)            [required]
      body      — the page's own sections                               [required]
      pups      — «Щенки в наличии», the standard 8-card block (cards.pups_std, client 21.10: the same blocks on
                  every page): two puppies of every breed; context `pups_breed` (breeds.json item) makes it the breed's
                  8; `pups_strip = false` hides it (the page places the block itself or lists puppies its own way).
      blog      — «Читайте также» before the lead form (blocks.read_more: 3 articles + 4 plates; the `lead_breed`
                  breed's articles and plates first, the page itself left out of the plates);
                  `blog_strip = false` or an empty block hides it.
      seo       — the page's SEO text (blocks.seo_block). RULE (client 21.10): on every page it stands right before
                  the lead form and after the articles block — put the seo_block call here, never in `body`.
      lead      — final lead form; default forms.lead_form(). Context `lead_breed` preselects a breed.
      page_css / page_js — your group's stylesheet / script (loaded after pages.css / main.js)
    Context:   title, description, breadcrumbs = [["Главная", "/"], ..., ["Текущая", none]] -#}
{% extends "base.html.j2" %}
{% import "macros/ui.html.j2" as ui %}
{% import "macros/cards.html.j2" as cards %}
{% import "macros/forms.html.j2" as forms %}
{% import "macros/blocks.html.j2" as blocks %}
{% import "macros/media.html.j2" as media %}

{% block head_css %}
  <link rel="stylesheet" href="/assets/css/pages.css">
{% block page_css %}{% endblock %}
{% endblock %}

{% block head_js %}
{% block page_js %}{% endblock %}
{% endblock %}

{% block content %}
    {{ ui.breadcrumbs(breadcrumbs) }}

{% block hero %}{% endblock %}

{% block body %}{% endblock %}

{% block pups %}
{% if pups_strip | default(true) %}
    {{ cards.pups_std(breed=pups_breed | default(none)) }}
{% endif %}
{% endblock %}

{% block blog %}
{% if blog_strip | default(true) %}
    {%- set lb = lead_breed | default(none) %}
    {{ blocks.read_more(b=(breed_map[lb] if lb else none), here=page.url) }}
{% endif %}
{% endblock %}

{% block seo %}{% endblock %}

{% block lead %}
    {{ forms.lead_form(breed=(lead_breed | default(none))) }}
{% endblock %}
{% endblock %}
