{#- Shared pieces of the breedsub pages (price and varieties). Import:  {% import "breedsub/_parts.html.j2" as part %}
    Text params are Markup or plain text from routes/breedsub.py; every one goes through |typo. -#}
{% import "macros/ui.html.j2" as ui %}

{#- Extra icons for {% block sprite_extra %} (24×24, stroke = currentColor like the shared sprite) -#}
{% macro icons() -%}
    <symbol id="i-palette" viewBox="0 0 24 24"><path d="M12 3.5a8.5 8.5 0 0 0 0 17c1.1 0 1.8-.7 1.8-1.6 0-1.2-1-1.5-1-2.6 0-.9.7-1.6 1.6-1.6h2.2c2.2 0 3.9-1.6 3.9-3.8 0-4.1-3.8-7.4-8.5-7.4Z"/><circle cx="7.6" cy="11.2" r="1.1" fill="currentColor" stroke="none"/><circle cx="10.2" cy="7.5" r="1.1" fill="currentColor" stroke="none"/><circle cx="14.6" cy="7.6" r="1.1" fill="currentColor" stroke="none"/></symbol>
    <symbol id="i-gender" viewBox="0 0 24 24"><circle cx="10.5" cy="12.5" r="4.6"/><path d="M13.8 9.2 19 4M15.2 4H19v3.8M10.5 17.1v4.4M8.3 19.4h4.4"/></symbol>
    <symbol id="i-chip" viewBox="0 0 24 24"><rect x="6.5" y="6.5" width="11" height="11" rx="2.2"/><rect x="10" y="10" width="4" height="4" rx=".8"/><path d="M10 3.5v3M14 3.5v3M10 17.5v3M14 17.5v3M3.5 10h3M3.5 14h3M17.5 10h3M17.5 14h3"/></symbol>
    <symbol id="i-medal" viewBox="0 0 24 24"><circle cx="12" cy="14.8" r="5.2"/><path d="m8.6 10.9-2.4-7.4h4l2 4.6M15.4 10.9l2.4-7.4h-4l-1.1 2.6M12 12.4l.8 1.6 1.7.25-1.25 1.2.3 1.7L12 16.3l-1.55.85.3-1.7-1.25-1.2 1.7-.25Z"/></symbol>
{%- endmacro %}

{#- Two cards side by side: «no» (white, crosses) and «ok» (breed tint, checks). Used for «Почему не бывает дёшево»
    and for the colour standard. card = {title, items:[{title, line?}], note?, price?, price_label?} — price: the
    approximate range of that side on the price page («50–100 тыс. ₽»). order: 'no-ok' | 'ok-no' -#}
{% macro vs(no, ok, tint, order='no-ok', id='vs') -%}
<div class="bsub-vs">
  {% for side in (['no', 'ok'] if order == 'no-ok' else ['ok', 'no']) %}
  {%- set c = no if side == 'no' else ok %}
  <div class="bsub-vs__card bsub-vs__card--{{ side }}{{ ' tone--' ~ tint if side == 'ok' }}">
    <h3 class="bsub-vs__title" id="{{ id }}-{{ side }}">{{ c.title|typo }}</h3>
    {% if c.get('price') %}<p class="bsub-vs__price">{% if c.get('price_label') %}<span>{{ c.price_label|typo }}</span>{% endif %}<b>{{ c.price|typo }}</b></p>{% endif %}
    <ul class="bsub-vs__list" aria-labelledby="{{ id }}-{{ side }}">
      {% for i in c['items'] %}
      <li class="bsub-vs__item">
        <span class="bsub-vs__mark" aria-hidden="true">{{ ui.icon('check' if side == 'ok' else 'close', sm=true) }}</span>
        <span class="bsub-vs__txt"><span class="bsub-vs__name">{{ i.title|typo }}</span>{% if i.line %}<span class="bsub-vs__line">{{ i.line|typo }}</span>{% endif %}</span>
      </li>
      {% endfor %}
    </ul>
    {% if c.get('note') %}<p class="bsub-vs__note">{{ c.note|typo }}</p>{% endif %}
  </div>
  {% endfor %}
</div>
{%- endmacro %}

{#- CTA band (pages.css .cta-band) with its title as the section's H2 and round faces of the breed's colours.
    faces: [{src, alt}] studio photos of puppies; tint: tone class of the band; breed: breed name to preselect in the modal -#}
{% macro cta(title, line, tint, faces=(), id='cena', breed=none) -%}
<section class="section container" id="{{ id }}" aria-labelledby="{{ id }}-title">
  <div class="cta-band tone--{{ tint }} bsub-cta">
    <div class="cta-band__txt">
      <h2 class="cta-band__title" id="{{ id }}-title">{{ title|typo }}</h2>
      <p class="cta-band__line">{{ line|typo }}</p>
    </div>
    {% if faces %}
    <span class="cta-band__faces bsub-cta__faces" aria-hidden="true">{% for f in faces %}<span class="face"{% if tone_style(f.src) %} style="--tone:{{ photo_tone(f.src).top }}"{% endif %}><img src="{{ f.src }}" alt="" width="{{ imgsize(f.src)[0] }}" height="{{ imgsize(f.src)[1] }}" loading="lazy" decoding="async"></span>{% endfor %}</span>
    {% endif %}
    <div class="cta-band__actions">
      <button class="btn btn--ink btn--lg" type="button" data-open-modal data-modal-kind="price"{% if breed %} data-modal-breed="{{ breed }}"{% endif %}>Узнать цену</button>
    </div>
  </div>
</section>
{%- endmacro %}

{#- Round colour face: the colour's studio shot cropped to the head (on its measured backdrop) or, without a photo,
    a colour dot on the breed's pastel tone. c: item of breedsub.colour_items(); b: the breed -#}
{% macro colour_face(c, b, eager=false) -%}
{%- if c.photo -%}
{%- set size = imgsize(c.photo.src) -%}
<span class="bsub-cface"{% if photo_tone(c.photo.src) %} style="--tone:{{ photo_tone(c.photo.src).top }}"{% endif %} aria-hidden="true"><img src="{{ c.photo.src }}" alt="" width="{{ size[0] }}" height="{{ size[1] }}"{% if not eager %} loading="lazy"{% endif %} decoding="async"></span>
{%- else -%}
<span class="bsub-cface bsub-cface--dot {{ b.tone_class }}"{% if photo_tone(b.studio.src) %} style="--tone:{{ photo_tone(b.studio.src).top }}"{% endif %} aria-hidden="true"><span class="bsub-cface__dot" style="background:{{ c.swatch }}"></span></span>
{%- endif -%}
{%- endmacro %}

{#- Compact colour list: round faces with the colour name under each, every one a link to its card on the
    varieties page (url = /<breed>/vidy-i-okrasy/, '' on that page itself). cta {url, label} → «Все окрасы» pill.
    eager=true: the list is on the first screen (no lazy loading). -#}
{% macro colour_nav(items, b, url='', label='Окрасы', cta=none, eager=false) -%}
<div class="bsub-cnav{{ ' bsub-cnav--cta' if cta }}">
  <ul class="bsub-cnav__list" aria-label="{{ label }}">
    {% for c in items %}
    <li><a class="bsub-cnav__item" href="{{ url }}#{{ c.slug }}">{{ colour_face(c, b, eager) }}<span class="bsub-cnav__name">{{ c.name|typo }}</span></a></li>
    {% endfor %}
  </ul>
  {% if cta %}<div class="bsub-cnav__cta">{{ ui.tile_cta(cta.label, variant='soft', url=cta.url) }}</div>{% endif %}
</div>
{%- endmacro %}

{#- One card per colour, anchored by its slug (links from the hub land here): studio shot on its measured backdrop
    (or a colour dot), standard badge, name, two sentences and «Спросить о щенках» (modal with the colour noted).
    An odd number of colours: the last cell of the two-column grid is a request tile (ask.title, ask.line). -#}
{% macro colour_cards(items, b, ask=none) -%}
<ul class="bsub-cols">
  {% for c in items %}
  <li class="bsub-col" id="{{ c.slug }}">
    <div class="bsub-col__media{{ ' bsub-col__media--dot' if not c.photo }}" style="{{ tone_style(c.photo.src if c.photo else b.studio.src) }}">
      {% if c.photo %}
      {%- set size = imgsize(c.photo.src) %}
      <img src="{{ c.photo.src }}" alt="{{ c.photo.alt|typo }}" width="{{ size[0] }}" height="{{ size[1] }}" loading="lazy" decoding="async">
      {% if c.photo_note %}<span class="bsub-col__pnote">{{ c.photo_note|typo }}</span>{% endif %}
      {% else %}
      <span class="bsub-col__swatch">
        <span class="bsub-col__dot" style="background:{{ c.swatch }}" aria-hidden="true"></span>
        <span class="bsub-col__pnote bsub-col__pnote--dot">Фото по&nbsp;запросу</span>
      </span>
      {% endif %}
    </div>
    <div class="bsub-col__body">
      <span class="bsub-col__badge bsub-col__badge--{{ c.std or 'none' }}">{{ c.badge|typo }}</span>
      <h3 class="bsub-col__name">{{ c.name|typo }}</h3>
      <p class="bsub-col__text">{{ c.text|typo }}</p>
      <button class="btn btn--white bsub-col__btn" type="button" data-open-modal data-modal-kind="colour" data-modal-colour="{{ c.slug }}" data-modal-breed="{{ b.name }}" data-modal-title="{{ b.name }}: {{ c.label|lower }}" data-modal-sub="Пришлём щенков этого окраса с фото, видео и ценой" data-modal-note="Окрас: {{ c.label|lower }}">Спросить о&nbsp;щенках</button>
    </div>
  </li>
  {% endfor %}
  {% if ask and items|length is odd %}
  <li class="bsub-col bsub-col--ask tone--{{ ask.tint }}">
    {{ ui.ico('palette', 'lilac') }}
    <h3 class="bsub-col__name">{{ ask.title|typo }}</h3>
    <p class="bsub-col__text">{{ ask.line|typo }}</p>
    <button class="btn btn--ink" type="button" data-open-modal data-modal-kind="colour" data-modal-breed="{{ b.name }}" data-modal-title="{{ ask.title }}" data-modal-sub="Пришлём щенков нужного окраса с фото, видео и ценой" data-modal-note="Подбор по окрасу">Оставить заявку</button>
  </li>
  {% endif %}
</ul>
{%- endmacro %}

{#- Links to the breed hub and the sibling page -#}
{% macro links(title, items, id='eshche') -%}
<section class="section container" id="{{ id }}" aria-labelledby="{{ id }}-title">
  {{ ui.section_head(title, id=id ~ '-title') }}
  {{ ui.link_tiles(items) }}
</section>
{%- endmacro %}
