{#- /<breed>/vidy-i-okrasy/ — varieties and colours of a breed (client 21.10). One template, blocks in the order of data:
    types (the breed's kinds on one studio photo of adult dogs — a numbered pin on each dog — and a card per kind,
    + sub: the generations F1 / F1b / F2 or what the FCI standard says about colours), colours (the breed page's colour
    carousel: «Подобрать …» and «Подробнее» → the colour page), tips. Then the breed's 8 puppies + «Все щенки …»,
    FAQ, «Читайте также» (articles + plates), SEO text, the homepage-size lead form with contact tiles.
    Context from routes/breedsub.py: b (breed), v (copy, Markup), tint. Main buttons coral (body .page-varieties). -#}
{% extends "layouts/page.html.j2" %}
{% import "breedsub/_parts.html.j2" as part %}
{% import "breeds/_parts.html.j2" as brd %}

{% block body_attrs %} class="page-varieties"{% endblock %}

{% block page_css %}
  <link rel="stylesheet" href="/assets/css/breedsub.css">
{% endblock %}

{% block sprite_extra %}{{ part.icons() }}{% endblock %}

{% block hero %}
{%- set hs = imgsize(v.hero_photo.src) -%}
    {% call ui.page_hero(v.h1, lead=v.lead, breed=b, photo={'src': v.hero_photo.src, 'alt': v.hero_photo.alt, 'w': hs[0], 'h': hs[1]}, eyebrow=v.eyebrow, facts=v.facts) %}
      {{ forms.price_button(cls='btn btn--ink btn--lg', breed=b.name) }}
      <a class="btn btn--white btn--lg" href="#okrasy">Смотреть окрасы</a>
    {% endcall %}
{% endblock %}

{% block body %}
{% for s in v.blocks %}
    <section class="section{{ ' section--tight' if loop.first }} container" id="{{ s.id }}" aria-labelledby="{{ s.id }}-title">
    {% if s.type == 'types' %}
      {{ ui.section_head(s.title, id=s.id ~ '-title', lead=s.lead) }}
      {{ part.types(s, b, tint) }}

    {% elif s.type == 'colours' %}
      {% call ui.section_head(s.title, id=s.id ~ '-title', lead=s.lead) %}{{ brd.colour_consult(b) }}{% endcall %}
      {{ brd.colour_carousel(s['items'], b, label=s.title|striptags) }}

    {% elif s.type == 'tips' %}
      {{ ui.section_head(s.title, id=s.id ~ '-title') }}
      {{ ui.steps(s['items'], cols=3) }}
    {% endif %}
    </section>

{% endfor %}
    <!-- ================= ЩЕНКИ ПОРОДЫ — 8 карточек и кнопка под ними, как каталог на главной (правка 21.10) ================= -->
    {%- set pups8 = (b.puppies|sort(attribute='status_order'))[:8] %}
    <section class="section container" id="pups" aria-labelledby="pups-title">
      {{ ui.section_head(ui.nohyph('Щенки ' ~ b.name_plural_gen ~ ' в наличии'), id='pups-title') }}
      {% if pups8 %}
      <ul class="pups hm-pups bsub-pups" data-reveal="items">
        {% for p in pups8 %}
        <li class="pups__item">
          {{ cards.puppy_card(p) }}
        </li>
        {% endfor %}
      </ul>
      <div class="hm-pups__foot">
        <a class="btn btn--ink btn--lg" href="{{ b.urls.hub }}#shchenki"><span>{{ ui.nohyph('Все щенки ' ~ b.name_plural_gen) }}</span> {{ ui.icon('arrow') }}</a>
      </div>
      {% else %}
      {{ ui.empty_state('Сейчас щенков нет в наличии', 'Оставьте заявку — напишем, когда появится новый помёт.') }}
      {% endif %}
    </section>

    {{ blocks.faq_section(v.faq, title=v.faq_title) }}

    {{ blocks.read_more(b) }}

{% endblock %}

{#- the breed's puppies are higher on the page (#pups, after «Как выбрать окрас») — no second strip;
    the articles are in «Читайте также» -#}
{% block pups %}{% endblock %}
{% block blog %}{% endblock %}

{% block seo %}
    {% call blocks.seo_block(v.seo.title, v.seo.lead, id='ob-okrasah') %}
        {% for s in v.seo.blocks %}
        <h3>{{ s.h|typo }}</h3>
        <p>{{ s.p|typo }}</p>
        {% endfor %}
    {% endcall %}
{% endblock %}

{#- the homepage lead form (client 21.10): large title, paws, contact tiles under it -#}
{% block lead %}
    {% call forms.lead_form(title=v.lead_title, line=v.lead_line, tone=b.tone, breed=b.slug, contacts=false, cls='hm-lead') %}
      {{ forms.contact_tiles() }}
    {% endcall %}
{% endblock %}
