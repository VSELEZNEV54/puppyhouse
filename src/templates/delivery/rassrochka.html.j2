{#- /rassrochka/ — booking and installment. Context (routes/delivery.py): r (copy, data/delivery-service.json), faq_items. -#}
{% extends "layouts/page.html.j2" %}

{% block page_css %}
  <link rel="stylesheet" href="/assets/css/delivery.css">
{% endblock %}

{% block hero %}
    {% call ui.page_hero(r.h1, lead=r.lead, eyebrow=r.eyebrow, photo=dict(r.photo, w=imgsize(r.photo.src)[0], h=imgsize(r.photo.src)[1]), tone='butter',
        chips=[{'icon': 'doc', 'label': 'Договор'}, {'icon': 'wallet', 'label': 'Предоплата'}, {'icon': 'calendar', 'label': 'Рассрочка'}]) %}
      {{ forms.price_button(cls='btn btn--ink btn--lg') }}
      <a class="btn btn--white btn--lg" href="#bron">Как забронировать</a>
    {% endcall %}
{% endblock %}

{% block body %}
    <section class="section section--tight container" id="bron" aria-labelledby="bron-title">
      {{ ui.section_head(r.steps_title, id='bron-title') }}
      {{ ui.steps(r.steps) }}
    </section>

    <section class="section container" id="usloviya" aria-labelledby="usloviya-title">
      {{ ui.section_head(r.terms_title, id='usloviya-title') }}
      {{ ui.spec_grid(r.terms, cols=4) }}
    </section>

    <section class="section container" id="rassrochka" aria-labelledby="rassrochka-title">
      {{ ui.section_head(r.bank_title, id='rassrochka-title', lead=r.bank_lead) }}
      <div class="dlv-bank">
        <div class="dlv-bank__card tone--sun">
          <div class="dlv-bank__head">
            {{ ui.ico('wallet', 'sun') }}
            <p class="dlv-bank__name">{{ r.bank_name|typo }}</p>
          </div>
          <dl class="dlv-bank__facts">
            {% for f in r.bank_facts %}<div><dt>{{ f.label|typo }}</dt><dd>{{ f.value|typo }}</dd></div>{% endfor %}
          </dl>
          <p class="dlv-bank__note">{{ ui.icon('info', sm=true) }}<span>{{ r.bank_note|typo }}</span></p>
        </div>
        {{ ui.timeline(r.bank_steps, colors=('sun', 'mint', 'coral')) }}
      </div>
    </section>

    {{ ui.advantages(title='Что входит в покупку', link={'url': '/dokumenty-i-garantii/', 'label': 'Документы и гарантии'}) }}

    {{ cards.pups_section() }}

    {{ blocks.faq_section(faq_items, title=r.faq_title, id='voprosy') }}
{% endblock %}

{% block lead %}
    {{ forms.lead_form(title=r.lead_title, line=r.lead_line, tone='butter') }}
{% endblock %}
