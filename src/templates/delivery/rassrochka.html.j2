{#- /rassrochka/ — booking only (client 21.10: no installment for now; prepayment 30% of the price). Main buttons coral
    as on the homepage (body.page-booking); «Щенки в наличии» — two of every breed (cards.pups_grid); «Читайте также» —
    articles + plates (blocks.read_more without a breed). Context (routes/delivery.py): r (copy, data/delivery-service.json),
    faq_items, catalog. -#}
{% extends "layouts/page.html.j2" %}

{% block body_attrs %} class="page-booking"{% endblock %}

{% block page_css %}
  <link rel="stylesheet" href="/assets/css/delivery.css">
{% endblock %}

{% block hero %}
    {% call ui.page_hero(r.h1, lead=r.lead, eyebrow=r.eyebrow, photo=dict(r.photo, w=imgsize(r.photo.src)[0], h=imgsize(r.photo.src)[1]), tone='butter') %}
      {{ forms.price_button(cls='btn btn--ink btn--lg') }}
      <a class="btn btn--white btn--lg" href="#bron">Как забронировать</a>
    {% endcall %}
{% endblock %}

{% block body %}
    <section class="section section--tight container" id="bron" aria-labelledby="bron-title">
      {{ ui.section_head(r.steps_title, id='bron-title') }}
      {{ ui.steps(r.steps) }}
    </section>

    <section class="section container" id="usloviya" aria-labelledby="usloviya-title">
      {{ ui.section_head(r.terms_title, id='usloviya-title') }}
      {{ ui.spec_grid(r.terms, cols=4) }}
    </section>

    {{ ui.advantages(title='Что входит в покупку', link={'url': '/dokumenty-i-garantii/', 'label': 'Документы и гарантии'}) }}

    {{ cards.pups_grid(catalog) }}

    {{ blocks.faq_section(faq_items, title=r.faq_title, id='voprosy') }}
{% endblock %}

{% block blog %}
    {{ blocks.read_more() }}
{% endblock %}

{% block lead %}
    {{ forms.lead_form(title=r.lead_title, line=r.lead_line, tone='butter') }}
{% endblock %}
