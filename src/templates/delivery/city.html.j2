{#- /dostavka/<city>/ — one template for every city of cities.json. Context (routes/delivery.py): city, tone, h1, lead,
    facts, steps (3), ways (methods available + pick-up), breed_tiles, faq_items (3), others, seo, lead_title, lead_line. -#}
{% extends "layouts/page.html.j2" %}
{% import "delivery/_parts.html.j2" as dlv %}

{% block page_css %}
  <link rel="stylesheet" href="/assets/css/delivery.css">
{% endblock %}

{% block hero %}
    <div class="dlv-cityhero">
    {% call ui.page_hero(h1, lead=lead, tone=tone, faces=true, facts=facts, eyebrow='Питомник в Москве') %}
      {{ forms.price_button(cls='btn btn--ink btn--lg') }}
      <a class="btn btn--white btn--lg" href="#pups">Смотреть щенков</a>
    {% endcall %}
    </div>
{% endblock %}

{% block body %}
    <section class="section section--tight container" id="kak-privezem" aria-labelledby="kak-privezem-title">
      {{ ui.section_head('Как привезём щенка', id='kak-privezem-title') }}
      {{ ui.steps(steps, cols=3) }}
    </section>

    <section class="section container" id="sposoby" aria-labelledby="sposoby-title">
      {{ ui.section_head('Способы доставки', id='sposoby-title', link={'url': '/dostavka/', 'label': 'Все о доставке'}) }}
      {{ dlv.ways(ways) }}
    </section>

    <section class="section container dlv-breeds" id="porody" aria-labelledby="porody-title">
      {{ ui.section_head('Каких щенков привезём', id='porody-title') }}
      {{ ui.link_tiles(breed_tiles) }}
    </section>

    {{ cards.pups_section() }}

    {{ blocks.faq_section(faq_items, title='Вопросы о доставке', id='voprosy', link={'url': '/faq/#dostavka', 'label': 'Все вопросы'}) }}

    <section class="section container" id="goroda" aria-labelledby="goroda-title">
      {{ ui.section_head('Другие города', id='goroda-title', link={'url': '/dostavka/#goroda', 'label': 'Все города'}) }}
      <div class="dlv-others">
        {{ dlv.city_chips(others, label='Другие города доставки') }}
      </div>
    </section>

    {% call blocks.seo_block(seo.title, seo.lead, id='o-dostavke') %}
        {% for s in seo.blocks %}
        <h3>{{ s.h|typo }}</h3>
        <p>{{ s.p|typo }}</p>
        {% endfor %}
    {% endcall %}
{% endblock %}

{% block lead %}
    {{ forms.lead_form(title=lead_title, line=lead_line, tone=tone) }}
{% endblock %}
