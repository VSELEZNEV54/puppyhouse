{#- /dostavka/ — delivery hub. Context (routes/delivery.py): hub (copy, data/delivery.json), ways (methods + fit_breeds),
    groups (cities by distance), geo_lead, faq_items. -#}
{% extends "layouts/page.html.j2" %}
{% import "delivery/_parts.html.j2" as dlv %}

{% block page_css %}
  <link rel="stylesheet" href="/assets/css/delivery.css">
{% endblock %}

{% block hero %}
    {% call dlv.framed_hero(hub.h1, hub.photo, lead=hub.lead, tone='sand', eyebrow=hub.eyebrow, chips=hub.chips, pos='62% 55%') %}
      <a class="btn btn--ink btn--lg" href="#zayavka">Рассчитать доставку</a>
      <a class="btn btn--white btn--lg" href="#goroda">Города доставки</a>
    {% endcall %}
{% endblock %}

{% block body %}
    <section class="section section--tight container" id="sposoby" aria-labelledby="sposoby-title">
      {{ ui.section_head(hub.ways_title, id='sposoby-title', lead=hub.ways_lead) }}
      {{ dlv.ways(ways) }}
    </section>

    <section class="section container" id="kak-prohodit" aria-labelledby="kak-prohodit-title">
      {{ ui.section_head(hub.steps_title, id='kak-prohodit-title') }}
      <div class="split dlv-split">
        {{ ui.timeline(hub.steps) }}
        <figure class="split__media dlv-split__media">
          {{ ui.img(hub.steps_photo.src, hub.steps_photo.alt) }}
          <figcaption class="dlv-cap">{{ hub.steps_photo.caption|typo }}</figcaption>
        </figure>
      </div>
    </section>

    <section class="section container" id="nabor" aria-labelledby="nabor-title">
      {{ ui.section_head(hub.kit_title, id='nabor-title', lead=hub.kit_lead) }}
      <div class="split dlv-split dlv-split--rev">
        <figure class="split__media dlv-split__media dlv-split__media--kit">
          {{ ui.img(hub.kit_photo.src, hub.kit_photo.alt) }}
        </figure>
        <ul class="dlv-kit">
          {% for k in hub.kit %}
          <li class="dlv-kit__item">{{ ui.ico(k.icon, k.color, sm=true) }}<span class="dlv-kit__txt"><span class="dlv-kit__title">{{ k.title|typo }}</span><span class="dlv-kit__line">{{ k.line|typo }}</span></span></li>
          {% endfor %}
        </ul>
      </div>
    </section>

    <section class="section container" id="goroda" aria-labelledby="goroda-title">
      {{ ui.section_head(hub.geo_title, id='goroda-title', lead=geo_lead) }}
      <div class="dlv-geo" data-reveal="items">
        {% for g in groups %}
        <div class="dlv-geo__group">
          <div class="dlv-geo__head">
            {{ ui.ico(g.icon, g.color) }}
            <div>
              <h3 class="dlv-geo__title">{{ g.title|typo }}</h3>
              <p class="dlv-geo__line">{{ g.line|typo }}</p>
            </div>
          </div>
          {{ dlv.city_chips(g.cities, label='Города: ' ~ g.title) }}
        </div>
        {% endfor %}
      </div>
      {{ dlv.ask_row(hub.geo_more) }}
    </section>

    {{ cards.pups_section() }}

    {{ blocks.faq_section(faq_items, title=hub.faq_title, id='voprosy', link={'url': '/faq/#dostavka', 'label': 'Все вопросы'}) }}

    {% call blocks.seo_block(hub.seo.title, hub.seo.lead, id='perevozka') %}
        {% for s in hub.seo.blocks %}
        <h3>{{ s.h|typo }}</h3>
        <p>{{ s.p|typo }}</p>
        {% endfor %}
    {% endcall %}
{% endblock %}

{% block lead %}
    {{ forms.lead_form(title=hub.lead_title, line=hub.lead_line, tone='sand') }}
{% endblock %}
