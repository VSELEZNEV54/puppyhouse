{#- Base layout of every page. READ-ONLY for page-group agents.
    Context: title, description (strings), page = {url, depth, module} (added by build.py).
    Blocks:  title · description · head_css · head_js · head_extra · body_attrs · sprite_extra · content · body_end
    All URLs are written root-absolute ("/assets/…", "/maltipu/"); build.py makes them relative. -#}
<!doctype html>
<html lang="ru">
<head>
  <meta charset="utf-8">
  <meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover">
  <title>{% block title %}{{ title }}{% endblock %}</title>
  <meta name="description" content="{% block description %}{{ description }}{% endblock %}">
  <meta name="theme-color" content="{{ site.theme_color }}">
  {# API for the forms and the tracker (main.js): live mode only on an origin from data-origins (or a localStorage
      'dsh:api' dev override), otherwise the forms keep the prototype send. content is never rewritten by build.py. #}
  <meta name="dsh-api" content="{{ site.api.url }}" data-origins="{{ site.api.origins|join(' ') }}" data-consent="{{ data.consent.current.processing }}" data-consent-publish="{{ data.consent.current.distribution }}">
  <link rel="icon" href="data:image/svg+xml,%3Csvg xmlns='http://www.w3.org/2000/svg' viewBox='0 0 40 40'%3E%3Crect width='40' height='40' rx='12' fill='%23FF6F4F'/%3E%3Cg fill='%23141414'%3E%3Cpath d='M20 20.7c-3.3 0-6.7 3.6-6.7 6.6 0 1.8 1.3 3 3.1 3 1.6 0 2.4-.8 3.6-.8s2 .8 3.6.8c1.8 0 3.1-1.2 3.1-3 0-3-3.4-6.6-6.7-6.6Z'/%3E%3Cellipse cx='12.4' cy='18.6' rx='2.3' ry='2.9'/%3E%3Cellipse cx='17' cy='13.4' rx='2.4' ry='3.1'/%3E%3Cellipse cx='23' cy='13.4' rx='2.4' ry='3.1'/%3E%3Cellipse cx='27.6' cy='18.6' rx='2.3' ry='2.9'/%3E%3C/g%3E%3C/svg%3E">
  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
  <link href="https://fonts.googleapis.com/css2?family=Geist:wght@400;500&amp;display=swap" rel="stylesheet">
  <link rel="stylesheet" href="/assets/css/main.css">
{% block head_css %}{% endblock %}
  <script src="/assets/js/main.js" defer></script>
{% block head_js %}{% endblock %}
{% block head_extra %}{% endblock %}
</head>
<body{% block body_attrs %}{% endblock %}>
  <!-- Иконки: инлайн-спрайт 24×24. Линейные — stroke currentColor, заливочные — fill. -->
  <svg class="sprite" aria-hidden="true" focusable="false" xmlns="http://www.w3.org/2000/svg">
{% include "partials/sprite.html.j2" %}
{% block sprite_extra %}{% endblock %}
  </svg>

  <a class="skip-link" href="#main">Перейти к&nbsp;содержанию</a>

{% include "partials/header.html.j2" %}

  <main id="main">
{% block content %}{% endblock %}
  </main>

{% include "partials/footer.html.j2" %}

{% include "partials/mbar.html.j2" %}

{% include "partials/mmenu.html.j2" %}

{% include "partials/price-modal.html.j2" %}

{% include "partials/lightbox.html.j2" %}

{% include "partials/toast.html.j2" %}
{% block body_end %}{% endblock %}
</body>
</html>
