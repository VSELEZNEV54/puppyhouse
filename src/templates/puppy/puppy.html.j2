{#- /shchenki/<slug>/ — puppy page (typical strong-kennel layout, client 13.10). Context from routes/puppy.py:
    p (puppy), b (its breed), h1 (colour + breed + generation + sex, no nickname), rows (characteristics table), docs, docs_note, colour_note, parents, gallery,
    includes, about, fits, breed_links, booking, delivery, similar, similar_total, faq_items, lead_line.
    Gallery: a [data-carousel] (main.js: arrows, swipe, ← →, lightbox) with thumbnails and a counter (assets/js/puppy.js).
    Modal modes «Лист ожидания», «Следующий помёт»: data-pp-modal + data-modal-* (puppy.js, main.js).
    Hero CTAs (клиент 19.10): main action (coral via body.page-puppy) + «Связаться в Telegram». -#}
{% extends "layouts/page.html.j2" %}
{% import "catalog/_card.html.j2" as ct %}

{% block page_css %}
  <link rel="stylesheet" href="/assets/css/puppy.css">
{% endblock %}
{% block body_attrs %} class="page-puppy"{% endblock %}
{% block page_js %}
  <script src="/assets/js/puppy.js" defer></script>
{% endblock %}

{% block hero %}
{%- set t = photo_tone(p.photo.src) if p.photo.kind == 'studio' and p.photo.get('backdrop') != 'token' else none -%}
{%- set n = gallery|length -%}
{%- set tg = site.messengers.telegram -%}
    <section class="pp container" id="shchenok" aria-labelledby="page-title">
      <div class="pp__grid {{ p.tone_class }}"{% if t %} style="--tone:{{ t.top }};--tone-floor:{{ t.floor }}"{% endif %} data-pup data-slug="{{ p.slug }}" data-breed="{{ p.breed }}" data-name="{{ p.name }}" data-desc="{{ p.desc }}" data-img="{{ p.photo.src.rsplit('/', 1)[-1] }}" data-pp data-pp-status="{{ p.status }}" data-pp-breed="{{ b.name }}">
        <div class="pp-gal">
          <div class="media-carousel pp-car" data-carousel data-start="0" data-pp-car role="region" aria-roledescription="карусель" aria-label="Фото и видео: {{ p.name }}">
            <div class="pp-car__stage">
              <div class="media-carousel__viewport pp-car__vp" tabindex="0" data-carousel-viewport>
                <ul class="media-carousel__track pp-car__track">
                  {% for m in gallery %}
                  {%- set size = imgsize(m.src) or [1024, 1024] -%}
                  {%- set is_video = m.kind == 'video' -%}
                  <li class="media-carousel__item pp-slide{{ ' is-active' if loop.first }}" aria-roledescription="слайд" aria-label="{{ loop.index }} из {{ n }}">
                    <button class="pp-slide__btn{{ ' pp-slide__btn--video' if is_video }}" type="button" tabindex="{{ '0' if loop.first else '-1' }}" data-lightbox data-kind="{{ m.kind }}"{% if m.video %} data-src="{{ m.video }}"{% endif %} data-caption="{{ m.caption }}" aria-label="{{ ('Смотреть видео: ' if is_video else 'Открыть фото: ') ~ m.caption }}">
                      <img src="{{ m.src }}" alt="{{ m.alt|typo }}" width="{{ size[0] }}" height="{{ size[1] }}" style="object-position:{{ m.pos }}"{% if loop.first %} fetchpriority="high"{% else %} loading="lazy"{% endif %} decoding="async">
                      {% if is_video %}<span class="mcard__play" aria-hidden="true">{{ ui.icon('play') }}</span>{% endif %}
                      {% if not loop.first %}<span class="pp-slide__cap" aria-hidden="true">{% if is_video %}<span class="pp-slide__kind">Видео</span>{% endif %}{{ m.caption|typo }}</span>{% endif %}
                    </button>
                  </li>
                  {% endfor %}
                </ul>
              </div>
              <p class="pp-car__count" aria-hidden="true"><span data-pp-count>1</span>&nbsp;/&nbsp;{{ n }}</p>
              <div class="media-carousel__nav">
                <button class="media-carousel__btn" type="button" data-carousel-prev aria-label="Предыдущее фото">{{ ui.icon('arrow', cls='i--flip') }}</button>
                <button class="media-carousel__btn" type="button" data-carousel-next aria-label="Следующее фото">{{ ui.icon('arrow') }}</button>
              </div>
            </div>
            <ul class="pp-thumbs" style="--n:{{ n }}" aria-hidden="true">
              {% for m in gallery %}
              {%- set size = imgsize(m.src) or [1024, 1024] -%}
              <li><button class="pp-thumb{{ ' is-on' if loop.first }}" type="button" tabindex="-1" data-pp-thumb="{{ loop.index0 }}" aria-label="{{ loop.index }} из {{ n }}: {{ m.caption }}"><img src="{{ m.src }}" alt="" width="{{ size[0] }}" height="{{ size[1] }}" style="object-position:{{ m.pos }}" loading="lazy" decoding="async">{% if m.kind == 'video' %}<span class="pp-thumb__play">{{ ui.icon('play', sm=true) }}</span>{% endif %}</button></li>
              {% endfor %}
            </ul>
          </div>
        </div>

        <div class="pp-info">
          <p class="pp-info__status pp-info__status--{{ p.status_dot }}"><span class="dot dot--{{ p.status_dot }}" aria-hidden="true"></span>{{ p.status_label|typo }}</p>
          <h1 class="pp-title" id="page-title">{{ h1|typo }}</h1>
          <p class="pp-nick">Кличка: <span class="pp-nick__name">{{ p.name }}</span></p>
          {% if p.status == 'reserved' %}
          <p class="pp-note pp-note--res">{{ ui.icon('info', sm=true) }}<span>{{ ('Этого щенка уже забронировали.')|typo }} <a href="#pohozhie">{{ 'Посмотрите похожих'|typo }}</a> {{ ('или узнайте о новом помёте.')|typo }}</span></p>
          {% elif p.status == 'soon' %}
          <p class="pp-note pp-note--soon">{{ ui.icon('clock', sm=true) }}<span>{{ ('Бронь откроем скоро. Запишитесь в лист ожидания — пришлём видео и цену первыми.')|typo }}</span></p>
          {% endif %}

          <div class="pp-cta" data-hero-ctas>
            {% if p.status == 'available' %}
            <button class="btn btn--ink btn--lg pp-cta__main" type="button" data-open-modal data-modal-kind="puppy" data-pp-main aria-label="Узнать цену: {{ p.name }}">Узнать цену</button>
            <a class="btn btn--white btn--lg pp-cta__tg" href="{{ tg.url }}" target="_blank" rel="noopener">{{ ui.icon('tg') }}Связаться в&nbsp;Telegram</a>
            {% elif p.status == 'soon' %}
            <button class="btn btn--ink btn--lg pp-cta__main" type="button" data-open-modal data-modal-kind="waitlist" data-pp-modal="wait" data-modal-title="Лист ожидания: {{ p.name }}" data-modal-sub="Напишем первыми, когда откроем бронь, и пришлём цену" data-modal-note="Лист ожидания — {{ p.name }}">Записаться в&nbsp;лист ожидания</button>
            <a class="btn btn--white btn--lg pp-cta__tg" href="{{ tg.url }}" target="_blank" rel="noopener">{{ ui.icon('tg') }}Связаться в&nbsp;Telegram</a>
            {% else %}
            <button class="btn btn--ink btn--lg pp-cta__main" type="button" data-open-modal data-modal-kind="litter" data-pp-modal="litter" data-modal-title="Следующий помёт" data-modal-sub="Напишем, когда появятся новые щенки {{ b.name_plural_gen }}" data-modal-note="Следующий помёт — {{ b.name }}">Узнать о&nbsp;следующем помёте</button>
            <a class="btn btn--white btn--lg pp-cta__tg" href="{{ tg.url }}" target="_blank" rel="noopener">{{ ui.icon('tg') }}Связаться в&nbsp;Telegram</a>
            {% endif %}
          </div>
          <div class="pp-sub">
            <ul class="pp-trust" aria-label="Гарантии">
              <li>{{ ui.icon('doc', sm=true) }}Бронь по&nbsp;договору</li>
              <li>{{ ui.icon('shield', sm=true) }}Пожизненная гарантия</li>
              <li>{{ ui.icon('car', sm=true) }}Доставка по&nbsp;России</li>
            </ul>
          </div>

          <div class="pp-tbl">
            <h2 class="pp-tbl__title" id="harakteristiki">Характеристики</h2>
            <table class="pp-tbl__table" aria-labelledby="harakteristiki">
              <tbody>
                {% for r in rows %}
                <tr><th scope="row">{{ r.label|typo }}</th><td>{% if r.get('url') %}<a href="{{ r.url }}">{{ r.value|typo }}</a>{% else %}{{ r.value|typo }}{% endif %}</td></tr>
                {% endfor %}
              </tbody>
            </table>
            {% if colour_note or docs_note %}<p class="pp-small">{{ (colour_note ~ ' ' if colour_note else '')|typo }}{{ (docs_note or '')|typo }}</p>{% endif %}
          </div>
        </div>
      </div>
    </section>
{% endblock %}

{% block body %}
    <section class="section container" id="harakter" aria-labelledby="harakter-title">
      {{ ui.section_head('Характер и описание', id='harakter-title') }}
      <div class="pp-about">
        <div class="pp-about__text">
          {% for t in about %}<p>{{ t|typo }}</p>{% endfor %}
        </div>
        <aside class="pp-about__fits {{ b.tone_class }}" aria-labelledby="pp-fits-title">
          <h3 class="pp-about__title" id="pp-fits-title">Кому подойдёт</h3>
          <ul class="pp-about__chips">
            {% for f in fits %}<li>{{ ui.icon('check', sm=true) }}{{ f|typo }}</li>{% endfor %}
          </ul>
          <ul class="pp-about__links">
            {% for l in breed_links %}<li>{{ ui.text_link(l.url, l.label) }}</li>{% endfor %}
          </ul>
        </aside>
      </div>
    </section>

    <section class="section container" id="roditeli" aria-labelledby="roditeli-title">
      {{ ui.section_head('Родители', id='roditeli-title', lead='Покажем маму и папу щенка по видео', link={'url': '/roditeli/', 'label': 'Все родители'}) }}
      <ul class="pp-parents" data-reveal="items">
        {% for par in parents %}
        <li>
          <article class="pp-parent" aria-labelledby="pp-parent-{{ loop.index }}">
            {% if par.photo %}
            {%- set ps = imgsize(par.photo.src) or [928, 1152] %}
            <span class="pp-parent__photo"><img src="{{ par.photo.src }}" alt="{{ par.photo.alt|typo }}" width="{{ ps[0] }}" height="{{ ps[1] }}" style="object-position:{{ par.photo.pos }}" loading="lazy" decoding="async"></span>
            {% else %}
            <span class="pp-parent__photo pp-parent__photo--ask"><span class="pp-parent__askico" aria-hidden="true">{{ ui.icon('video') }}</span><span>{{ 'Фото и видео пришлём по запросу'|typo }}</span></span>
            {% endif %}
            <div class="pp-parent__txt">
              <p class="pp-parent__role">{{ par.role_label }}</p>
              <h3 class="pp-parent__name" id="pp-parent-{{ loop.index }}">{{ par.name|typo }}</h3>
              <p class="pp-parent__breed">{{ par.breed|typo }}</p>
              <ul class="pp-parent__facts">
                {% for f in par.facts %}<li>{% if not f.startswith('[') %}{{ ui.icon('check', sm=true) }}{% endif %}{{ f|typo }}</li>{% endfor %}
              </ul>
            </div>
          </article>
        </li>
        {% endfor %}
      </ul>
    </section>

    {{ ui.advantages(includes, title='Что входит в покупку', id='chto-vhodit', link={'url': '/dokumenty-i-garantii/', 'label': 'Документы и гарантии'}, cols=4) }}

    <section class="section container" id="bron" aria-labelledby="bron-title">
      {{ ui.section_head('Бронь и доставка', id='bron-title') }}
      <div class="pp-terms">
        {% for blk in [booking, delivery] %}
        <div class="pp-term pp-term--{{ 'sun' if loop.first else 'mint' }}">
          {{ ui.ico('wallet' if loop.first else 'car', 'sun' if loop.first else 'mint') }}
          <h3 class="pp-term__title">{{ blk.title|typo }}</h3>
          <ul class="pp-term__list">
            {% for it in blk['items'] %}<li>{{ ui.icon('check', sm=true) }}<span>{{ it|typo }}</span></li>{% endfor %}
          </ul>
          {{ ui.tile_cta(blk.link.label, variant='', url=blk.link.url) }}
        </div>
        {% endfor %}
      </div>
    </section>

    <section class="section container" id="pohozhie" aria-labelledby="pohozhie-title">
      {{ ui.section_head('Похожие щенки', id='pohozhie-title', link={'url': '/shchenki/?breed=' ~ b.slug, 'label': 'Весь каталог — ' ~ similar_total}) }}
      {% if similar %}
      {{ ct.strip(similar, breed=b) }}
      {% else %}
      {{ ui.empty_state('Других щенков этой породы сейчас нет', 'Оставьте заявку — напишем, когда появится новый помёт.') }}
      {% endif %}
    </section>

    {{ blocks.faq_section(faq_items, title='Вопросы о покупке') }}
{% endblock %}

{# «Похожие щенки» above replace the default strip #}
{% block pups %}{% endblock %}

{% block lead %}
    {{ forms.lead_form(title='Подберём щенка за 1 час', line=lead_line, tone=b.tone, breed=b.slug) }}
{% endblock %}
