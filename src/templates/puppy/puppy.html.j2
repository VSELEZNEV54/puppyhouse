{#- /shchenki/<slug>/ — puppy page (layout of 13.10, client notes 19.10). Context from routes/puppy.py:
    p (puppy), b (its breed), h1 (colour + breed + generation + sex, no nickname), rows (characteristics table), docs,
    docs_note, colour_note, gallery (the puppy's own photos and video only), includes, intro + facts («Про <породу>»),
    fits («Кому подойдёт», photo cards), more («Читайте о породе» tiles), booking, delivery, similar,
    faq_items, lead_line. No status badges and no parents block (client 19.10).
    Order: hero → «Как купить щенка» → «Похожие щенки» → «Кому подойдёт» → «Что входит» → «Бронь и доставка» →
    «Про <породу>» with the facts and «Читайте о породе» → «Частые вопросы» → lead form. Links in block heads and
    tiles are coral buttons, like «Узнать цену» in «Как купить щенка».
    Gallery: a [data-carousel] (main.js: arrows, swipe, ← →, lightbox) with thumbnails and a counter (assets/js/puppy.js);
    one photo — no arrows, counter or thumbnails.
    Hero CTAs: coral «Узнать цену» (body.page-puppy) + «Связаться в Telegram», the same for every status. -#}
{% extends "layouts/page.html.j2" %}
{% import "catalog/_card.html.j2" as ct %}

{% block page_css %}
  <link rel="stylesheet" href="/assets/css/puppy.css">
{% endblock %}
{% block body_attrs %} class="page-puppy"{% endblock %}
{% block page_js %}
  <script src="/assets/js/puppy.js" defer></script>
{% endblock %}

{% block hero %}
{%- set t = photo_tone(p.photo.src) if p.photo.kind == 'studio' and p.photo.get('backdrop') != 'token' else none -%}
{%- set n = gallery|length -%}
{%- set tg = site.messengers.telegram -%}
    <section class="pp container" id="shchenok" aria-labelledby="page-title">
      <div class="pp__grid {{ p.tone_class }}"{% if t %} style="--tone:{{ t.top }};--tone-floor:{{ t.floor }}"{% endif %} data-pup data-slug="{{ p.slug }}" data-breed="{{ p.breed }}" data-name="{{ p.name }}" data-desc="{{ p.desc }}" data-img="{{ p.photo.src.rsplit('/', 1)[-1] }}" data-pp data-pp-status="{{ p.status }}" data-pp-breed="{{ b.name }}">
        <div class="pp-gal">
          <div class="media-carousel pp-car{{ ' pp-car--one' if n == 1 }}" data-carousel data-start="0" data-pp-car role="region" aria-roledescription="карусель" aria-label="Фото и видео: {{ p.name }}">
            <div class="pp-car__stage">
              <div class="media-carousel__viewport pp-car__vp" tabindex="0" data-carousel-viewport>
                <ul class="media-carousel__track pp-car__track">
                  {% for m in gallery %}
                  {%- set size = imgsize(m.src) or [1024, 1024] -%}
                  {%- set is_video = m.kind == 'video' -%}
                  <li class="media-carousel__item pp-slide{{ ' is-active' if loop.first }}" aria-roledescription="слайд" aria-label="{{ loop.index }} из {{ n }}">
                    <button class="pp-slide__btn{{ ' pp-slide__btn--video' if is_video }}" type="button" tabindex="{{ '0' if loop.first else '-1' }}" data-lightbox data-kind="{{ m.kind }}"{% if m.video %} data-src="{{ m.video }}"{% endif %} data-caption="{{ m.caption }}" aria-label="{{ ('Смотреть видео: ' if is_video else 'Открыть фото: ') ~ m.caption }}">
                      <img src="{{ m.src }}" alt="{{ m.alt|typo }}" width="{{ size[0] }}" height="{{ size[1] }}" style="object-position:{{ m.pos }}"{% if loop.first %} fetchpriority="high"{% else %} loading="lazy"{% endif %} decoding="async">
                      {% if is_video %}<span class="mcard__play" aria-hidden="true">{{ ui.icon('play') }}</span>{% endif %}
                      {% if not loop.first %}<span class="pp-slide__cap" aria-hidden="true">{% if is_video %}<span class="pp-slide__kind">Видео</span>{% endif %}{{ m.caption|typo }}</span>{% endif %}
                    </button>
                  </li>
                  {% endfor %}
                </ul>
              </div>
              {% if n > 1 %}
              <p class="pp-car__count" aria-hidden="true"><span data-pp-count>1</span>&nbsp;/&nbsp;{{ n }}</p>
              <div class="media-carousel__nav">
                <button class="media-carousel__btn" type="button" data-carousel-prev aria-label="Предыдущее фото">{{ ui.icon('arrow', cls='i--flip') }}</button>
                <button class="media-carousel__btn" type="button" data-carousel-next aria-label="Следующее фото">{{ ui.icon('arrow') }}</button>
              </div>
              {% endif %}
            </div>
            {% if n > 1 %}
            <ul class="pp-thumbs" style="--n:{{ n }}" aria-hidden="true">
              {% for m in gallery %}
              {%- set size = imgsize(m.src) or [1024, 1024] -%}
              <li><button class="pp-thumb{{ ' is-on' if loop.first }}" type="button" tabindex="-1" data-pp-thumb="{{ loop.index0 }}" aria-label="{{ loop.index }} из {{ n }}: {{ m.caption }}"><img src="{{ m.src }}" alt="" width="{{ size[0] }}" height="{{ size[1] }}" style="object-position:{{ m.pos }}" loading="lazy" decoding="async">{% if m.kind == 'video' %}<span class="pp-thumb__play">{{ ui.icon('play', sm=true) }}</span>{% endif %}</button></li>
              {% endfor %}
            </ul>
            {% endif %}
          </div>
        </div>

        <div class="pp-info">
          <h1 class="pp-title" id="page-title">{{ h1|typo }}</h1>
          <p class="pp-nick">Кличка: <span class="pp-nick__name">{{ p.name }}</span></p>

          <div class="pp-cta" data-hero-ctas>
            <button class="btn btn--ink btn--lg pp-cta__main" type="button" data-open-modal data-modal-kind="puppy" data-pp-main aria-label="Узнать цену: {{ p.name }}">Узнать цену</button>
            {% if site.contacts_ready %}<a class="btn btn--white btn--lg pp-cta__tg" href="{{ tg.url }}" target="_blank" rel="noopener">{{ ui.icon('tg') }}Связаться в&nbsp;Telegram</a>{% endif %}
          </div>
          <div class="pp-sub">
            <ul class="pp-trust" aria-label="Гарантии">
              <li>{{ ui.icon('doc', sm=true) }}Бронь по&nbsp;договору</li>
              <li>{{ ui.icon('shield', sm=true) }}Пожизненная гарантия</li>
              <li>{{ ui.icon('car', sm=true) }}Доставка по&nbsp;России</li>
            </ul>
          </div>

          <div class="pp-tbl">
            <h2 class="pp-tbl__title" id="harakteristiki">Характеристики</h2>
            <table class="pp-tbl__table" aria-labelledby="harakteristiki">
              <tbody>
                {% for r in rows %}
                <tr><th scope="row">{{ r.label|typo }}</th><td>{% if r.get('url') %}<a href="{{ r.url }}">{{ r.value|typo }}</a>{% else %}{{ r.value|typo }}{% endif %}</td></tr>
                {% endfor %}
              </tbody>
            </table>
            {% if colour_note or docs_note %}<p class="pp-small">{{ (colour_note ~ ' ' if colour_note else '')|typo }}{{ (docs_note or '')|typo }}</p>{% endif %}
          </div>
        </div>
      </div>
    </section>
{% endblock %}

{% block body %}
    {{ blocks.how_to_buy() }}

    <section class="section container" id="pohozhie" aria-labelledby="pohozhie-title">
      {{ ui.section_head('Похожие щенки', id='pohozhie-title', link={'url': '/shchenki/', 'label': 'Весь каталог — ' ~ puppies|length}, button=true) }}
      {% if similar %}
      {{ ct.strip(similar, breed=b) }}
      {% else %}
      {{ ui.empty_state('Других щенков этой породы сейчас нет', 'Оставьте заявку — напишем, когда появится новый помёт.') }}
      {% endif %}
    </section>

    <section class="section container" id="komu-podojdet" aria-labelledby="komu-podojdet-title">
      {{ ui.section_head('Кому подойдёт ' ~ b.name|lower, id='komu-podojdet-title') }}
      <ul class="pp-fits" data-reveal="items">
        {% for f in fits %}
        {%- set fs = imgsize(f.photo) or [928, 1152] %}
        <li class="pp-fit {{ b.tone_class }}">
          <span class="pp-fit__photo"><img src="{{ f.photo }}" alt="{{ f.alt|typo }}" width="{{ fs[0] }}" height="{{ fs[1] }}" style="object-position:{{ f.pos }}" loading="lazy" decoding="async"></span>
          <h3 class="pp-fit__title">{{ f.title|typo }}</h3>
          <p class="pp-fit__line">{{ f.line|typo }}</p>
        </li>
        {% endfor %}
      </ul>
    </section>

    {{ ui.advantages(includes, title='Что входит в покупку', id='chto-vhodit', link={'url': '/dokumenty-i-garantii/', 'label': 'Документы и гарантии'}, cols=4, button=true) }}

    <section class="section container" id="bron" aria-labelledby="bron-title">
      {{ ui.section_head('Бронь и доставка', id='bron-title') }}
      <div class="pp-terms">
        {% for blk in [booking, delivery] %}
        <div class="pp-term pp-term--{{ 'sun' if loop.first else 'mint' }}">
          {{ ui.ico('wallet' if loop.first else 'car', 'sun' if loop.first else 'mint') }}
          <h3 class="pp-term__title">{{ blk.title|typo }}</h3>
          <ul class="pp-term__list">
            {% for it in blk['items'] %}<li>{{ ui.icon('check', sm=true) }}<span>{{ it|typo }}</span></li>{% endfor %}
          </ul>
          <a class="btn btn--ink pp-term__btn" href="{{ blk.link.url }}">{{ blk.link.label|typo }}</a>
        </div>
        {% endfor %}
      </div>
    </section>

    {#- «Про <породу>» и «Читайте о породе» — одним блоком перед вопросами (клиент 19.10) -#}
    <section class="section container" id="pro-porodu" aria-labelledby="pro-porodu-title">
      {{ ui.section_head('Про ' ~ b.name_gen, id='pro-porodu-title') }}
      <div class="pp-breed__text">
        {% for t in intro %}<p>{{ t|typo }}</p>{% endfor %}
      </div>
      <ul class="advs advs--3 pp-facts" aria-label="Интересные факты">
        {% for f in facts %}
        <li class="adv">
          {{ ui.ico(f.icon, f.color) }}
          <h3 class="adv__title">{{ f.title|typo }}</h3>
          <p class="adv__line">{{ f.text|typo }}</p>
        </li>
        {% endfor %}
      </ul>
      <h3 class="pp-more__title" id="o-porode">Читайте о породе</h3>
      {{ ui.link_tiles(more) }}
    </section>

    {{ blocks.faq_section(faq_items, title='Частые вопросы') }}
{% endblock %}

{# «Похожие щенки» above replace the default strip #}
{% block pups %}{% endblock %}

{% block lead %}
    {{ forms.lead_form(title='Подберём щенка за 1 час', line=lead_line, tone=b.tone, breed=b.slug) }}
{% endblock %}
