{#- /vypuskniki/ — graduates in their new homes. Context (routes/trust.py): pg (data/trust.json → vypuskniki),
    stats (site.stats picked by icon), stories (items + breed). -#}
{% extends "layouts/page.html.j2" %}
{% import "trust/_parts.html.j2" as tr %}

{% block page_css %}
  <link rel="stylesheet" href="/assets/css/trust.css">
{% endblock %}

{% block hero %}
    {% call tr.framed_hero(pg.hero, tone='sand') %}
      <a class="btn btn--ink btn--lg" href="/shchenki/">Смотреть щенков {{ ui.icon('arrow') }}</a>
      <a class="btn btn--white btn--lg" href="/otzyvy/">Отзывы</a>
    {% endcall %}
{% endblock %}

{% block body %}
    <section class="section section--tight tr-kpis container" id="v-cifrah" aria-labelledby="v-cifrah-title">
      <h2 class="sr-only" id="v-cifrah-title">Питомник в&nbsp;цифрах</h2>
      {{ ui.stat_tiles(stats) }}
    </section>

    <section class="section container" id="foto" aria-labelledby="foto-title">
      {{ ui.section_head(pg.gallery.title, id='foto-title', lead=pg.gallery.lead) }}
      {{ ui.gallery(pg.gallery.photos, label='Фото выпускников') }}
    </section>

    <section class="section container" id="istorii" aria-labelledby="istorii-title">
      {{ ui.section_head(pg.stories.title, id='istorii-title', link={'url': '/otzyvy/', 'label': 'Все отзывы'}) }}
      <ul class="tr-stories" data-reveal="items">
        {% for s in stories %}
        <li>{{ tr.story(s) }}</li>
        {% endfor %}
      </ul>
    </section>

    <section class="section container" id="najdyom-shchenka" aria-labelledby="najdyom-shchenka-title">
      {{ ui.cta_band(pg.cta.title, line=pg.cta.line, label=pg.cta.label, tone='mint', title_id='najdyom-shchenka-title') }}
    </section>

    {{ ui.advantages(title='С каждым выпускником', lead='Документы, пожизненная гарантия и куратор, который на связи годами') }}

    <section class="section container" id="eshchyo" aria-labelledby="eshchyo-title">
      {{ ui.section_head(pg.links_title, id='eshchyo-title') }}
      {{ ui.link_tiles(pg.links) }}
    </section>
{% endblock %}
