{#- /roditeli/ — about the kennel: who the puppies come from. Context (routes/trust.py): pg (data/trust.json → roditeli),
    parents (items + breed), faq_items. -#}
{% extends "layouts/page.html.j2" %}
{% import "trust/_parts.html.j2" as tr %}

{% block page_css %}
  <link rel="stylesheet" href="/assets/css/trust.css">
{% endblock %}

{% block hero %}
    {% call tr.framed_hero(pg.hero, tone='cream') %}
      <a class="btn btn--ink btn--lg" href="/shchenki/">Смотреть щенков {{ ui.icon('arrow') }}</a>
      {{ forms.price_button(cls='btn btn--white btn--lg') }}
    {% endcall %}
{% endblock %}

{% block body %}
    <section class="section section--tight container" id="kak-rastim" aria-labelledby="kak-rastim-title">
      {{ ui.section_head(pg.ways.title, id='kak-rastim-title') }}
      {{ tr.feats(pg.ways['items']) }}
    </section>

    <section class="section container" id="mamy-i-papy" aria-labelledby="mamy-i-papy-title">
      {{ ui.section_head(pg.parents.title, id='mamy-i-papy-title', lead=pg.parents.lead, link={'url': '/dokumenty-i-garantii/', 'label': 'Документы и гарантии'}) }}
      <ul class="stiles tr-parents scroller" data-reveal="items">
        {% for p in parents %}
        <li>{{ tr.parent_tile(p) }}</li>
        {% endfor %}
      </ul>
      <p class="tr-note">{{ ui.icon('info', sm=true) }}<span>{{ pg.parents.note|typo }}</span></p>
    </section>

    {{ tr.band('uvidet-roditelej', pg.cta.title, line=pg.cta.line, label=pg.cta.label, tone='sun') }}

    <section class="section container" id="kak-vybiraem" aria-labelledby="kak-vybiraem-title">
      {{ ui.section_head(pg.pairs.title, id='kak-vybiraem-title') }}
      {{ ui.steps(pg.pairs['items']) }}
    </section>

    <section class="section container" id="eshchyo" aria-labelledby="eshchyo-title">
      {{ ui.section_head(pg.links_title, id='eshchyo-title') }}
      {{ ui.link_tiles(pg.links) }}
    </section>

    {{ blocks.faq_section(faq_items, title=pg.faq_title, id='voprosy') }}
{% endblock %}
