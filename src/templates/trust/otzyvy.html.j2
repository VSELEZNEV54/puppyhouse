{#- /otzyvy/ — the owners' photo reviews of the homepage (client 21.10: no breed filter, same cards with the real photos)
    and the «Оставить отзыв» modal (assets/js/trust.js: POST {api}/reviews in live mode — two separate consents:
    processing + publication, data/consent.json). Main buttons are coral, as on the homepage (body .page-reviews).
    Order: hero → ratings + «Ваш щенок от нас?» → reviews (12, «Показать ещё отзывы» opens the rest) → «Почему нам
    доверяют» → «Щенки в наличии» (8 cards of /shchenki/, as on the homepage, + «Весь каталог») → articles → lead form.
    Context (routes/trust.py): pg (data/trust.json → otzyvy), reviews (home.json → reviews_home), catalog (8 puppies). -#}
{% extends "layouts/page.html.j2" %}
{% import "trust/_parts.html.j2" as tr %}

{% block body_attrs %} class="page-reviews"{% endblock %}

{% block page_css %}
  <link rel="stylesheet" href="/assets/css/trust.css">
{% endblock %}

{% block page_js %}
  <script src="/assets/js/trust.js" defer></script>
{% endblock %}

{% block hero %}
    {% call tr.framed_hero(pg.hero, tone='coral') %}
      <a class="btn btn--ink btn--lg" href="/shchenki/">Смотреть щенков {{ ui.icon('arrow') }}</a>
      <button class="btn btn--white btn--lg" type="button" data-rv-open>{{ pg.write.label }}</button>
    {% endcall %}
{% endblock %}

{% block body %}
    <!-- ================= РЕЙТИНГ + «ВАШ ЩЕНОК ОТ НАС?» ================= -->
    <section class="section container tr-rate-sec" id="rejting" aria-labelledby="rejting-title">
      <h2 class="sr-only" id="rejting-title">Рейтинг питомника</h2>
      <div class="tr-rate">
        {{ cards.ratings() }}
        <div class="tr-write tone--lilac">
          <p class="tr-write__title">{{ pg.write.title|typo }}</p>
          <p class="tr-write__line">{{ pg.write.line|typo }}</p>
          <button class="btn btn--ink" type="button" data-rv-open>{{ pg.write.label }}</button>
        </div>
      </div>
    </section>

    <!-- ================= ОТЗЫВЫ — те же карточки с фото, что на главной ================= -->
    {#- 12 карточек (на телефоне 6), «Показать ещё отзывы» открывает остальные (trust.js); без JS видны все -#}
    <section class="section container tr-rvws-sec" id="vse-otzyvy" aria-labelledby="vse-otzyvy-title">
      <h2 class="sr-only" id="vse-otzyvy-title">Отзывы владельцев</h2>
      <ul class="tr-rvws" data-rvw-grid>
        {% for r in reviews %}
        <li>
          {{ media.photo_review_card(r)|indent(10) }}
        </li>
        {% endfor %}
      </ul>
      <div class="tr-rvws__foot">
        <button class="btn btn--white btn--lg" type="button" data-rvw-grid-more hidden>{{ pg.more }}</button>
      </div>
    </section>

    {{ ui.advantages(title='Почему нам доверяют', link={'url': '/dokumenty-i-garantii/', 'label': 'Документы и гарантии'}) }}

    <!-- ================= ЩЕНКИ В НАЛИЧИИ — как каталог на главной: карточки и кнопка под сеткой ================= -->
    <section class="section container" id="pups" aria-labelledby="pups-title">
      {{ ui.section_head('Щенки в наличии', id='pups-title') }}
      <ul class="pups hm-pups tr-pups" data-reveal="items">
        {% for p in catalog %}
        <li class="pups__item">
          {{ cards.puppy_card(p) }}
        </li>
        {% endfor %}
      </ul>
      <div class="hm-pups__foot">
        <a class="btn btn--ink btn--lg" href="/shchenki/">Весь каталог {{ ui.icon('arrow') }}</a>
      </div>
    </section>
{% endblock %}

{% block body_end %}
  <!-- Модалка «Оставить отзыв» (assets/js/trust.js) -->
  <dialog class="modal tr-rvm" id="review-modal" aria-labelledby="rm-title" aria-describedby="rm-sub">
    <div class="modal__inner">
      <button class="msgr modal__close" type="button" aria-label="Закрыть" data-rv-close>{{ ui.icon('close') }}</button>
      <div class="modal__view" data-rv-view="form">
        <div class="modal__head">
          <div>
            <h2 class="modal__title" id="rm-title">{{ pg.modal.title|typo }}</h2>
            <p class="modal__sub" id="rm-sub">{{ pg.modal.sub|typo }}</p>
          </div>
        </div>
        <form class="form" id="review-form" novalidate>
          <div class="form__grid">
            <div class="field">
              <label class="field__label" for="rm-name">Имя</label>
              <input class="input" id="rm-name" name="name" type="text" autocomplete="given-name" placeholder="Как вас подписать" maxlength="100" required aria-describedby="rm-name-err">
              <p class="field__err" id="rm-name-err" hidden></p>
            </div>
            <div class="field">
              <label class="field__label" for="rm-phone">Телефон</label>
              <input class="input" id="rm-phone" name="phone" type="tel" inputmode="tel" autocomplete="tel" placeholder="+7 (___) ___-__-__" required aria-describedby="rm-phone-hint rm-phone-err" data-phone>
              <p class="field__hint" id="rm-phone-hint">Не публикуем. Позвоним, только если нужно уточнить отзыв</p>
              <p class="field__err" id="rm-phone-err" hidden></p>
            </div>
            <div class="field">
              <label class="field__label" for="rm-city">Город</label>
              <input class="input" id="rm-city" name="city" type="text" autocomplete="address-level2" placeholder="Например, Казань" maxlength="100">
            </div>
            <div class="field field--full">
              <label class="field__label" for="rm-breed">Порода щенка</label>
              <select class="input select" id="rm-breed" name="breed">
                <option value="" selected>Выберите породу</option>
                {% for b in breeds %}
                <option value="{{ b.slug }}">{{ b.name }}</option>
                {% endfor %}
              </select>
            </div>
            <fieldset class="field field--full tr-stars">
              <legend class="field__label">Оценка</legend>
              <div class="tr-stars__row">
                {% for n in range(1, 6) %}
                <input type="radio" name="rating" id="rm-r{{ n }}" value="{{ n }}"{% if n == 5 %} checked{% endif %}><label for="rm-r{{ n }}"><span class="sr-only">{{ n }} из&nbsp;5</span>{{ ui.icon('star') }}</label>
                {% endfor %}
              </div>
              <p class="field__err" id="rm-rating-err" hidden></p>
            </fieldset>
            <div class="field field--full">
              <label class="field__label" for="rm-text">Отзыв</label>
              <textarea class="input tr-textarea" id="rm-text" name="text" rows="4" placeholder="Как щенок освоился дома, что понравилось, что можно улучшить" maxlength="4000" required aria-describedby="rm-text-err"></textarea>
              <p class="field__err" id="rm-text-err" hidden></p>
            </div>
            {{ forms.honeypot('rm')|indent(12) }}
            {{ forms.consent_check('rm', kind='review')|indent(12) }}
            {{ forms.consent_check('rm', kind='distribution', name='consent_publish', privacy=false)|indent(12) }}
          </div>
          <button class="btn btn--ink btn--lg btn--block form__submit" type="submit" data-rv-submit data-label="Отправить отзыв">Отправить отзыв</button>
          <div class="form-fail" data-rv-fail role="alert" hidden>
            {{ forms.send_fail('отзыв', 'его')|indent(12) }}
          </div>
        </form>
      </div>
      <div class="modal__view modal__done" data-rv-view="done" hidden>
        <span class="form-done__ico" aria-hidden="true">{{ ui.icon('check') }}</span>
        <h2 class="modal__title" id="rm-done-title" tabindex="-1">{{ pg.modal.done_title|typo }}</h2>
        <p class="modal__sub" id="rm-done-text">{{ pg.modal.done_text|typo }}</p>
        <button class="btn btn--ink btn--lg btn--block" type="button" data-rv-close>Хорошо</button>
      </div>
    </div>
  </dialog>
{% endblock %}
