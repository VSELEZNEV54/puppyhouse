{#- 404.html — «Страница не найдена». Built by tools/build.py (not a route): the server shows it for any missing
    address at any depth, so links are written relative to the site root and the page sets <base> itself —
    "/" on the production domain, "/puppyhouse/" on the GitHub Pages preview. robots: noindex. -#}
{% extends "layouts/page.html.j2" %}

{% block base_href %}
  <script>document.write('<base href="' + (location.pathname.indexOf('/puppyhouse/') === 0 ? '/puppyhouse/' : '/') + '">')</script>
{% endblock %}

{% block hero %}
    {% call ui.page_hero('Страница не найдена', lead='Возможно, ссылка устарела или в адресе опечатка. Щенки в наличии, породы и контакты — по ссылкам ниже.', faces=true) %}
      <a class="btn btn--ink btn--lg" href="/shchenki/">Щенки в наличии {{ ui.icon('arrow') }}</a>
      <a class="btn btn--white btn--lg" href="/">На главную</a>
    {% endcall %}
{% endblock %}

{% block body %}
    <section class="section container" id="porody" aria-labelledby="porody-title">
      {{ ui.section_head('Четыре породы питомника', id='porody-title', link={'url': '/kontakty/', 'label': 'Контакты питомника'}) }}
      {{ cards.breed_tiles(cols=2) }}
    </section>
{% endblock %}
