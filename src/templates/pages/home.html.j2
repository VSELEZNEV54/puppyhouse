{#- Homepage — redesigned 13.10 (docs/brief.md → «Правки клиента 13.10» → «Главная (новый порядок)»).
    Route: src/routes/home.py, data: src/data/home.json. Context: title, description, stats (site.stats + line),
    media_items, reviews_home, faq_items, teasers. Loads only main.css: every homepage rule lives there. -#}
{% extends "base.html.j2" %}
{% import "macros/ui.html.j2" as ui %}
{% import "macros/cards.html.j2" as cards %}
{% import "macros/forms.html.j2" as forms %}
{% import "macros/blocks.html.j2" as blocks %}
{% import "macros/media.html.j2" as media %}

{#- class for homepage-only rules in main.css (coral main buttons, 15.10) -#}
{% block body_attrs %} class="page-home"{% endblock %}

{% block head_extra %}
  {#- Organization for search engines: name «домщенков.рф», production URL in punycode, phone, city, messengers -#}
  {%- set home_url = 'https://' ~ (site.get('domain_ascii') or site.domain) ~ '/' -%}
  <script type="application/ld+json">{{ {'@context': 'https://schema.org', '@type': 'Organization', 'name': site.brand, 'url': home_url, 'description': description, 'telephone': site.phone.tel[4:], 'address': {'@type': 'PostalAddress', 'addressLocality': site.address.city, 'addressCountry': 'RU'}, 'areaServed': 'RU', 'sameAs': [site.messengers.telegram.url, site.messengers.whatsapp.url, site.messengers.max.url]}|tojson }}</script>
{% endblock %}

{% block content %}
    <!-- ================= ПЕРВЫЙ ЭКРАН — на весь экран ================= -->
    <section class="hero hero--full container" id="top" aria-labelledby="hero-title">
      <div class="hero__main tone--cream">
        <span class="hero__floor" aria-hidden="true"></span>
        <div class="hero__copy">
          <p class="eyebrow"><span class="eyebrow__dot" aria-hidden="true"></span>Питомник щенков · Москва</p>
          <h1 class="h1" id="hero-title">Купить щенка в&nbsp;Москве напрямую от&nbsp;заводчика</h1>
          <p class="hero__sub">Проверенный заводчик в&nbsp;Москве. Щенки мальтипу, французского бульдога, <span class="nw">той-пуделя</span> и&nbsp;<span class="nw">бордер-колли</span>&nbsp;— с&nbsp;гарантией и&nbsp;заботой о&nbsp;каждом малыше</p>
          <div class="hero__actions" data-hero-ctas>
            <a class="btn btn--ink btn--lg" href="/shchenki/">Выбрать щенка {{ ui.icon('arrow') }}</a>
            <button class="btn btn--white btn--lg" type="button" data-open-modal data-modal-title="Получить консультацию" data-modal-sub="Расскажем о&nbsp;породах и&nbsp;щенках в&nbsp;наличии, ответим на&nbsp;вопросы и&nbsp;пришлём цены" data-modal-note="Консультация (главная)" data-modal-submit="Получить консультацию" data-modal-done="Спасибо! Куратор свяжется с&nbsp;вами в&nbsp;течение рабочего дня">Получить консультацию</button>
          </div>
        </div>
        <div class="hero__photo">
          <img src="/assets/img/hero-four-breeds.jpg" alt="Щенки мальтипу, французского бульдога, той-пуделя и&nbsp;бордер-колли сидят в&nbsp;ряд" width="1264" height="848" fetchpriority="high" decoding="async">
        </div>
        {#- четыре главных преимущества — одной строкой во всю ширину плитки, в самом низу первого экрана (правка 15.10) -#}
        <ul class="hm-chips" aria-label="Коротко о щенках">
          {% for icon, color, label in [('syringe', 'mint', 'Привиты по возрасту'), ('doc', 'sky', 'Ветпаспорт и договор'), ('chat', 'lilac', 'Пожизненная консультация'), ('car', 'sun', 'Доставка по всей России')] %}
          <li class="hm-chip"><span class="hm-chip__ico" style="--c:var(--{{ color }})" aria-hidden="true">{{ ui.icon(icon, sm=true) }}</span>{{ label|typo }}</li>
          {% endfor %}
        </ul>
      </div>
    </section>

    <!-- ================= О НАШЕМ ПИТОМНИКЕ ================= -->
    <section class="section container" id="o-pitomnike" aria-labelledby="about-title">
      {{ ui.section_head('О нашем питомнике', id='about-title') }}
      <div class="hm-about">
        <div class="hm-about__txt">
          <p class="hm-about__lead">Мы&nbsp;— «Дом щенков», питомник собак в&nbsp;Москве. Разводим <a href="/maltipu/">мальтипу</a>, <a href="/francuzskij-buldog/">французских бульдогов</a>, <a class="nw" href="/toj-pudel/">той-пуделей</a> и&nbsp;<a class="nw" href="/border-kolli/">бордер-колли</a>.</p>
          {#- то, чего боятся при покупке щенка: перекупщики, больной щенок, «продали и пропали» -#}
          <ul class="hm-about__list">
            <li><span class="hm-about__ico" style="--c:var(--sun)" aria-hidden="true">{{ ui.icon('home', sm=true) }}</span><span><b>Без перекупщиков.</b> Щенки родились у&nbsp;нас и&nbsp;растут дома, рядом с&nbsp;людьми. Маму и&nbsp;малыша покажем по&nbsp;видео.</span></li>
            <li><span class="hm-about__ico" style="--c:var(--mint)" aria-hidden="true">{{ ui.icon('shield', sm=true) }}</span><span><b>Здоровье в&nbsp;документах.</b> Осмотр ветеринара, прививки по&nbsp;возрасту, ветпаспорт и&nbsp;договор.</span></li>
            <li><span class="hm-about__ico" style="--c:var(--lilac)" aria-hidden="true">{{ ui.icon('chat', sm=true) }}</span><span><b>Не&nbsp;пропадаем после покупки.</b> Гарантия по&nbsp;договору и&nbsp;советы по&nbsp;уходу всю жизнь собаки.</span></li>
          </ul>
          <a class="btn btn--ink hm-about__cta" href="/roditeli/">Подробнее о&nbsp;питомнике {{ ui.icon('arrow') }}</a>
        </div>
        <figure class="hm-about__photo">
          <img src="/assets/img/parents-maltipu.jpg" alt="Мама-мальтипу со&nbsp;щенками на&nbsp;лежанке в&nbsp;доме" width="1264" height="848" loading="lazy" decoding="async">
        </figure>
      </div>
      <ul class="hm-stats" aria-label="Питомник в цифрах">
        {% for s in stats %}
        <li class="hm-stat">
          {{ ui.ico(s.icon, s.color) }}
          <b class="hm-stat__num">{{ s.num|typo }}</b>
          <span class="hm-stat__cap">{{ s.cap|typo }}</span>
          {% if s.line %}<span class="hm-stat__line">{{ s.line|typo }}</span>{% endif %}
        </li>
        {% endfor %}
      </ul>
    </section>

    <!-- ================= ПОРОДЫ — по две в ряд ================= -->
    <section class="section container" id="porody" aria-labelledby="porody-title">
      {{ ui.section_head('Четыре породы питомника', id='porody-title', link={'url': '/shchenki/', 'label': 'Все щенки в наличии — ' ~ puppies|length}) }}
      {{ cards.breed_tiles(cols=2) }}
    </section>

    <!-- ================= ФОТО И ВИДЕО ЩЕНКОВ + ЗАЯВКА ================= -->
    {% call media.media_carousel(media_items, title='Фото и видео щенков', id='foto-video', lead='Как растут наши щенки — живые кадры из питомника', label='Фото и видео щенков') %}
      {{ ui.lead_band(title='Хотите увидеть щенков вживую?', line='Покажем по видеосвязи и пришлём цены — в удобное вам время') }}
    {% endcall %}

    <!-- ================= ПРЕИМУЩЕСТВА ================= -->
    {{ ui.advantages(title='Почему выбирают нас', lead='Отвечаем за щенка не только в день покупки', link={'url': '/dokumenty-i-garantii/', 'label': 'Документы и гарантии'}) }}

    <!-- ================= ОТЗЫВЫ — видеокарточки ================= -->
    {{ media.video_reviews(reviews_home, title='Отзывы владельцев', id='otzyvy') }}

    <!-- ================= КАК КУПИТЬ ================= -->
    <section class="section container" id="kak-kupit" aria-labelledby="steps-title">
      {% call ui.section_head('Как купить щенка', id='steps-title') %}{{ forms.price_button() }}{% endcall %}
      {{ ui.steps([
        {'title': 'Заявка', 'text': 'Оставьте номер — пришлём цену'},
        {'title': 'Видеозвонок', 'text': 'Знакомитесь со щенком онлайн'},
        {'title': 'Бронь', 'text': 'Договор и предоплата — щенок ваш'},
        {'title': 'Встреча', 'text': 'Забираете сами или привезём'},
      ]) }}
    </section>

    <!-- ================= ВОПРОСЫ ================= -->
    {{ blocks.faq_section(faq_items, title='Вопросы о покупке щенка') }}

    <!-- ================= СТАТЬИ О ПОРОДАХ ================= -->
    {{ blocks.blog_teasers(posts=teasers, title='Почитать о породах', lead='Характер, уход и выбор щенка — коротко и по делу') }}

    <!-- ================= SEO-ТЕКСТ — на всю ширину плитки (правка 15.10), ключи из семантического ядра ================= -->
    {% call blocks.seo_block('Питомник собак в Москве: щенки от заводчика', 'Купить щенка в Москве напрямую от заводчика надёжнее, чем по объявлению: вы видите маму, документы и условия, в которых рос малыш. Питомник собак «Дом щенков» продаёт щенков мальтипу, французского бульдога, той-пуделя и бордер-колли с ветпаспортом, прививками по возрасту и договором — с доставкой по Москве, Московской области и всей России.', id='kupit-shchenka', key='seo') %}
{% filter typo %}
            <h3>Щенки от заводчика без посредников</h3>
            <p>Мы не перекупщики и не зоомагазин. Все щенки родились в нашем питомнике и растут дома, рядом с людьми, а не в вольерах. Поэтому мы знаем характер каждого малыша, его родителей и родословную. До брони покажем щенка и маму по видеосвязи, пришлём свежие фото и видео. Купить щенка у заводчика — значит получить здорового, ручного малыша и честную историю его жизни.</p>
            <h3>Щенки мальтипу, французского бульдога, той-пуделя и бордер-колли</h3>
            <p><a href="/maltipu/">Щенки мальтипу</a> — маленькие ласковые компаньоны для квартиры. Мальтипу — помесь мальтийской болонки и той- или миниатюрного пуделя. В питомнике есть поколения F1 и F1b: взрослые мальтипу весят 2–5 кг, стандартные — до 7 кг. Шерсть почти не линяет, но абсолютно гипоаллергенных собак не бывает: реакция зависит от человека.</p>
            <p><a href="/francuzskij-buldog/">Щенок французского бульдога</a> — спокойный городской друг весом 8–14 кг: ему хватает обычных прогулок, а летом его нужно беречь от жары. <a href="/toj-pudel/">Щенки той-пуделя</a> вырастают до 28 см в холке и весят 2–4 кг, быстро учатся, а их шерсть практически не линяет. <a href="/border-kolli/">Щенки бордер-колли</a> — для активной семьи: это умная пастушья порода ростом 46–56 см в холке, которой нужны ежедневные занятия.</p>
            <h3>Маленькие породы собак для квартиры</h3>
            <p>Ищете собаку для квартиры или собаку для ребёнка? Присмотритесь к маленьким породам: мальтипу и той-пудель почти не линяют, легко привыкают к пелёнке и не требуют долгих прогулок. Французский бульдог спокоен и хорошо уживается в городской квартире. Если сомневаетесь, какая порода подойдёт, пройдите <a href="/podbor-porody/">тест подбора породы</a> — он займёт пару минут.</p>
            <h3>Документы на щенка, прививки и гарантия</h3>
            <p>Каждый щенок уезжает с договором купли-продажи и ветеринарным паспортом. В паспорте — отметки о прививках по возрасту и обработках от паразитов. Щенки французского бульдога, той-пуделя и бордер-колли получают метрику РКФ, которую позже меняют на родословную. Мальтипу — гибрид, РКФ его не регистрирует, поэтому к щенку прилагаем копии родословных родителей. Перед продажей каждого щенка осматривает ветеринар. Гарантия прописана в договоре, а советы по уходу, кормлению и прививкам даём всю жизнь собаки. Подробнее — в разделе <a href="/dokumenty-i-garantii/">документы и гарантии</a>.</p>
            <h3>Доставка щенков по России</h3>
            <p>Привезём щенка на машине с куратором, отправим самолётом в салоне с сопровождающим или поездом. Доставляем щенков в 60+ городов: <a href="/dostavka/sankt-peterburg/">Санкт-Петербург</a>, <a href="/dostavka/kazan/">Казань</a>, <a href="/dostavka/ekaterinburg/">Екатеринбург</a>, Новосибирск, Краснодар и другие. Способ перевозки подбираем под породу и возраст: маленьким щенкам подходит перелёт в салоне, бордер-колли обычно едут на машине. В дороге присылаем фото и видео. Все условия — на странице <a href="/dostavka/">доставка щенков</a>.</p>
            <h3>Купить щенка в Москве и Московской области</h3>
            <p>Наш питомник собак в Москве принимает гостей по записи: познакомьтесь со щенками, посмотрите на маму и обсудите уход. Или выберите щенка по видео — привезём его к дому в Москве, Химках, Красногорске, Балашихе, Подольске, Мытищах, Люберцах или другом городе Московской области. Хотите порадовать близких — поможем подарить <a href="/shchenok-v-podarok/">щенка в подарок</a>.</p>
            <h3>Сколько стоит щенок</h3>
            <p>Цена щенка зависит от породы, поколения, окраса, пола и перспектив малыша. Цены меняются вместе с наличием, поэтому мы присылаем их лично: оставьте заявку, и куратор пришлёт щенков в наличии с ценами и свежими видео. Понравившегося щенка можно забронировать или взять в <a href="/rassrochka/">рассрочку</a>.</p>
{% endfilter %}
    {% endcall %}

    <!-- ================= ЗАЯВКА: плитка с лапками + контакты отдельными плашками под ней (правка 15.10) ================= -->
    {% call forms.lead_form(contacts=false, cls='hm-lead') %}
      {{ forms.contact_tiles() }}
    {% endcall %}
{% endblock %}
