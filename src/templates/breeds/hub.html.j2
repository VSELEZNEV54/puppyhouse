{#- Breed hub (/maltipu/ and the other three) — one template, copy in data/breeds-hub.json, photos in breeds.json.
    Context: b (breed), hub (copy, Markup), common (copy shared by the hubs), reel (carousel items), pups (all puppies
    of the breed, sorted), colours (colour cards of the varieties page, breedsub.colour_items), links.
    Order (client 13.10): full-screen hero → photo / video carousel → puppies → advantages → «Какой он» → colours →
    before buying (parents, price, documents) → FAQ → links → SEO text → lead form. -#}
{% extends "layouts/page.html.j2" %}
{% import "breedsub/_parts.html.j2" as part %}

{% block page_css %}
  <link rel="stylesheet" href="/assets/css/breedsub.css">
  <link rel="stylesheet" href="/assets/css/breeds.css">
{% endblock %}

{% block hero %}
    {% call ui.page_hero(hub.h1, lead=hub.lead, breed=b, eyebrow=hub.eyebrow, chips=common.chips, full=true, note=hub.note) %}
      <button class="btn btn--white btn--lg" type="button" data-open-modal data-modal-kind="help" data-modal-breed="{{ b.name }}" data-modal-title="{{ common.modal_title }}" data-modal-sub="{{ common.modal_sub }}" data-modal-note="{{ common.modal_note }}: {{ b.name|lower }}" data-modal-submit="{{ common.cta_main }}">{{ common.cta_main }}</button>
      <a class="btn btn--outline btn--lg" href="#shchenki">{{ common.cta_second }}</a>
    {% endcall %}
{% endblock %}

{% block body %}
    {{ media.media_carousel(reel, title=hub.media_title, id='foto-video', lead=common.media_lead, label=hub.media_label) }}

    <section class="section container" id="shchenki" aria-labelledby="shchenki-title">
      {{ ui.section_head(hub.pups_title, id='shchenki-title', link={'url': '/shchenki/', 'label': 'Смотреть в каталоге'}) }}
      {% if pups %}
      {%- set n = pups|length %}
      <ul class="pups" data-reveal="items">
        {% for p in pups %}
        <li class="pups__item">
          {{ cards.puppy_card(p) }}
        </li>
        {% endfor %}
        <li class="pups__more pups__more--fill" style="--s4:{{ 4 - n % 4 }};--s3:{{ 3 - n % 3 }};--s2:{{ 2 - n % 2 }}">
          {{ cards.soon_tile(breed=b) }}
        </li>
      </ul>
      {% else %}
      {{ ui.empty_state('Сейчас щенков нет в наличии', 'Оставьте заявку — напишем, когда появится новый помёт.') }}
      {% endif %}
    </section>

    {{ ui.advantages(title=common.adv_title, lead=common.adv_lead, link={'url': '/dokumenty-i-garantii/', 'label': 'Документы и гарантии'}) }}

    <section class="section container" id="kakoj-on" aria-labelledby="kakoj-on-title">
      {{ ui.section_head(hub.about_title, id='kakoj-on-title') }}
      <div class="brd-about">
        <div class="brd-about__media">{{ ui.img(hub.about_photo.src, hub.about_photo.alt) }}</div>
        <ul class="brd-about__list">
          {% for t in hub.traits %}
          <li class="brd-trait">
            <p class="brd-trait__label">{{ t.label|typo }}</p>
            {{ ui.ico(t.icon, t.color, sm=true) }}
            <h3 class="brd-trait__title">{{ t.title|typo }}</h3>
            <p class="brd-trait__line">{{ t.line|typo }}</p>
          </li>
          {% endfor %}
        </ul>
      </div>
    </section>

    <section class="section container" id="okrasy" aria-labelledby="okrasy-title">
      {{ ui.section_head(hub.colours_title, id='okrasy-title', lead=hub.colours_lead) }}
      {{ part.colour_nav(colours, b, url=b.urls.varieties, label=b.name ~ ': окрасы', cta={'url': b.urls.varieties ~ '#okrasy', 'label': 'Все окрасы'}) }}
    </section>

    <section class="section container" id="pered-pokupkoj" aria-labelledby="pered-pokupkoj-title">
      {{ ui.section_head('Перед покупкой', id='pered-pokupkoj-title') }}
      <div class="brd-pre">
        <div class="brd-pre__price brd-card">
          <div class="brd-card__head">
            <h3 class="brd-card__title">{{ hub.price_title|typo }}</h3>
            {{ ui.ico('wallet', 'sun') }}
          </div>
          <p class="brd-card__line">Цену называем лично. Она зависит от:</p>
          <ul class="brd-card__chips">
            {% for f in hub.price_factors %}<li>{{ f|typo }}</li>{% endfor %}
          </ul>
          <div class="brd-card__actions">
            {{ forms.price_button(breed=b.name) }}
            {{ ui.link_button(b.urls.price, 'Подробнее о цене') }}
          </div>
        </div>
        <div class="brd-pre__docs brd-card">
          <div class="brd-card__head">
            <h3 class="brd-card__title">Документы на&nbsp;щенка</h3>
            {{ ui.ico('doc', 'sky') }}
          </div>
          <p class="brd-card__line">{{ hub.docs_line|typo }}</p>
          {{ ui.badges(hub.docs) }}
          <div class="brd-card__actions">
            {{ ui.link_button('/dokumenty-i-garantii/', 'Документы и гарантии') }}
          </div>
        </div>
      </div>
    </section>

    {{ blocks.faq_section(hub.faq, title=hub.faq_title) }}

    <section class="section container brd-links" id="sravnenie" aria-labelledby="sravnenie-title">
      {{ ui.section_head('Сравнить и почитать', id='sravnenie-title') }}
      {{ ui.link_tiles(links) }}
    </section>

    {% call blocks.seo_block(hub.seo.title, hub.seo.lead, id='o-porode') %}
        {% for s in hub.seo.blocks %}
        <h3>{{ s.h|typo }}</h3>
        <p>{{ s.p|typo }}</p>
        {% endfor %}
    {% endcall %}
{% endblock %}

{% block lead %}
    {{ forms.lead_form(title=hub.lead_title, line=hub.lead_line, tone=b.tone, breed=b.slug) }}
{% endblock %}
