{#- Parts of the breed page v2 and the colour pages (/<breed>/<colour>/). -#}
{% import "macros/ui.html.j2" as ui %}

{#- Colour cards to scroll through (a [data-carousel] with data-align="start", main.js): studio photo → the colour page,
    «Кремовый мальтипу», one line, «Подобрать кремового мальтипу» (modal with the colour) + «Подробнее» (the colour page).
    items: breedsub.colour_items of the breed; b: the breed; label: aria-label of the carousel. -#}
{% macro colour_carousel(items, b, label) -%}
{%- set nc = items|length -%}
<div class="media-carousel brd-cols" data-carousel data-align="start" data-start="0" role="region" aria-roledescription="карусель" aria-label="{{ label }}">
  <div class="media-carousel__viewport" tabindex="0" data-carousel-viewport>
    <ul class="media-carousel__track">
      {% for c in items %}
      {%- set url = b.urls.hub ~ c.slug ~ '/' %}
      <li class="media-carousel__item{{ ' is-active' if loop.first }}" aria-roledescription="слайд" aria-label="{{ loop.index }} из {{ nc }}: {{ c.title }}">
        <article class="brd-col">
          {%- set size = imgsize(c.photo.src) %}
          <a class="brd-col__media" href="{{ url }}" tabindex="-1" aria-hidden="true" style="{{ tone_style(c.photo.src) }}">
            <img src="{{ c.photo.src }}" alt="{{ c.photo.alt|typo }}" width="{{ size[0] }}" height="{{ size[1] }}" loading="lazy" decoding="async">
          </a>
          <div class="brd-col__body">
            <h3 class="brd-col__name"><a href="{{ url }}">{{ c.title|typo }}</a></h3>
            <p class="brd-col__text">{{ (c.short or c.text)|typo }}</p>
            <div class="brd-col__actions">
              <button class="btn btn--ink brd-col__btn" type="button" data-open-modal data-modal-breed="{{ b.name }}" data-modal-title="Подберём {{ c.pick }}" data-modal-sub="Пришлём щенков этого окраса с фото, видео и ценой. Нет сейчас — напишем, когда появятся" data-modal-note="Окрас: {{ c.label|lower }}" data-modal-submit="Подобрать щенка">Подобрать {{ c.pick|typo }}</button>
              <a class="btn btn--white brd-col__btn" href="{{ url }}" aria-label="Подробнее: {{ c.title }}">Подробнее</a>
            </div>
          </div>
        </article>
      </li>
      {% endfor %}
    </ul>
  </div>
  <div class="media-carousel__nav">
    <button class="media-carousel__btn" type="button" data-carousel-prev aria-label="Предыдущий окрас">{{ ui.icon('arrow', cls='i--flip') }}</button>
    <button class="media-carousel__btn" type="button" data-carousel-next aria-label="Следующий окрас">{{ ui.icon('arrow') }}</button>
  </div>
</div>
{%- endmacro %}

{#- «Получить консультацию» about colours: the button in the head of a colours section. -#}
{% macro colour_consult(b) -%}
<button class="btn btn--white brd-help" type="button" data-open-modal data-modal-breed="{{ b.name }}" data-modal-title="Поможем выбрать окрас" data-modal-sub="Расскажем, как меняется окрас с возрастом, и пришлём щенков нужного цвета с видео" data-modal-note="Консультация: окрас, {{ b.name|lower }}" data-modal-submit="Получить консультацию">Получить консультацию</button>
{%- endmacro %}
