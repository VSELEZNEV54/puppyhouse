{#- Parts of the breed page v2 and the colour pages (/<breed>/<colour>/). -#}
{% import "macros/ui.html.j2" as ui %}

{#- Colour cards to scroll through (a [data-carousel] with data-align="start", main.js): studio photo → the colour page,
    «Кремовый мальтипу», one line, «Подобрать щенка» (client 19.10: short; the modal says «Подберём кремового мальтипу»
    and carries the colour) + «Подробнее» (the colour page).
    items: breedsub.colour_items of the breed; b: the breed; label: aria-label of the carousel. -#}
{% macro colour_carousel(items, b, label) -%}
{%- set nc = items|length -%}
<div class="media-carousel brd-cols" data-carousel data-align="start" data-start="0" role="region" aria-roledescription="карусель" aria-label="{{ label }}">
  <div class="media-carousel__viewport" tabindex="0" data-carousel-viewport>
    <ul class="media-carousel__track">
      {% for c in items %}
      {%- set url = b.urls.hub ~ c.slug ~ '/' %}
      <li class="media-carousel__item{{ ' is-active' if loop.first }}" aria-roledescription="слайд" aria-label="{{ loop.index }} из {{ nc }}: {{ c.title }}">
        <article class="brd-col">
          {%- set size = imgsize(c.photo.src) %}
          <a class="brd-col__media" href="{{ url }}" tabindex="-1" aria-hidden="true" style="{{ tone_style(c.photo.src) }}">
            <img src="{{ c.photo.src }}" alt="{{ c.photo.alt|typo }}" width="{{ size[0] }}" height="{{ size[1] }}" loading="lazy" decoding="async">
          </a>
          <div class="brd-col__body">
            <h3 class="brd-col__name"><a href="{{ url }}">{{ c.title|typo }}</a></h3>
            <p class="brd-col__text">{{ (c.short or c.text)|typo }}</p>
            <div class="brd-col__actions">
              <button class="btn btn--ink brd-col__btn" type="button" data-open-modal data-modal-kind="colour" data-modal-colour="{{ c.slug }}" data-modal-breed="{{ b.name }}" data-modal-title="Подберём {{ c.pick }}" data-modal-sub="Пришлём щенков этого окраса с фото, видео и ценой. Нет сейчас — напишем, когда появятся" data-modal-note="Окрас: {{ c.label|lower }}" data-modal-submit="Подобрать щенка" aria-label="Подобрать щенка: {{ c.label|lower }} окрас">Подобрать щенка</button>
              <a class="btn btn--white brd-col__btn" href="{{ url }}" aria-label="Подробнее: {{ c.title }}">Подробнее</a>
            </div>
          </div>
        </article>
      </li>
      {% endfor %}
    </ul>
  </div>
  <div class="media-carousel__nav">
    <button class="media-carousel__btn" type="button" data-carousel-prev aria-label="Предыдущий окрас">{{ ui.icon('arrow', cls='i--flip') }}</button>
    <button class="media-carousel__btn" type="button" data-carousel-next aria-label="Следующий окрас">{{ ui.icon('arrow') }}</button>
  </div>
</div>
{%- endmacro %}

{#- «Получить консультацию» about colours: the button in the head of a colours section. -#}
{% macro colour_consult(b) -%}
<button class="btn btn--white brd-help" type="button" data-open-modal data-modal-kind="consult" data-modal-breed="{{ b.name }}" data-modal-title="Поможем выбрать окрас" data-modal-sub="Расскажем, как меняется окрас с возрастом, и пришлём щенков нужного цвета с видео" data-modal-note="Консультация: окрас, {{ b.name|lower }}" data-modal-submit="Получить консультацию">Получить консультацию</button>
{%- endmacro %}

{#- Articles about the breed (client 15.10): four wide article cards in a row, the rest beyond the edge — arrows and
    swipe ([data-carousel] data-align="start", main.js), on phones a compact list as everywhere (no sideways swipe).
    The cards are blocks.blog_teasers' .bteaser (same look). posts: [{"url", "title", "line", "cover", "topic"}]. -#}
{% macro post_carousel(posts, label) -%}
{%- set n = posts|length -%}
<div class="media-carousel brd-posts" data-carousel data-align="start" data-start="0" role="region" aria-roledescription="карусель" aria-label="{{ label }}">
  <div class="media-carousel__viewport" tabindex="0" data-carousel-viewport>
    <ul class="media-carousel__track">
      {% for c in posts %}
      {%- set size = imgsize(c.cover.src) or [1264, 848] %}
      <li class="media-carousel__item{{ ' is-active' if loop.first }}" aria-roledescription="слайд" aria-label="{{ loop.index }} из {{ n }}">
        <article class="bteaser">
          <div class="bteaser__media">
            <img src="{{ c.cover.src }}" alt="{{ c.cover.alt|typo }}" width="{{ size[0] }}" height="{{ size[1] }}"{% if c.cover.pos is defined and c.cover.pos %} style="object-position:{{ c.cover.pos }}"{% endif %} loading="lazy" decoding="async">
            {% if c.topic %}<span class="bteaser__topic">{{ c.topic|typo }}</span>{% endif %}
          </div>
          <div class="bteaser__body">
            <h3 class="bteaser__title"><a class="bteaser__link" href="{{ c.url }}">{{ ui.nohyph(c.title) }}</a></h3>
            <p class="bteaser__line">{{ c.line|typo }}</p>
            <span class="tcta tcta--soft" aria-hidden="true">Читать {{ ui.icon('arrow', sm=true) }}</span>
          </div>
        </article>
      </li>
      {% endfor %}
    </ul>
  </div>
  <div class="media-carousel__nav">
    <button class="media-carousel__btn" type="button" data-carousel-prev aria-label="Предыдущие статьи">{{ ui.icon('arrow', cls='i--flip') }}</button>
    <button class="media-carousel__btn" type="button" data-carousel-next aria-label="Следующие статьи">{{ ui.icon('arrow') }}</button>
  </div>
</div>
{%- endmacro %}
