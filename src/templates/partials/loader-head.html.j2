{# Inline so the loading screen needs no extra network request. Content remains usable without JavaScript. #}
<style>
  #site-content{display:contents}
  .site-loader{display:none;position:fixed;inset:0;z-index:10000;place-items:center;background:#f3f2ef;color:#141414;font:400 15px/1.5 Arial,sans-serif;touch-action:none;opacity:1;transition:opacity .16s ease}
  .site-loading .site-loader,.site-revealing .site-loader{display:grid}
  .site-revealing .site-loader{opacity:0;pointer-events:none}
  .site-loader__inner{text-align:center;padding:24px}
  .site-loader__paw{display:block;width:104px;height:104px;margin:0 auto 24px;color:#ff967c}
  .site-loader__fill{transform:scaleY(var(--loaded,.08));transform-origin:50% 100%;transition:transform .18s ease-out}
  .site-loader__label{margin:0;color:#6b6b6b}
  @media(prefers-reduced-motion:reduce){.site-loader,.site-loader__fill{transition:none}}
</style>
<script>
(() => {
  const root = document.documentElement;
  let ended = false, watching = false, resolveReady;
  window.__siteReady = new Promise(resolve => { resolveReady = resolve; });
  root.classList.add('site-loading');
  function progress(value) {
    const loader = document.getElementById('site-loader');
    if (loader) loader.style.setProperty('--loaded', String(value));
  }
  function finish() {
    if (ended) return;
    ended = true;
    clearTimeout(deadline);
    progress(1);
    const content = document.getElementById('site-content');
    if (content) content.inert = false;
    const loader = document.getElementById('site-loader');
    root.classList.remove('site-loading');
    root.classList.add('site-revealing');
    if (loader) loader.setAttribute('aria-hidden', 'true');
    setTimeout(() => root.classList.remove('site-revealing'), 180);
    resolveReady();
    window.dispatchEvent(new Event('site:ready'));
  }
  // This timer is independent of main.js, fonts, images and third-party services.
  const deadline = setTimeout(finish, 4000);
  window.addEventListener('pageshow', event => { if (event.persisted) finish(); });
  function watch() {
    if (ended || watching) return;
    watching = true;
    progress(.2);
    const ready = [];
    document.querySelectorAll('link[rel="stylesheet"],link[data-site-styles]').forEach(link => {
      if (!link.sheet) ready.push(new Promise(resolve => {
        link.addEventListener('load', resolve, {once:true});
        link.addEventListener('error', resolve, {once:true});
      }));
    });
    // Called by the parser before defer scripts execute. Decode ready hero media
    // in parallel with their download/initialization, but reveal only when controls work.
    if (document.readyState === 'loading') document.querySelectorAll('script[src][defer]').forEach(script => {
      ready.push(new Promise(resolve => {
        script.addEventListener('load', resolve, {once:true});
        script.addEventListener('error', resolve, {once:true});
      }));
    });
    // The first screen uses Geist 400/500, Latin and Cyrillic. Explicit loads avoid
    // document.fonts.ready forcing layout for the entire (mostly offscreen) page.
    if (document.fonts && document.fonts.load) ready.push(Promise.all([
      document.fonts.load('400 16px Geist', 'Щенки 0123'),
      document.fonts.load('500 16px Geist', 'Щенки 0123')
    ]));
    // Only eager hero media: lazy galleries and analytics never hold the page closed.
    document.querySelectorAll('main img[fetchpriority="high"],main img:not([loading])').forEach(img => {
      ready.push(new Promise(resolve => {
        const decoded = () => {
          if (img.decode && img.naturalWidth) img.decode().catch(() => {}).then(resolve);
          else resolve();
        };
        if (img.complete) decoded();
        else { img.addEventListener('load', decoded, {once:true}); img.addEventListener('error', resolve, {once:true}); }
      }));
    });
    let complete = 0;
    const settled = () => { if (!ended) progress(.2 + .8 * ++complete / ready.length); };
    ready.forEach(task => task.then(settled, settled));
    Promise.allSettled(ready).then(finish);
  }
  window.__watchSiteLoading = watch;
  document.addEventListener('DOMContentLoaded', watch, {once:true});
})();
</script>
