{#- Shared «Узнать цену» modal. Any [data-open-modal] opens it; inside a [data-pup] card it is prefilled with that puppy.
    data-modal-title / -sub / -breed / -note on the button set the title, subtitle, breed (no puppy) and the hidden note (main.js);
    data-modal-kind (LeadKind) and data-modal-colour (colour slug) go to the API with the request. main.js sets every hidden
    input on each open (form.reset() does not clear hidden inputs). Views: form · done · error (live mode, API unreachable). -#}
{% import "macros/ui.html.j2" as ui %}
{% import "macros/forms.html.j2" as forms %}
  <!-- Модалка «Узнать цену» -->
  <dialog class="modal" id="price-modal" aria-labelledby="pm-title" aria-describedby="pm-sub">
    <div class="modal__inner">
      <button class="msgr modal__close" type="button" aria-label="Закрыть" data-close-modal>{{ ui.icon('close') }}</button>
      <div class="modal__view" data-view="form">
        <div class="modal__head">
          <span class="modal__thumb" data-pm-thumb hidden><img src="{{ breeds[0].studio.src }}" alt="" width="1024" height="1024" decoding="async"></span>
          <div>
            <h2 class="modal__title" id="pm-title">Узнать цену щенка</h2>
            <p class="modal__sub" id="pm-sub">Пришлём щенков в&nbsp;наличии с&nbsp;ценами и&nbsp;видео</p>
          </div>
        </div>
        <form class="form" id="price-form" novalidate>
          <input type="hidden" name="kind" value="price">
          <input type="hidden" name="puppy" value="">
          <input type="hidden" name="puppy_name" value="">
          <input type="hidden" name="colour" value="">
          <input type="hidden" name="note" value="">
          <input type="hidden" name="form_title" value="">
          <div class="form__grid">
            <div class="field">
              <label class="field__label" for="pm-name">Имя</label>
              <input class="input" id="pm-name" name="name" type="text" autocomplete="given-name" placeholder="Как к&nbsp;вам обращаться" required aria-describedby="pm-name-err">
              <p class="field__err" id="pm-name-err" hidden></p>
            </div>
            <div class="field">
              <label class="field__label" for="pm-phone">Телефон</label>
              <input class="input" id="pm-phone" name="phone" type="tel" inputmode="tel" autocomplete="tel" placeholder="+7 (___) ___-__-__" required aria-describedby="pm-phone-err" data-phone>
              <p class="field__err" id="pm-phone-err" hidden></p>
            </div>
            <div class="field" data-pm-breed>
              <label class="field__label" for="pm-breed">Какая порода интересует</label>
              <select class="input select" id="pm-breed" name="breed">
                {{ forms.breed_options()|indent(16) }}
              </select>
            </div>
            {{ forms.contact_field('pm')|indent(12) }}
            {{ forms.honeypot('pm')|indent(12) }}
            {{ forms.consent_check('pm')|indent(12) }}
          </div>
          <button class="btn btn--ink btn--lg btn--block form__submit" type="submit" data-submit data-label="Узнать цену">Узнать цену</button>
          <p class="form__hint">Свяжемся с&nbsp;вами в&nbsp;течение рабочего дня{% if not hide_city | default(false) %} по&nbsp;московскому времени{% endif %}</p>
        </form>
      </div>
      <div class="modal__view modal__done" data-view="done" hidden>
        <span class="form-done__ico" aria-hidden="true">{{ ui.icon('check') }}</span>
        <h2 class="modal__title" id="pm-done-title" tabindex="-1">Спасибо</h2>
        <p class="modal__sub" id="pm-done-text"></p>
        <button class="btn btn--ink btn--lg btn--block" type="button" data-close-modal>Хорошо</button>
      </div>
      <div class="modal__view modal__done modal__fail" data-view="error" hidden>
        <span class="form-done__ico form-fail__ico" aria-hidden="true">{{ ui.icon('info') }}</span>
        <h2 class="modal__title" id="pm-error-title" tabindex="-1">Заявка пока не&nbsp;ушла</h2>
        <div class="form-fail" id="pm-error-text">
          {{ forms.send_fail()|indent(10) }}
        </div>
        <button class="btn btn--ink btn--lg btn--block" type="button" data-pm-back>Вернуться к&nbsp;заявке</button>
      </div>
    </div>
  </dialog>
