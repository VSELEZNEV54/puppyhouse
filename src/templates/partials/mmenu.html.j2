{#- Full-screen mobile menu (< 1100 px): every group of site.menu as an accordion, then contacts
    (the e-mail or the phone when site.phone_public, the messengers when site.contacts_ready, «Узнать цену» + «Оставить заявку»).
    The top bar (logo + close) never scrolls away: only .mmenu__scroll scrolls (client 15.10).
    main.js: [data-burger], #mmenu, .mmenu__acc (aria-controls → its list), [data-menu-close], [data-menu-link]. -#}
{% import "macros/ui.html.j2" as ui %}
{% import "partials/menu.html.j2" as menu %}
{% set is_home = page.url == '/' %}
  <!-- Мобильное меню -->
  <div class="mmenu" id="mmenu" role="dialog" aria-modal="true" aria-label="Меню сайта" hidden>
    <div class="mmenu__top">
      <a class="logo" href="{{ '#top' if is_home else '/' }}" data-menu-link aria-label="{{ site.brand }} — {{ 'наверх страницы' if is_home else 'на главную' }}">
        <span class="logo__mark" aria-hidden="true">{{ ui.icon('paw') }}</span>
        <span class="logo__text"><span class="logo__name">{{ site.brand }}</span><span class="logo__sub">{{ site.tagline_plain if hide_city | default(false) else site.tagline }}</span></span>
      </a>
      <button class="msgr msgr--ink" type="button" aria-label="Закрыть меню" data-menu-close>{{ ui.icon('close') }}</button>
    </div>
    <div class="mmenu__scroll">
    <nav class="mmenu__nav" aria-label="Мобильное меню">
      <ul class="mmenu__list">
        <li><a class="mmenu__link" href="/shchenki/" data-menu-link{% if page.url == '/shchenki/' %} aria-current="page"{% endif %}>Каталог щенков</a></li>
        {% for g in site.menu %}
        <li>
          <button class="mmenu__acc" type="button" aria-expanded="false" aria-controls="mm-g{{ loop.index }}">{{ g.title|typo }} {{ ui.icon('chevron') }}</button>
          <div class="mmenu__group" id="mm-g{{ loop.index }}" hidden>
            {{ menu.items(g, page.url)|indent(12) }}
          </div>
        </li>
        {% endfor %}
      </ul>
    </nav>
    <div class="mmenu__bottom">
      {% if site.phone_public %}
      <a class="mmenu__phone" href="{{ site.phone.tel }}">{{ site.phone.display }}<small>{{ site.phone.hours|typo }}</small></a>
      {% else %}
      <a class="mmenu__phone mmenu__mail" href="{{ site.email_href }}">{{ site.email }}<small>Почта питомника · {{ (site.phone.response_plain if hide_city | default(false) else site.phone.response)|typo }}</small></a>
      {% endif %}
      {% if site.contacts_ready %}
      <div class="mmenu__msgs">
        {% for k in ('telegram', 'whatsapp', 'max') if site.messengers[k].url %}{% set m = site.messengers[k] %}
        <a class="msgr msgr--{{ m.icon }}" href="{{ m.url }}" target="_blank" rel="noopener" aria-label="{{ m.aria }}" title="{{ m.label }}">{{ ui.icon(m.icon) }}</a>
        {% endfor %}
        <button class="btn btn--white mmenu__price" type="button" data-open-modal data-modal-kind="price">Узнать цену</button>
      </div>
      {% else %}
      <button class="btn btn--white btn--lg btn--block" type="button" data-open-modal data-modal-kind="price">Узнать цену</button>
      {% endif %}
      {{ ui.request_button(cls='btn btn--coral btn--lg btn--block', note='Мобильное меню') }}
    </div>
    </div>
  </div>
