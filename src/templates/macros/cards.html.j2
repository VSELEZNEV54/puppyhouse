{#- Cards: puppies, breeds, reviews. READ-ONLY for page-group agents.
    Import:  {% import "macros/cards.html.j2" as cards %} -#}
{% import "macros/ui.html.j2" as ui %}

{#- Puppy card — one card for the whole site (catalog, «Похожие щенки», every «Щенки в наличии» strip, hubs, comparisons).
    p = puppies.json item (enriched by build.py). Two CTAs (client 19.10): white «Узнать цену» → the shared modal
    prefilled with this puppy (main.js reads data-pup), «Подробнее» with a white outline → the puppy page. The photo links to the page too
    (a duplicate link, out of the tab order). No «В избранное» heart anywhere (client 21.10).
    Studio photo: the card takes that photo's measured backdrop (tools/photo-tones.json) unless the photo has
    "backdrop": "token". Lifestyle photo: object-fit cover, "pos" → object-position (default 50% 60%).
    Styles: main.css (.pup + .ct-card). Phones ≤ 560 px: a compact row — photo left, name and both buttons right.
    tag: heading tag of the name; eager=true: no lazy loading (cards on the first screen).
    simple=true (breed pages v2, client 15.10): photo, name, «мальчик · кремовый» and the same two buttons — no age,
    the photo and the name are not links.
    No status badge, dot or status text (client 19.10: the site shows no «забронирован» / «скоро»). -#}
{% macro puppy_card(p, tag='h3', eager=false, simple=false) -%}
{%- set t = photo_tone(p.photo.src) if p.photo.kind == 'studio' and p.photo.get('backdrop') != 'token' else none -%}
{%- set studio = p.photo.kind == 'studio' -%}
<article class="pup ct-card {{ p.tone_class }}{{ ' ct-card--studio' if studio else ' ct-card--life' }}{{ ' ct-card--simple' if simple }}"{% if t %} style="--tone:{{ t.top }};--tone-floor:{{ t.floor }}"{% endif %} data-pup data-slug="{{ p.slug }}" data-breed="{{ p.breed }}" data-name="{{ p.name }}" data-desc="{{ (p.breed_name ~ ' · ' ~ p.sex_label ~ ' · ' ~ p.colour) if simple else p.desc }}" data-img="{{ p.photo.src.rsplit('/', 1)[-1] }}">
  {% if simple %}<div class="pup__media ct-card__media{{ ' pup__media--studio' if studio }}">{% else %}<a class="pup__media ct-card__media{{ ' pup__media--studio' if studio }}" href="{{ p.url }}" tabindex="-1" aria-hidden="true">{% endif %}
    <img{% if p.photo['class'] %} class="{{ p.photo['class'] }}"{% endif %} src="{{ p.photo.src }}" alt="{{ p.photo.alt|typo }}" width="{{ p.photo.w }}" height="{{ p.photo.h }}"{% if p.photo.get('pos') %} style="object-position:{{ p.photo.pos }}"{% endif %}{% if not eager %} loading="lazy"{% endif %} decoding="async">
  {% if simple %}</div>{% else %}</a>{% endif %}
  <div class="pup__body ct-card__body">
    {% if simple %}
    <{{ tag }} class="pup__name">{{ p.name }}</{{ tag }}>
    <p class="pup__meta">{{ p.sex_label|capitalize }} · {{ p.colour }}</p>
    <div class="ct-card__actions">
      <button class="btn btn--white ct-card__price" type="button" data-open-modal data-modal-kind="puppy" aria-label="Узнать цену: {{ p.name }}">Узнать цену</button>
      <a class="btn btn--outline ct-card__more" href="{{ p.url }}" aria-label="Подробнее: {{ p.name }}">Подробнее</a>
    </div>
    {% else %}
    <{{ tag }} class="pup__name"><a href="{{ p.url }}">{{ p.name }}</a></{{ tag }}>
    <p class="pup__meta">{% for m in p.meta.split(' · ') %}<span>{{ m }}{% if not loop.last %}&nbsp;·{% endif %}</span>{{ ' ' if not loop.last }}{% endfor %}</p>
    <div class="ct-card__actions">
      <button class="btn btn--white ct-card__price" type="button" data-open-modal data-modal-kind="puppy" aria-label="Узнать цену: {{ p.name }}">Узнать цену</button>
      <a class="btn btn--outline ct-card__more" href="{{ p.url }}" aria-label="Подробнее: {{ p.name }}">Подробнее</a>
    </div>
    {% endif %}
  </div>
</article>
{%- endmacro %}

{#- «Щенки в наличии» as on the homepage (client 21.10): 8 cards — 4 / 2 per row; at three per row the first 6
    (main.css .hm-pups--8), so every row is full — and the catalog button under them. items: puppies
    (_lib.mixed_puppies on a page about all breeds). -#}
{% macro pups_grid(items, title='Щенки в наличии', id='pups', url='/shchenki/', label='Весь каталог') -%}
<section class="section container" id="{{ id }}" aria-labelledby="{{ id }}-title">
  {{ ui.section_head(title, id=id ~ '-title') }}
  <ul class="pups hm-pups hm-pups--8" data-reveal="items">
    {% for p in items %}
    <li class="pups__item">
      {{ puppy_card(p) }}
    </li>
    {% endfor %}
  </ul>
  <div class="hm-pups__foot">
    <a class="btn btn--ink btn--lg" href="{{ url }}"><span>{{ label|typo }}</span> {{ ui.icon('arrow') }}</a>
  </div>
</section>
{%- endmacro %}

{#- The standard «Щенки в наличии» block of every page (client 21.10: the same blocks on all pages) — pups_grid with
    8 cards. breed (breeds.json item): its puppies, «Щенки <породы> в наличии» and «Все щенки <породы>» → the breed
    page's #shchenki; none: two puppies of every breed (each row of four shows all four breeds, as
    _lib.mixed_puppies) and «Весь каталог». exclude: slugs not to repeat (the puppy of the page, the colour's puppies
    shown above); title: own heading (e.g. «Похожие щенки»). -#}
{% macro pups_std(breed=none, exclude=[], title=none, id='pups') -%}
{%- if breed -%}
{%- set items = (breed.puppies|rejectattr('slug', 'in', exclude)|sort(attribute='status_order')|list)[:8] -%}
{{ pups_grid(items, title=title or ui.nohyph('Щенки ' ~ breed.name_plural_gen ~ ' в наличии'), id=id, url=breed.urls.hub ~ '#shchenki', label=ui.nohyph('Все щенки ' ~ breed.name_plural_gen)) }}
{%- else -%}
{%- set per = [] -%}
{%- for b in breeds %}{% set _ = per.append(b.puppies|rejectattr('slug', 'in', exclude)|sort(attribute='status_order')|list) %}{% endfor -%}
{%- set items = [] -%}
{%- for i in range(2) %}{% for l in per %}{% if l|length > i %}{% set _ = items.append(l[i]) %}{% endif %}{% endfor %}{% endfor -%}
{{ pups_grid(items, title=title or 'Щенки в наличии', id=id) }}
{%- endif -%}
{%- endmacro %}

{#- «Ждёте другого щенка?» tile: fills the rest of a puppy row, opens the modal as a waiting-list request
    (its own title, line, submit label and success text; hidden note «Лист ожидания»). breed: breeds.json item → preselected. -#}
{% macro soon_tile(title='Ждёте другого щенка?', line='Напишем, когда появится новый помёт', label='Оставить заявку', breed=none) -%}
<div class="soon-tile">
  <span class="soon-tile__faces" aria-hidden="true">{% for b in breeds %}{{ ui.face(b) }}{% endfor %}</span>
  <span class="soon-tile__txt"><span class="soon-tile__title">{{ title|typo }}</span><span class="soon-tile__line">{{ line|typo }}</span></span>
  <button class="btn btn--ink" type="button" data-open-modal data-modal-kind="waitlist" data-modal-title="{{ title }}" data-modal-sub="{{ line }}" data-modal-note="Лист ожидания" data-modal-submit="Записаться" data-modal-done="Вы в листе ожидания. Куратор свяжется с вами, когда появится новый помёт."{% if breed %} data-modal-breed="{{ breed.name }}"{% endif %}>{{ label }}</button>
</div>
{%- endmacro %}

{#- Breed tile — the homepage pastel tile with the studio photo standing on the tile «floor». b = breeds.json item.
    CTA «Перейти к породе». count=true adds «В наличии: N» (the client removed it from the homepage tiles 13.10). -#}
{% macro breed_tile(b, count=false, cta='Перейти к породе') -%}
<a class="breed breed--{{ b.key }} {{ b.tone_class }}" href="{{ b.urls.hub }}">
  <span class="breed__top"><span class="breed__title">{{ b.name }}</span><span class="breed__desc">{{ b.tile_line|typo }}</span>{% if count %}<span class="breed__count"><span class="dot dot--ok" aria-hidden="true"></span>В&nbsp;наличии: {{ b.stock }}</span>{% endif %}</span>
  {{ ui.tile_cta(cta) }}
  <span class="breed__photo"><img src="{{ b.studio.src }}" alt="{{ b.studio.alt|typo }}" width="{{ b.studio.w }}" height="{{ b.studio.h }}" loading="lazy" decoding="async"></span>
</a>
{%- endmacro %}

{#- Grid of the four breed tiles (4 in a row on desktop, 2 on tablet, one per row on phones; .breeds--2 → 2 per row) -#}
{% macro breed_tiles(items=none, count=false, cols=4) -%}
<ul class="breeds{{ ' breeds--2' if cols == 2 }}">
  {% for b in items or breeds %}
  <li>
    {{ breed_tile(b, count=count) }}
  </li>
  {% endfor %}
</ul>
{%- endmacro %}

{#- Review card. r = reviews.json item. short=true uses r.short (≤180 chars, homepage style) when present. -#}
{% macro review_card(r, short=true) -%}
<li class="review">
  <blockquote class="review__text"><p>{{ (r.short if short and r.short else r.text)|typo }}</p></blockquote>
  <p class="review__who"><span class="ava" style="--c:var(--{{ r.color }})" aria-hidden="true">{{ r.name[0] }}</span><span><b>{{ r.name }}, {{ r.city }}</b><span>{{ breed_map[r.breed].name if short else r.breed_label }}</span></span></p>
</li>
{%- endmacro %}

{#- Rating tiles (Яндекс · Google · Авито) from site.ratings -#}
{% macro ratings(items=none) -%}
<ul class="ratings" aria-label="Рейтинг питомника">
  {% for r in items or site.ratings %}
  <li class="rating"><b class="rating__num">{{ r.num }}</b><span class="rating__txt"><span class="stars" aria-hidden="true">{% for _ in range(5) %}{{ ui.icon('star') }}{% endfor %}</span><span>{{ r.label }} · {{ r.count }}</span></span></li>
  {% endfor %}
</ul>
{%- endmacro %}
