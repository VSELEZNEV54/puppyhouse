{#- Basic UI pieces shared by every page. READ-ONLY for page-group agents.
    Import:  {% import "macros/ui.html.j2" as ui %}
    Every text parameter is plain text: macros escape it and run the |typo filter (non-breaking spaces).
    Pass Markup (e.g. "...<a href>..."|safe) only when you really need inline HTML. -#}

{#- <svg> icon from the sprite (partials/sprite.html.j2): ui.icon('arrow'), ui.icon('check', sm=true) -#}
{% macro icon(name, sm=false, cls='') -%}
<svg class="i{{ ' i--sm' if sm }}{{ ' ' ~ cls if cls }}" aria-hidden="true" focusable="false"><use href="#i-{{ name }}"/></svg>
{%- endmacro %}

{#- Round arrow badge. DECORATIVE ONLY — never the main action of a tile (client rule 13.10): use tile_cta(). -#}
{% macro round_arrow(variant='') -%}
<span class="round-arrow{{ ' round-arrow--' ~ variant if variant }}" aria-hidden="true">{{ icon('arrow-ur') }}</span>
{%- endmacro %}

{#- Clear CTA of a clickable tile or card: pill with a label and an arrow (client rule 13.10 — no arrow-only buttons).
    Inside a tile that is already a link it renders a <span> (the tile is the link); pass url to get a real <a>.
    label (one wording per context, site-wide): 'Подробнее' (default) · 'Перейти к породе' (breed tiles) · 'Смотреть щенка'
    (puppy) · 'Все окрасы' (colours) · 'Читать' (articles). variant: '' (white, on colour tiles) | 'soft' (grey, on white
    tiles) | 'ink' (black, on photos). -#}
{% macro tile_cta(label='Подробнее', variant='', url=none) -%}
{%- set cls = 'tcta' ~ (' tcta--' ~ variant if variant else '') -%}
{%- if url %}<a class="{{ cls }}" href="{{ url }}">{% else %}<span class="{{ cls }}">{% endif %}{{ label|typo }} {{ icon('arrow', sm=true) }}{% if url %}</a>{% else %}</span>{% endif -%}
{%- endmacro %}

{#- Coloured circle with an icon. color: coral | sun | sky | mint | lilac | sand (any CSS colour token name) -#}
{% macro ico(name, color='coral', sm=false) -%}
<span class="ico{{ ' ico--sm' if sm }}" style="--c:var(--{{ color }})" aria-hidden="true">{{ icon(name, sm=sm) }}</span>
{%- endmacro %}

{#- «Оставить заявку»: opens the shared modal (kind lead). Stands where «Написать в Telegram» was while
    site.contacts_ready is false (client 20.10). cls: 'btn btn--coral' (+ size); note: hidden note of the request. -#}
{% macro request_button(cls='btn btn--coral', note='Оставить заявку') -%}
<button class="{{ cls }}" type="button" data-open-modal data-modal-kind="lead" data-modal-title="Оставить заявку" data-modal-sub="Подберём щенка и&nbsp;пришлём фото, видео и&nbsp;цены" data-modal-note="{{ note }}" data-modal-submit="Оставить заявку">Оставить заявку</button>
{%- endmacro %}

{#- ПРАВИЛО (клиент 19.10, 21.10): ссылка на раздел или страницу — ВСЕГДА круглая коралловая кнопка, без подчёркивания
    и стрелки: ui.link_button('/faq/', 'Все вопросы'). Подчёркнутых ссылок-«стрелочек» на сайте нет. На телефоне кнопка
    из заголовка блока (ui.section_head, blocks.faq_section) уходит под весь блок во всю ширину (main.css). -#}
{% macro link_button(url, label, cls='') -%}
<a class="btn btn--coral{{ ' ' ~ cls if cls }}" href="{{ url }}">{{ label|typo }}</a>
{%- endmacro %}

{#- Underlined text link with an arrow — ТОЛЬКО ссылки на юридические документы (согласия, политика конфиденциальности)
    в «Другие документы» на их страницах (клиент 21.10: «это пускай так и будет»). Для разделов и страниц — ui.link_button. -#}
{% macro text_link(url, label) -%}
{%- set words = label.rsplit(' ', 1) -%}
<a class="text-link" href="{{ url }}">{% if words|length > 1 %}{{ (words[0] ~ ' ')|typo }}{% endif %}<span class="nw">{{ words[-1]|typo }} {{ icon('arrow', sm=true) }}</span></a>
{%- endmacro %}

{#- Image with width/height read from the file: ui.img('/assets/img/x.jpg', 'Описание').
    loading: 'lazy' | 'eager'; priority=true adds fetchpriority="high" (first screen only). -#}
{% macro img(src, alt, cls='', loading='lazy', priority=false, w=none, h=none) -%}
{%- set size = imgsize(src) or [w, h] -%}
<img{% if cls %} class="{{ cls }}"{% endif %} src="{{ src }}" alt="{{ alt|typo }}" width="{{ w or size[0] }}" height="{{ h or size[1] }}"{% if priority %} fetchpriority="high"{% elif loading == 'lazy' %} loading="lazy"{% endif %} decoding="async">
{%- endmacro %}

{#- Round studio face of a breed (breed = item of breeds.json). size via CSS on .face. eager=true: on the first screen -#}
{% macro face(b, alt='', eager=false) -%}
<span class="face {{ b.tone_class }}"><img src="{{ b.studio.src }}" alt="{{ alt }}" width="{{ b.studio.w }}" height="{{ b.studio.h }}"{% if not eager %} loading="lazy"{% endif %} decoding="async"></span>
{%- endmacro %}

{#- Breadcrumbs. items: [["Главная", "/"], ["Щенки", "/shchenki/"], ["Пломбир", none]] — last item is the current page -#}
{% macro breadcrumbs(items) -%}
<nav class="crumbs container" aria-label="Хлебные крошки">
  <ol class="crumbs__list">
    {% for label, url in items %}
    <li class="crumbs__item">{% if url and not loop.last %}<a href="{{ url }}">{{ label|typo }}</a>{% else %}<span aria-current="page">{{ label|typo }}</span>{% endif %}</li>
    {% endfor %}
  </ol>
</nav>
{%- endmacro %}

{#- Section head: H2 (+ optional one-line lead) on the left, optional link on the right, caller() for extra buttons.
    ui.section_head('Щенки в наличии', id='pups-title', link={'url': '/shchenki/', 'label': 'Весь каталог'}) -#}
{#- link → a coral pill button (ui.link_button) on every page; `button` is kept for old calls and changes nothing. -#}
{% macro section_head(title, id=none, link=none, lead=none, button=false) -%}
<div class="sec-head">
  {% if lead %}
  <div class="sec-head__txt">
    <h2 class="h2"{% if id %} id="{{ id }}"{% endif %}>{{ title|typo }}</h2>
    <p class="sec-head__lead">{{ lead|typo }}</p>
  </div>
  {% else %}
  <h2 class="h2"{% if id %} id="{{ id }}"{% endif %}>{{ title|typo }}</h2>
  {% endif %}
  {% if link %}{{ link_button(link.url, link.label) }}{% endif %}{{ caller() if caller is defined else '' }}
</div>
{%- endmacro %}

{#- Page hero: pastel tile with H1 and one-line lead. Put first in {% block hero %}.
    tone:   cream | peach | powder | butter | sage (studio tones) | sun | sky | mint | lilac | coral | sand (tints)
    breed:  a breeds.json item → tone and studio photo of that breed, blended into the tile
    photo:  {"src","w","h","alt"} of a studio photo (only studio-*.jpg blend cleanly)
    faces:  true → four breed faces on the right (general pages)
    facts:  [{"label": "Вес", "value": "2–5 кг"}] → small fact tiles under the lead
    chips:  [{"icon": "doc", "label": "Договор"}] → small pills under the lead
    eyebrow: short label above H1.  caller() → buttons row.  note: one muted line under the buttons
    («Подберём щенка за 1 час — пришлём видео и цену»).
    full=true: first screen on the whole screen (100svh minus the header, min 560 px), copy centred vertically,
    on phones the photo grows to fill the screen. Desktop ≥ 1200 px: the studio photo is larger than before (client 13.10).
    cls: extra class of the section (phero--colour: the colour page, a taller tile with the close-up photo, breeds.css).
    Buttons: btn--white (main, white) + btn--outline (white outline, no fill) on breed pages; btn--ink elsewhere.
    Exactly one H1 per page: this macro renders it. -#}
{% macro page_hero(title, lead=none, tone=none, breed=none, photo=none, faces=false, facts=none, chips=none, eyebrow=none, id='page-title', full=false, note=none, cls=none) -%}
{%- set tone = tone or (breed.tone if breed else 'cream') -%}
{%- set photo = photo or (breed.studio if breed else none) -%}
<section class="phero container{{ ' phero--full' if full }}{{ ' ' ~ cls if cls }}" aria-labelledby="{{ id }}">
  <div class="phero__tile tone--{{ tone }}{{ ' phero--photo' if photo }}{{ ' phero--faces' if faces and not photo }}"{% if photo and tone_style(photo.src) %} style="{{ tone_style(photo.src) }}"{% endif %} data-hero-ctas>
    {% if photo %}
    <div class="phero__photo"><img src="{{ photo.src }}" alt="{{ photo.alt|typo }}" width="{{ photo.w }}" height="{{ photo.h }}" fetchpriority="high" decoding="async"></div>
    {% elif faces %}
    <div class="phero__faces" aria-hidden="true">{% for b in breeds %}<span class="face {{ b.tone_class }}"><img src="{{ b.studio.src }}" alt="" width="{{ b.studio.w }}" height="{{ b.studio.h }}" decoding="async"></span>{% endfor %}</div>
    {% endif %}
    <div class="phero__copy">
      {% if eyebrow %}<p class="eyebrow"><span class="eyebrow__dot" aria-hidden="true"></span>{{ eyebrow|typo }}</p>{% endif %}
      <h1 class="phero__title" id="{{ id }}">{{ title|typo }}</h1>
      {% if lead %}<p class="phero__lead">{{ lead|typo }}</p>{% endif %}
      {% if facts %}
      <dl class="phero__facts">
        {% for f in facts %}<div class="phero__fact"><dt>{{ f.label|typo }}</dt><dd>{{ f.value|typo }}</dd></div>{% endfor %}
      </dl>
      {% endif %}
      {% if chips %}
      <ul class="phero__chips">
        {% for c in chips %}<li>{% if c.icon %}{{ icon(c.icon, sm=true) }}{% endif %}{{ c.label|typo }}</li>{% endfor %}
      </ul>
      {% endif %}
      {% if caller is defined %}<div class="phero__actions">{{ caller() }}</div>{% endif %}
      {% if note %}<p class="phero__note">{{ note|typo }}</p>{% endif %}
    </div>
  </div>
</section>
{%- endmacro %}

{#- Studio photo tile — the homepage breed-tile technique for ANY measured studio photo (color-*, parent-*, studio-*):
    the tile takes the photo's own measured backdrop (tools/photo-tones.json), the photo stands on the tile floor
    full width, only its top edge fades. photo: {"src", "alt"} (+ optional "w", "h").
    tone: fallback tone class if the photo is not measured. url → the tile is a link with a CTA pill (cta = its label).
    badge: small pill. priority=true: first-screen tile — the photo loads at once with fetchpriority="high" (not lazy).
    Phones: one wide tile per row (photo on the right); in .stiles--pair two small 3:4 tiles per row. -#}
{% macro studio_tile(photo, title, line=none, url=none, badge=none, tone='cream', priority=false, cta='Подробнее') -%}
{%- set size = imgsize(photo.src) or [photo.w, photo.h] -%}
{%- set tag = 'a' if url else 'div' -%}
<{{ tag }} class="stile tone--{{ tone }}"{% if url %} href="{{ url }}"{% endif %} style="--ar:{{ size[0] }}/{{ size[1] }};{{ tone_style(photo.src) }}">
  <span class="stile__top">
    <span class="stile__title">{{ title|typo }}</span>
    {% if line %}<span class="stile__line">{{ line|typo }}</span>{% endif %}
    {% if badge %}<span class="stile__badge">{{ badge|typo }}</span>{% endif %}
  </span>
  {% if url %}{{ tile_cta(cta) }}{% endif %}
  <span class="stile__photo"><img src="{{ photo.src }}" alt="{{ photo.alt|typo }}" width="{{ size[0] }}" height="{{ size[1] }}"{% if priority %} fetchpriority="high"{% else %} loading="lazy"{% endif %} decoding="async"></span>
</{{ tag }}>
{%- endmacro %}

{#- Row of studio tiles (4 per row on desktop, 2 on tablet, one wide tile per row on phones; pair=true → two small per row).
    items: [{"photo": {...}, "title": "...", "line": "...", "url": "...", "badge": "...", "tone": "peach", "cta": "Все окрасы"}] -#}
{% macro studio_tiles(items, pair=false) -%}
<ul class="stiles stiles--{{ items|length if items|length < 4 else 4 }}{{ ' stiles--pair' if pair }}">
  {% for t in items %}
  <li>{{ studio_tile(t.photo, t.title, line=t.line if t.line is defined else none, url=t.url if t.url is defined else none, badge=t.badge if t.badge is defined else none, tone=t.tone if t.tone is defined else 'cream', cta=t.cta if t.cta is defined else 'Подробнее') }}</li>
  {% endfor %}
</ul>
{%- endmacro %}

{#- Grid of white fact tiles. items: [{"label": "Вес", "value": "2–5 кг", "icon": "ruler", "color": "sun"}] (icon/color optional).
    cols: max columns on desktop (2–4). tone: optional pastel tone class for the whole grid background. -#}
{% macro spec_grid(items, cols=4) -%}
<dl class="specs specs--{{ cols }}">
  {% for f in items %}
  <div class="spec">
    {% if f.icon is defined and f.icon %}{{ ico(f.icon, f.color if f.color is defined else 'sun', sm=true) }}{% endif %}
    <dt class="spec__label">{{ f.label|typo }}</dt>
    <dd class="spec__value">{{ f.value|typo }}</dd>
  </div>
  {% endfor %}
</dl>
{%- endmacro %}

{#- Stat tiles (big number + caption + coloured icon), same look as the homepage trust numbers.
    items: [{"num": "9 лет", "cap": "растим щенков", "icon": "calendar", "color": "coral"}] — site.stats has the defaults -#}
{% macro stat_tiles(items, label='Питомник в цифрах') -%}
<ul class="kpis kpis--{{ items|length }}" aria-label="{{ label }}">
  {% for s in items %}
  <li class="stat">{{ ico(s.icon, s.color) }}<b class="stat__num">{{ s.num|typo }}</b><span class="stat__cap">{{ s.cap|typo }}</span></li>
  {% endfor %}
</ul>
{%- endmacro %}

{#- Advantages of the kennel: tiles with a pastel icon circle, a 2–3 word title and one line.
    items: [{"icon", "color", "title", "line"}] — default site.advantages (привиты, ветпаспорт и договор, пожизненная
    гарантия, пожизненная консультация, видео до покупки, доставка). 3 per row on desktop (cols=2..6), one per row on phones.
    title → a whole section with H2 (id, lead, link); without title — just the list. -#}
{% macro advantages(items=none, title=none, id='preimushchestva', lead=none, link=none, cols=3, tight=false, button=false) -%}
{%- set items = items or site.advantages -%}
{%- set body -%}
<ul class="advs advs--{{ cols }}">
  {% for a in items %}
  <li class="adv">
    {{ ico(a.icon, a.color) }}
    <h3 class="adv__title">{{ a.title|typo }}</h3>
    <p class="adv__line">{{ a.line|typo }}</p>
  </li>
  {% endfor %}
</ul>
{%- endset -%}
{% if title %}
<section class="section{{ ' section--tight' if tight }} container" id="{{ id }}" aria-labelledby="{{ id }}-title">
  {{ section_head(title, id=id ~ '-title', link=link, lead=lead, button=button) }}
  {{ body }}
</section>
{% else %}
{{ body }}
{% endif %}
{%- endmacro %}

{#- Lead band: sits right under a media carousel (or anywhere) — short question, one line, «Оставить заявку»
    (opens the price modal with its own title / note) + «Написать в Telegram» (only when site.contacts_ready). Faces of the four breeds on the right;
    faces=[{"src", "tone"}] → round faces of these studio photos instead (a breed page: its colours), faces=false → none.
    tag: 'h3' inside a section that already has its H2 (default), 'h2' + title_id when it is the section itself.
    kind: LeadKind sent to the API (video_call by default; waitlist for «по записи»); colour: colour slug; breed: slug to preselect. -#}
{% macro lead_band(title='Хотите увидеть щенков вживую по видео?', line='Покажем щенков по видеосвязи и пришлём цену — в удобное вам время', label='Оставить заявку', tone='lilac', tag='h3', title_id=none, faces=true, note='Видеозвонок', modal_title='Покажем щенков по видео', submit='Записаться на видеозвонок', done='Куратор напишет, чтобы договориться о видеозвонке.', kind='video_call', colour=none, breed=none) -%}
<div class="lband tone--{{ tone }}">
  <div class="lband__txt">
    <{{ tag }} class="lband__title"{% if title_id %} id="{{ title_id }}"{% endif %}>{{ title|typo }}</{{ tag }}>
    {% if line %}<p class="lband__line">{{ line|typo }}</p>{% endif %}
  </div>
  {% if faces is sameas true %}<span class="lband__faces" aria-hidden="true">{% for b in breeds %}{{ face(b) }}{% endfor %}</span>
  {% elif faces %}<span class="lband__faces" aria-hidden="true">{% for f in faces %}<span class="face tone--{{ f.tone }}"><img src="{{ f.src }}" alt="" width="{{ imgsize(f.src)[0] }}" height="{{ imgsize(f.src)[1] }}" loading="lazy" decoding="async"></span>{% endfor %}</span>{% endif %}
  <div class="lband__actions">
    <button class="btn btn--ink btn--lg" type="button" data-open-modal data-modal-kind="{{ kind }}"{% if colour %} data-modal-colour="{{ colour }}"{% endif %}{% if breed %} data-modal-breed="{{ breed }}"{% endif %} data-modal-title="{{ modal_title }}" data-modal-sub="{{ line }}" data-modal-note="{{ note }}"{% if submit %} data-modal-submit="{{ submit }}"{% endif %}{% if done %} data-modal-done="{{ done }}"{% endif %}>{{ label|typo }}</button>
    {% if site.contacts_ready %}<a class="btn btn--tg btn--lg" href="{{ site.messengers.telegram.url }}" target="_blank" rel="noopener">{{ icon('tg') }}{{ site.tg_cta.label }}</a>{% endif %}
  </div>
</div>
{%- endmacro %}

{#- Numbered steps in white tiles (homepage «Как купить»). items: [{"title": "Заявка", "text": "..."}]
    4 steps fill a row; for 3 or 5 steps pass cols=3 / cols=5 (pages.css). -#}
{% macro steps(items, cols=none, colors=('coral', 'sun', 'sky', 'mint', 'lilac', 'sand')) -%}
<ol class="steps{{ ' steps--' ~ cols if cols }}">
  {% for s in items %}
  <li class="step"><span class="step__num" style="--c:var(--{{ colors[loop.index0 % colors|length] }})" aria-hidden="true">{{ loop.index }}</span><h3 class="step__title">{{ s.title|typo }}</h3><p class="step__text">{{ s.text|typo }}</p></li>
  {% endfor %}
</ol>
{%- endmacro %}

{#- Vertical timeline. items: [{"when": "День 1", "title": "...", "text": "..."}] ("when" optional) -#}
{% macro timeline(items, colors=('coral', 'sun', 'sky', 'mint', 'lilac', 'sand')) -%}
<ol class="tline">
  {% for s in items %}
  <li class="tline__item">
    <span class="tline__dot" style="--c:var(--{{ colors[loop.index0 % colors|length] }})" aria-hidden="true">{{ loop.index }}</span>
    <div class="tline__body">
      {% if s.when is defined and s.when %}<p class="tline__when">{{ s.when|typo }}</p>{% endif %}
      <h3 class="tline__title">{{ s.title|typo }}</h3>
      {% if s.text is defined and s.text %}<p class="tline__text">{{ s.text|typo }}</p>{% endif %}
    </div>
  </li>
  {% endfor %}
</ol>
{%- endmacro %}

{#- Related links tiles. items: [{"url": "/dostavka/", "title": "Доставка", "line": "По Москве и в 60+ городов",
    "icon": "car", "color": "mint"}] — or "breed": breeds.json item (shows its face), or "image": "/assets/img/x.jpg".
    style: 'white' (white tiles, coloured icon) | 'color' (whole tile in its colour, like homepage «С чем поможем»).
    Every tile ends with a CTA pill: t.cta or «Подробнее». -#}
{% macro link_tiles(items, style='white') -%}
<ul class="ltiles ltiles--{{ items|length if items|length <= 4 else 4 }}">
  {% for t in items %}
  <li>
    <a class="ltile ltile--{{ style }}" href="{{ t.url }}"{% if style == 'color' %} style="--bg:var(--{{ t.color if t.color is defined else 'sand' }})"{% endif %}>
      {% if t.breed is defined and t.breed %}{{ face(t.breed) }}
      {% elif t.image is defined and t.image %}<span class="ltile__img">{{ img(t.image, '') }}</span>
      {% elif t.icon is defined and t.icon %}{{ ico(t.icon, t.color if t.color is defined else 'sun') }}{% endif %}
      <span class="ltile__txt"><span class="ltile__title">{{ t.title|typo }}</span>{% if t.line is defined and t.line %}<span class="ltile__line">{{ t.line|typo }}</span>{% endif %}</span>
      {{ tile_cta(t.cta if t.cta is defined and t.cta else 'Подробнее', variant='soft' if style == 'white' else '') }}
    </a>
  </li>
  {% endfor %}
</ul>
{%- endmacro %}

{#- CTA band: pastel tile with a short title, one line and a button. button: 'modal' (opens «Узнать цену»)
    or {"url": "/shchenki/", "label": "Смотреть щенков"}. faces=true shows the four breed faces.
    title_id: id of the H2, for the wrapping section's aria-labelledby:
      <section class="section container" id="x" aria-labelledby="x-title">{{ ui.cta_band('…', title_id='x-title') }}</section>
    kind: LeadKind of the modal request sent to the API (price by default). -#}
{% macro cta_band(title, line=none, button='modal', label='Узнать цену', tone='lilac', faces=true, id=none, title_id=none, kind='price') -%}
<div class="cta-band tone--{{ tone }}"{% if id %} id="{{ id }}"{% endif %}>
  <div class="cta-band__txt">
    <h2 class="cta-band__title"{% if title_id %} id="{{ title_id }}"{% endif %}>{{ title|typo }}</h2>
    {% if line %}<p class="cta-band__line">{{ line|typo }}</p>{% endif %}
  </div>
  {% if faces %}<span class="cta-band__faces" aria-hidden="true">{% for b in breeds %}{{ face(b) }}{% endfor %}</span>{% endif %}
  <div class="cta-band__actions">
    {% if button == 'modal' %}<button class="btn btn--ink btn--lg" type="button" data-open-modal data-modal-kind="{{ kind }}">{{ label|typo }}</button>
    {% else %}<a class="btn btn--ink btn--lg" href="{{ button.url }}">{{ button.label|typo }} {{ icon('arrow') }}</a>{% endif %}
    {% if caller is defined %}{{ caller() }}{% endif %}
  </div>
</div>
{%- endmacro %}

{#- Key facts box for articles and hubs. items: [{"label": "Вес", "value": "2–5 кг"}] -#}
{% macro keyfacts(items, title='Коротко') -%}
<aside class="keyfacts" aria-label="{{ title }}">
  <p class="keyfacts__title">{{ ico('sparkle', 'sun', sm=true) }}{{ title|typo }}</p>
  <dl class="keyfacts__list">
    {% for f in items %}<div><dt>{{ f.label|typo }}</dt><dd>{{ f.value|typo }}</dd></div>{% endfor %}
  </dl>
</aside>
{%- endmacro %}

{#- Callout inside prose: {% call ui.callout('info', 'Важно') %}<p>Текст</p>{% endcall %}
    kind: info (sky) | warn (sun) | ok (mint) | love (coral) -#}
{% macro callout(kind='info', title=none) -%}
{%- set map = {'info': ('info', 'sky'), 'warn': ('alert', 'sun'), 'ok': ('check', 'mint'), 'love': ('heart', 'coral')} -%}
<div class="callout callout--{{ kind }}">
  {{ ico(map[kind][0], map[kind][1], sm=true) }}
  <div class="callout__body">
    {% if title %}<p class="callout__title">{{ title|typo }}</p>{% endif %}
    {{ caller() }}
  </div>
</div>
{%- endmacro %}

{#- Table of contents for long articles. items: [["kharakter", "Характер"], ["ukhod", "Уход"]] (anchor id, label) -#}
{% macro toc(items, title='Содержание') -%}
<nav class="toc" aria-label="{{ title }}">
  <p class="toc__title">{{ title }}</p>
  <ol class="toc__list">
    {% for anchor, label in items %}<li><a href="#{{ anchor }}">{{ label|typo }}</a></li>{% endfor %}
  </ol>
</nav>
{%- endmacro %}

{#- Photo gallery. photos: [{"src": "/assets/img/x.jpg", "alt": "...", "caption": "..."}] (caption optional).
    The first photo is large; on phones a grid (first photo full width, the rest two per row). For a swipeable
    row of photos and videos use media.media_carousel. -#}
{% macro gallery(photos, label='Фото') -%}
<ul class="gallery gallery--{{ photos|length if photos|length <= 5 else 5 }}" aria-label="{{ label }}">
  {% for p in photos %}
  <li class="gallery__item">
    <figure>
      {{ img(p.src, p.alt) }}
      {% if p.caption is defined and p.caption %}<figcaption>{{ p.caption|typo }}</figcaption>{% endif %}
    </figure>
  </li>
  {% endfor %}
</ul>
{%- endmacro %}

{#- Text with every hyphenated word kept on one line («Бордер-колли», «Той-пудель»): it may still wrap between words.
    Markup that already has tags is printed as is. -#}
{% macro nohyph(text) -%}
{%- set t = text|typo -%}
{%- if '<' in t -%}{{ t }}{%- else -%}
{%- for w in t.split(' ') -%}{{ ' ' if not loop.first }}{% if '-' in w %}<span class="nw">{{ w }}</span>{% else %}{{ w }}{% endif %}{%- endfor -%}
{%- endif -%}
{%- endmacro %}

{#- Comparison table. cols: ["Мальтипу", "Той-пудель"] or breeds.json items (shows faces);
    rows: [["Вес", "2–5 кг", "2–4 кг"], ...]. Scrolls sideways inside its tile on narrow screens, first column sticky
    (client 21.10: a horizontal table on phones too, no stacked cards); 3+ columns: «Листайте таблицу вбок» on phones.
    Column names never break at a hyphen. -#}
{% macro cmp_table(cols, rows, caption=none, eager=false) -%}
{% if cols|length > 2 %}<p class="cmp-hint">Листайте таблицу вбок {{ icon('arrow', sm=true) }}</p>{% endif %}
<div class="cmp{{ ' cmp--wide' if cols|length > 2 }}" role="region" aria-label="{{ caption or 'Сравнение' }}" tabindex="0">
  <table class="cmp__table">
    {% if caption %}<caption class="sr-only">{{ caption }}</caption>{% endif %}
    <thead>
      <tr>
        <td></td>
        {% for c in cols %}
        <th scope="col">{% if c is mapping %}<span class="cmp__head">{{ face(c, eager=eager) }}<span>{{ nohyph(c.name) }}</span></span>{% else %}{{ nohyph(c) }}{% endif %}</th>
        {% endfor %}
      </tr>
    </thead>
    <tbody>
      {% for r in rows %}
      <tr>
        <th scope="row">{{ r[0]|typo }}</th>
        {% for v in r[1:] %}<td>{{ v|typo }}</td>{% endfor %}
      </tr>
      {% endfor %}
    </tbody>
  </table>
</div>
{%- endmacro %}

{#- Small pills with a check icon (documents, badges). items: ["Метрика РКФ", "Чип"] -#}
{% macro badges(items) -%}
<ul class="badges">
  {% for b in items %}<li>{{ icon('check', sm=true) }}{{ b|typo }}</li>{% endfor %}
</ul>
{%- endmacro %}

{#- Empty state tile. caller() → extra buttons. kind: LeadKind of the modal request (waitlist: «напишем, когда появится помёт»). -#}
{% macro empty_state(title, text=none, button='modal', label='Оставить заявку', attrs='', kind='waitlist') -%}
<div class="empty" {{ attrs|safe }}>
  <span class="empty__faces" aria-hidden="true">{% for b in breeds %}{{ face(b) }}{% endfor %}</span>
  <p class="empty__title">{{ title|typo }}</p>
  {% if text %}<p class="empty__text">{{ text|typo }}</p>{% endif %}
  <div class="empty__actions">
    {% if button == 'modal' %}<button class="btn btn--ink" type="button" data-open-modal data-modal-kind="{{ kind }}">{{ label }}</button>
    {% elif button %}<a class="btn btn--ink" href="{{ button.url }}">{{ button.label|typo }}</a>{% endif %}
    {% if caller is defined %}{{ caller() }}{% endif %}
  </div>
</div>
{%- endmacro %}
