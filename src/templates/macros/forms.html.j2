{#- Lead form and price buttons. READ-ONLY for page-group agents.
    Import:  {% import "macros/forms.html.j2" as forms %}
    main.js validates and «sends» #lead-form (one per page) and the shared price modal. -#}
{% import "macros/ui.html.j2" as ui %}

{#- Messenger round button: kind = telegram | whatsapp | max -#}
{% macro msgr(kind) -%}
{%- set m = site.messengers[kind] -%}
<a class="msgr msgr--{{ m.icon }}" href="{{ m.url }}" target="_blank" rel="noopener" aria-label="{{ m.aria }}">{{ ui.icon(m.icon) }}</a>
{%- endmacro %}

{#- Breed <select> options. selected: breed slug to preselect (breed pages) -#}
{% macro breed_options(selected=none) -%}
<option value=""{% if not selected %} selected{% endif %}>Выберите породу</option>
{% for b in breeds %}
<option{% if selected == b.slug %} selected{% endif %}>{{ b.name }}</option>
{% endfor %}
<option>Пока не&nbsp;решил(а)</option>
{%- endmacro %}

{#- Button that opens the price modal without a puppy (generic request). breed: breed name to preselect («Мальтипу»). -#}
{% macro price_button(label='Узнать цену', cls='btn btn--ink', breed=none) -%}
<button class="{{ cls }}" type="button" data-open-modal{% if breed %} data-modal-breed="{{ breed }}"{% endif %}>{{ label }}</button>
{%- endmacro %}

{#- «Куда написать»: Telegram / WhatsApp / MAX / Звонок (radio chips). prefix: 'lf' (lead form) | 'pm' (price modal).
    main.js reads the value: telegram | whatsapp | max | call. -#}
{% macro contact_field(prefix) -%}
<fieldset class="field seg" role="radiogroup" aria-describedby="{{ prefix }}-contact-err">
  <legend class="field__label">Куда написать</legend>
  <div class="seg__opts">
    <input type="radio" name="contact" id="{{ prefix }}-c-tg" value="telegram"><label for="{{ prefix }}-c-tg">{{ ui.icon('tg', sm=true) }}Telegram</label>
    <input type="radio" name="contact" id="{{ prefix }}-c-wa" value="whatsapp"><label for="{{ prefix }}-c-wa">{{ ui.icon('wa', sm=true) }}WhatsApp</label>
    <input type="radio" name="contact" id="{{ prefix }}-c-max" value="max"><label for="{{ prefix }}-c-max">{{ ui.icon('max', sm=true) }}MAX</label>
    <input type="radio" name="contact" id="{{ prefix }}-c-call" value="call"><label for="{{ prefix }}-c-call">{{ ui.icon('phone', sm=true) }}Звонок</label>
  </div>
  <p class="field__err" id="{{ prefix }}-contact-err" hidden></p>
</fieldset>
{%- endmacro %}

{#- Final lead form section (homepage «Заявка»). One per page — keep id="zayavka": the mobile sticky bar hides over it.
    The form is ONE column at every width: each field on its own row (client rule 13.10).
    title ≤ 5 words, line ≤ 90 chars. tone: studio/tint tone of the tile. breed: slug to preselect in the select. -#}
{% macro lead_form(title='Подберём щенка за 15 минут', line='Пришлём щенков в наличии, цены и свежие видео', tone='peach', breed=none, id='zayavka') -%}
<section class="section container" id="{{ id }}" aria-labelledby="lead-title">
  <div class="lead tone--{{ tone }}">
    <div class="lead__intro">
      <h2 class="h2" id="lead-title">{{ title|typo }}</h2>
      <p class="lead__line">{{ line|typo }}</p>
      <div class="lead__contacts">
        <a class="lead__phone" href="{{ site.phone.tel }}">{{ site.phone.display }}</a>
        {{ msgr('telegram') }}
        {{ msgr('whatsapp') }}
        {{ msgr('max') }}
      </div>
    </div>

    <div class="lead__box">
      <form class="form" id="lead-form" novalidate>
        <div class="form__grid">
          <div class="field">
            <label class="field__label" for="lf-name">Имя</label>
            <input class="input" id="lf-name" name="name" type="text" autocomplete="given-name" placeholder="Как к&nbsp;вам обращаться" required aria-describedby="lf-name-err">
            <p class="field__err" id="lf-name-err" hidden></p>
          </div>
          <div class="field">
            <label class="field__label" for="lf-phone">Телефон</label>
            <input class="input" id="lf-phone" name="phone" type="tel" inputmode="tel" autocomplete="tel" placeholder="+7 (___) ___-__-__" required aria-describedby="lf-phone-err" data-phone>
            <p class="field__err" id="lf-phone-err" hidden></p>
          </div>
          <div class="field">
            <label class="field__label" for="lf-breed">Какая порода интересует</label>
            <select class="input select" id="lf-breed" name="breed">
              {{ breed_options(breed)|indent(14) }}
            </select>
          </div>
          {{ contact_field('lf')|indent(10) }}
          <div class="field">
            <div class="check">
              <input type="checkbox" id="lf-consent" name="consent" aria-describedby="lf-consent-err">
              <label for="lf-consent">Соглашаюсь на&nbsp;обработку персональных данных и&nbsp;принимаю <a href="{{ site.footer.legal.privacy.url }}" target="_blank" rel="noopener">политику конфиденциальности</a></label>
            </div>
            <p class="field__err" id="lf-consent-err" hidden></p>
          </div>
        </div>
        <button class="btn btn--ink btn--lg btn--block form__submit" type="submit" data-submit data-label="Получить подборку">Получить подборку</button>
      </form>
      <div class="form-done" data-done tabindex="-1" hidden>
        <span class="form-done__ico" aria-hidden="true">{{ ui.icon('check') }}</span>
        <p class="form-done__title" data-done-text>Спасибо! Напишем в&nbsp;течение 15&nbsp;минут</p>
      </div>
    </div>
  </div>
</section>
{%- endmacro %}
