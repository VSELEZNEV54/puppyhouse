{#- Lead form and price buttons. READ-ONLY for page-group agents.
    Import:  {% import "macros/forms.html.j2" as forms %}
    main.js validates and sends #lead-form (one per page) and the shared price modal: POST {api}/leads in live mode
    (meta dsh-api, base.html.j2), the old fake send in prototype mode. -#}
{% import "macros/ui.html.j2" as ui %}

{#- Messenger round button: kind = telegram | whatsapp | max -#}
{% macro msgr(kind) -%}
{%- set m = site.messengers[kind] -%}
<a class="msgr msgr--{{ m.icon }}" href="{{ m.url }}" target="_blank" rel="noopener" aria-label="{{ m.aria }}" title="{{ m.label }}">{{ ui.icon(m.icon) }}</a>
{%- endmacro %}

{#- Breed <select> options. selected: breed slug to preselect (breed pages).
    Values go to the API as they are: a breed slug, "undecided" (Пока не решил(а)) or "" (nothing chosen). -#}
{% macro breed_options(selected=none) -%}
<option value=""{% if not selected %} selected{% endif %}>Выберите породу</option>
{% for b in breeds %}
<option value="{{ b.slug }}"{% if selected == b.slug %} selected{% endif %}>{{ b.name }}</option>
{% endfor %}
<option value="undecided">Пока не&nbsp;решил(а)</option>
{%- endmacro %}

{#- Button that opens the price modal without a puppy (generic request). breed: breed name or slug to preselect.
    kind: the request type sent to the API (LeadKind: price | consult | help | colour | waitlist | video_call | …). -#}
{% macro price_button(label='Узнать цену', cls='btn btn--ink', breed=none, kind='price') -%}
<button class="{{ cls }}" type="button" data-open-modal data-modal-kind="{{ kind }}"{% if breed %} data-modal-breed="{{ breed }}"{% endif %}>{{ label }}</button>
{%- endmacro %}

{#- Consent checkbox (152-ФЗ: consent is a separate document since 01.09.2025). kind: 'processing' | 'distribution' —
    the current version in data/consent.json gives the text and the page it links to. name: input name (consent |
    consent_publish), the error element is #<prefix>-<name>-err. privacy=true: «Политика конфиденциальности» on the next line. -#}
{% macro consent_check(prefix, kind='processing', name='consent', privacy=true) -%}
{%- set doc = data.consent.versions|selectattr('version', 'equalto', data.consent.current[kind])|first -%}
{%- set id = prefix ~ '-' ~ name|replace('_', '-') -%}
{%- set term = doc.title|lower -%}
{%- set parts = doc.checkbox.split(term, 1) if term in doc.checkbox else none -%}
<div class="field">
  <div class="check">
    <input type="checkbox" id="{{ id }}" name="{{ name }}" aria-describedby="{{ prefix }}-{{ name }}-err">
    <label for="{{ id }}">{% if parts %}{{ parts[0]|typo }}<a href="{{ doc.url }}" target="_blank" rel="noopener">{{ term|typo }}</a>{{ parts[1]|typo }}{% else %}<a href="{{ doc.url }}" target="_blank" rel="noopener">{{ doc.checkbox|typo }}</a>{% endif %}</label>
  </div>
  {% if privacy %}
  <p class="check__note"><a href="{{ site.footer.legal.privacy.url }}" target="_blank" rel="noopener">{{ site.footer.legal.privacy.label }}</a></p>
  {% endif %}
  <p class="field__err" id="{{ prefix }}-{{ name }}-err" hidden></p>
</div>
{%- endmacro %}

{#- Honeypot: a text field people never see (off-screen, not display:none — bots skip hidden fields), out of the tab
    order. A filled hp_note marks the request as spam on the server. -#}
{% macro honeypot(prefix) -%}
<div class="hp" aria-hidden="true">
  <label for="{{ prefix }}-hp">Оставьте это поле пустым</label>
  <input type="text" id="{{ prefix }}-hp" name="hp_note" value="" tabindex="-1" autocomplete="off">
</div>
{%- endmacro %}

{#- «Не получилось отправить»: shown by main.js / trust.js when the API stays unreachable after the retries (the request
    waits in this browser and goes out later). Phone, Telegram and MAX as the way out. what: «заявку» | «отзыв».
    [data-fail-lost] replaces [data-fail-saved] (DSH.failMode) when the server will never take that request (400 / 413 / 415):
    it is not kept, so we don't promise to send it later.
    site.contacts_ready = false: no phone and messenger links — only the text. -#}
{% macro send_fail(what='заявку', saved='её') -%}
{% if not site.contacts_ready -%}
<p class="form-fail__text">Не получилось отправить {{ what }}. <span data-fail-saved>Мы сохранили {{ saved }} и&nbsp;отправим, когда появится связь.</span><span data-fail-lost hidden>Попробуйте отправить ещё раз чуть позже.</span></p>
{%- else -%}
<p class="form-fail__text">Не получилось отправить {{ what }}. <span data-fail-saved>Мы сохранили {{ saved }} и&nbsp;отправим, когда появится связь. Или напишите нам:</span><span data-fail-lost hidden>Позвоните или напишите нам:</span></p>
<p class="form-fail__links">
  <a class="form-fail__link" href="{{ site.phone.tel }}">{{ ui.icon('phone', sm=true) }}{{ site.phone.display }}</a>
  <a class="form-fail__link" href="{{ site.messengers.telegram.url }}" target="_blank" rel="noopener">{{ ui.icon('tg', sm=true) }}{{ site.messengers.telegram.label }}</a>
  <a class="form-fail__link" href="{{ site.messengers.max.url }}" target="_blank" rel="noopener">{{ ui.icon('max', sm=true) }}{{ site.messengers.max.label }}</a>
</p>
{%- endif %}
{%- endmacro %}

{#- «Куда написать»: Telegram / WhatsApp / MAX / Звонок (radio chips). prefix: 'lf' (lead form) | 'pm' (price modal).
    main.js reads the value: telegram | whatsapp | max | call. -#}
{% macro contact_field(prefix) -%}
<fieldset class="field seg" role="radiogroup" aria-describedby="{{ prefix }}-contact-err">
  <legend class="field__label">Куда написать</legend>
  <div class="seg__opts">
    <input type="radio" name="contact" id="{{ prefix }}-c-tg" value="telegram"><label for="{{ prefix }}-c-tg">{{ ui.icon('tg', sm=true) }}Telegram</label>
    <input type="radio" name="contact" id="{{ prefix }}-c-wa" value="whatsapp"><label for="{{ prefix }}-c-wa">{{ ui.icon('wa', sm=true) }}WhatsApp</label>
    <input type="radio" name="contact" id="{{ prefix }}-c-max" value="max"><label for="{{ prefix }}-c-max">{{ ui.icon('max', sm=true) }}MAX</label>
    <input type="radio" name="contact" id="{{ prefix }}-c-call" value="call"><label for="{{ prefix }}-c-call">{{ ui.icon('phone', sm=true) }}Звонок</label>
  </div>
  <p class="field__err" id="{{ prefix }}-contact-err" hidden></p>
</fieldset>
{%- endmacro %}

{#- Final lead form section (homepage «Заявка»). One per page — keep id="zayavka": the mobile sticky bar hides over it.
    The form is ONE column at every width: each field on its own row (client rule 13.10).
    title ≤ 5 words, line ≤ 90 chars. tone: studio/tint tone of the tile. breed: slug to preselect in the select.
    contacts=false: no phone / messengers in the tile (the page shows them itself, e.g. via caller); while
    site.contacts_ready is false the tile never shows them (the response-time note instead); cls: extra class
    on the tile; caller() → content after the tile inside the same section.
    local_time=false: the response-time note without «по московскому времени» (city pages). -#}
{% macro lead_form(title='Пришлём варианты щенков', line='Оставьте заявку, и мы пришлём варианты ваших будущих питомцев: фото, видео и цены', tone='peach', breed=none, id='zayavka', contacts=true, cls='', local_time=true) -%}
<section class="section container" id="{{ id }}" aria-labelledby="lead-title">
  <div class="lead tone--{{ tone }}{{ ' ' ~ cls if cls }}">
    <div class="lead__intro">
      <h2 class="h2" id="lead-title">{{ title|typo }}</h2>
      <p class="lead__line">{{ line|typo }}</p>
      {% if contacts and site.contacts_ready %}
      <div class="lead__contacts">
        <a class="lead__phone" href="{{ site.phone.tel }}">{{ site.phone.display }}</a>
        <span class="lead__msgrs">{{ msgr('telegram') }}{{ msgr('whatsapp') }}{{ msgr('max') }}</span>
      </div>
      {% else %}
      <p class="lead__note">{{ ui.icon('clock', sm=true) }}{{ (site.phone.response if local_time else site.phone.response_plain)|typo }}</p>
      {% endif %}
    </div>

    <div class="lead__box" data-lead-box>
      <form class="form" id="lead-form" data-lead-form data-prefix="lf" novalidate>
        <div class="form__grid">
          <div class="field">
            <label class="field__label" for="lf-name">Имя</label>
            <input class="input" id="lf-name" name="name" type="text" autocomplete="given-name" placeholder="Как к&nbsp;вам обращаться" required aria-describedby="lf-name-err">
            <p class="field__err" id="lf-name-err" hidden></p>
          </div>
          <div class="field">
            <label class="field__label" for="lf-phone">Телефон</label>
            <input class="input" id="lf-phone" name="phone" type="tel" inputmode="tel" autocomplete="tel" placeholder="+7 (___) ___-__-__" required aria-describedby="lf-phone-err" data-phone>
            <p class="field__err" id="lf-phone-err" hidden></p>
          </div>
          <div class="field">
            <label class="field__label" for="lf-breed">Какая порода интересует</label>
            <select class="input select" id="lf-breed" name="breed">
              {{ breed_options(breed)|indent(14) }}
            </select>
          </div>
          {{ contact_field('lf')|indent(10) }}
          {{ honeypot('lf')|indent(10) }}
          {{ consent_check('lf')|indent(10) }}
        </div>
        <button class="btn btn--ink btn--lg btn--block form__submit" type="submit" data-submit data-label="Получить подборку">Получить подборку</button>
      </form>
      <div class="form-fail" data-fail role="alert" hidden>
        {{ send_fail()|indent(8) }}
      </div>
      <div class="form-done" data-done tabindex="-1" hidden>
        <span class="form-done__ico" aria-hidden="true">{{ ui.icon('check') }}</span>
        <p class="form-done__title" data-done-text>Спасибо! Свяжемся с&nbsp;вами в&nbsp;течение рабочего дня</p>
      </div>
    </div>
  </div>
  {% if caller is defined %}{{ caller() }}{% endif %}
</section>
{%- endmacro %}

