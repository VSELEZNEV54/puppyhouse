{#- Content blocks: FAQ, reviews, SEO text. READ-ONLY for page-group agents.
    Import:  {% import "macros/blocks.html.j2" as blocks %} -#}
{% import "macros/ui.html.j2" as ui %}
{% import "macros/cards.html.j2" as cards %}
{% import "macros/forms.html.j2" as forms %}

{#- «Как купить щенка»: four steps and «Узнать цену» — the homepage block, also the second block of puppy pages. -#}
{% macro how_to_buy(id='kak-kupit', title='Как купить щенка') -%}
<section class="section container" id="{{ id }}" aria-labelledby="{{ id }}-title">
      {% call ui.section_head(title, id=id ~ '-title') %}{{ forms.price_button() }}{% endcall %}
      {{ ui.steps([
        {'title': 'Заявка', 'text': 'Оставьте номер — пришлём цену'},
        {'title': 'Видеозвонок', 'text': 'Знакомитесь со щенком онлайн'},
        {'title': 'Бронь', 'text': 'Договор и предоплата — щенок ваш'},
        {'title': 'Встреча', 'text': 'Забираете сами или привезём'},
      ]) }}
    </section>
{%- endmacro %}

{#- FAQ accordion list. items: faq.json items (or any {"q", "a"} dicts; "a" may be Markup with links).
    short=true uses item.short (homepage wording) when present. prefix makes ids unique if a page has two lists. -#}
{% macro faq_list(items, prefix='faq', short=false) -%}
<ul class="faq__list">
  {% for f in items %}
  {%- set qa = f.short if short and f.short else f %}
  <li class="faq__item">
    <h3 class="faq__q"><button class="faq__btn" type="button" aria-expanded="false" aria-controls="{{ prefix }}-a{{ loop.index }}" id="{{ prefix }}-q{{ loop.index }}">{{ qa.q|typo }}<span class="faq__ico" aria-hidden="true">{{ ui.icon('plus') }}</span></button></h3>
    <div class="faq__a" id="{{ prefix }}-a{{ loop.index }}"><div><p>{{ qa.a|typo }}</p></div></div>
  </li>
  {% endfor %}
</ul>
{%- endmacro %}

{#- FAQPage JSON-LD for the questions a faq_section renders (plain text). faq_section(ld=true) emits it — one FAQ
    section per page; pages that output their own FAQPage (/faq/, blog articles) pass ld=false. -#}
{% macro faq_ld(items, short=false) -%}
{%- set ents = [] -%}
{%- for f in items -%}
{%- set qa = f.short if short and f.short else f -%}
{%- set _ = ents.append({'@type': 'Question', 'name': (qa.q|string|striptags), 'acceptedAnswer': {'@type': 'Answer', 'text': (qa.a|string|striptags)}}) -%}
{%- endfor -%}
<script type="application/ld+json">{{ {'@context': 'https://schema.org', '@type': 'FAQPage', 'mainEntity': ents}|tojson }}</script>
{%- endmacro %}

{#- «Задать свой вопрос»: the shared modal with the question field; note — which block it came from -#}
{% macro ask_button(where='') -%}
<button class="btn btn--coral" type="button" data-open-modal data-modal-kind="consult" data-modal-question="1" data-modal-title="Задать свой вопрос" data-modal-sub="Ответим в&nbsp;течение рабочего дня по&nbsp;московскому времени" data-modal-note="Вопрос{{ ' из блока «' ~ (where|striptags) ~ '»' if where }}" data-modal-submit="Задать вопрос" data-modal-done="Спасибо! Ответим на&nbsp;ваш вопрос в&nbsp;течение рабочего дня">Задать свой вопрос</button>
{%- endmacro %}

{#- FAQ section: H2 + «Задать свой вопрос» on the left (sticky), accordion on the right (homepage layout).
    «Задать свой вопрос» (client 21.10, instead of «Все вопросы»): a coral button that opens the shared modal with the
    «Ваш вопрос» field (data-modal-question, kind consult). Desktop: under the H2; phones: under all the questions
    (main.css head-action rule). ask=false — no button (the /faq/ page lists many groups). -#}
{% macro faq_section(items, title='Частые вопросы', id='faq', ask=true, short=false, ld=true) -%}
<section class="section container" id="{{ id }}" aria-labelledby="{{ id }}-title">
  {% if ld and items %}{{ faq_ld(items, short=short) }}{% endif %}
  <div class="faq">
    <div class="faq__aside">
      <h2 class="h2" id="{{ id }}-title">{{ title|typo }}</h2>
      {% if ask %}{{ ask_button(title) }}{% endif %}
    </div>
    {{ faq_list(items, prefix=id, short=short)|indent(4) }}
  </div>
</section>
{%- endmacro %}

{#- Reviews section: rating tiles + review cards (one per row on phones). reviews: reviews.json items. -#}
{% macro reviews_section(reviews, title='Отзывы владельцев', id='otzyvy', title_id='reviews-title', link={'url': '/otzyvy/', 'label': 'Все отзывы'}, short=true) -%}
<section class="section container" id="{{ id }}" aria-labelledby="{{ title_id }}">
  {{ ui.section_head(title, id=title_id, link=link) }}
  <div class="reviews-wrap">
    {{ cards.ratings() }}
    <ul class="reviews">
      {% for r in reviews %}
      {{ cards.review_card(r, short=short) }}
      {% endfor %}
    </ul>
  </div>
</section>
{%- endmacro %}

{#- Collapsed SEO text (white tile): title + first paragraph clamped to 2 lines; caller() = the rest, hidden
    until «Читать полностью». Use h3 + p inside caller. Two blocks on one page need different id and key. -#}
{% macro seo_block(title, lead, id='o-pitomnike', key='seo') -%}
<section class="section container" id="{{ id }}" aria-labelledby="{{ key }}-title">
  <div class="seo">
    <h2 class="seo__title" id="{{ key }}-title">{{ title|typo }}</h2>
    <div class="seo__body" data-seo>
      <p class="seo__lead">{{ lead|typo }}</p>
      <div class="seo__more" id="{{ key }}-more" hidden>
        {{ caller() }}
      </div>
    </div>
    <button class="seo__toggle" type="button" aria-expanded="false" aria-controls="{{ key }}-more" data-seo-toggle><span data-seo-label>Читать полностью</span>{{ ui.icon('chevron', sm=true) }}</button>
  </div>
</section>
{%- endmacro %}

{#- Blog teasers: cards with a photo, title, one line and «Читать» (article cards for the homepage, breed and puppy pages).
    slugs: blog slugs in order (default: the first `limit` of data.blog), or posts: ready dicts
    [{"url", "title", "line", "cover": {"src", "alt", "pos"?}, "topic"}]. 3 per row on desktop (4 posts → 4),
    a compact list on phones (thumbnail left, text right). title → section with H2; without title — just the list. -#}
{#- «Полезные статьи» before the lead form of every inner page (client 19.10, layouts/page.html.j2 → block blog):
    3 articles — the page's breed first (breed = slug), then the general ones, then the rest. -#}
{% macro reading(breed=none, limit=3) -%}
{%- set own = (data.blog|selectattr('breed', 'equalto', breed)|list) if breed else [] -%}
{%- set general = data.blog|selectattr('breed', 'none')|list -%}
{%- set others = data.blog|rejectattr('breed', 'none')|rejectattr('breed', 'equalto', breed)|list -%}
{%- set slugs = ((own + general + others)|map(attribute='slug')|list)[:limit] -%}
{{ blog_teasers(slugs=slugs, title='Полезные статьи', id='poleznoe', lead='Характер, уход и выбор щенка: коротко и по делу', limit=limit) }}
{%- endmacro %}

{#- «Читайте также» (client 21.10): one block instead of «Полезные статьи» + «Ещё о …» / «Читайте также» on every
    page of a breed — the articles first (3 in a row, the breed's own first, as in reading()), then four plates of the
    breed's sections under them, the same everywhere: the breed page · its price page OR its varieties page
    (interchangeable: alt='varieties' on the price page, the price page everywhere else) · the puppy catalog · the
    breed quiz. Put it after the FAQ (or into {% block blog %}); the layout's «Полезные статьи» must not repeat it.
    b: breeds.json item; none on a page about all breeds (/faq/) — then the plates are the catalog, the quiz,
    «Документы и гарантии» and «Доставка». -#}
{% macro read_more(b=none, alt='price', title='Читайте также', id='eshche', limit=3) -%}
{%- set own = (data.blog|selectattr('breed', 'equalto', b.slug)|list) if b else [] -%}
{%- set general = data.blog|selectattr('breed', 'none')|list -%}
{%- set others = data.blog|rejectattr('breed', 'none')|rejectattr('breed', 'equalto', b.slug if b else none)|list -%}
{%- set slugs = ((own + general + others)|map(attribute='slug')|list)[:limit] -%}
{%- set catalog = {'url': '/shchenki/', 'title': 'Каталог щенков', 'line': 'Все щенки в наличии — ' ~ puppies|length, 'icon': 'paw', 'color': 'coral'} -%}
{%- set quiz = {'url': '/podbor-porody/', 'title': 'Подобрать породу', 'line': 'Тест на 2 минуты', 'icon': 'sparkle', 'color': 'lilac'} -%}
{%- if b -%}
{%- set second = {'url': b.urls.varieties, 'title': 'Виды и окрасы', 'line': 'Размеры и все окрасы с фото', 'icon': 'ruler', 'color': 'mint'}
    if alt == 'varieties' else
    {'url': b.urls.price, 'title': 'Цена щенка', 'line': 'От чего зависит и что входит', 'icon': 'wallet', 'color': 'sun'} -%}
{%- set links = [{'url': b.urls.hub, 'title': b.name, 'line': 'О породе и щенки в наличии', 'breed': b}, second, catalog, quiz] -%}
{%- else -%}
{%- set links = [catalog, quiz,
    {'url': '/dokumenty-i-garantii/', 'title': 'Документы и гарантии', 'line': 'Договор, ветпаспорт, прививки', 'icon': 'doc', 'color': 'sky'},
    {'url': '/dostavka/', 'title': 'Доставка', 'line': 'По Москве и в 60+ городов России', 'icon': 'car', 'color': 'mint'}] -%}
{%- endif -%}
<section class="section container rmore" id="{{ id }}" aria-labelledby="{{ id }}-title">
  {{ ui.section_head(title, id=id ~ '-title', link={'url': '/blog/', 'label': 'Все статьи'}) }}
  {{ blog_teasers(slugs=slugs, title=none, limit=limit) }}
  <div class="rmore__links">
    {{ ui.link_tiles(links) }}
  </div>
</section>
{%- endmacro %}

{% macro blog_teasers(slugs=none, posts=none, title='Гид по породам', id='blog', lead=none, link={'url': '/blog/', 'label': 'Все статьи'}, limit=3) -%}
{%- if posts is none -%}
  {%- set all = data.blog -%}
  {%- set slugs = slugs or (all|map(attribute='slug')|list)[:limit] -%}
  {%- set posts = [] -%}
  {%- for sl in slugs -%}
    {%- set meta = all|selectattr('slug', 'equalto', sl)|first -%}
    {%- set post = data.blog_posts.posts[sl] -%}
    {%- set topic = (breed_map[meta.breed].name ~ ' · ' ~ post.topic|lower) if meta.breed else post.topic -%}
    {%- set _ = posts.append({'url': meta.url, 'title': post.h1, 'line': post.card_line, 'cover': post.cover, 'topic': topic}) -%}
  {%- endfor -%}
{%- endif -%}
{%- set body -%}
<ul class="bteasers bteasers--{{ posts|length if posts|length <= 4 else 3 }}">
  {% for c in posts %}
  {%- set size = imgsize(c.cover.src) or [1264, 848] %}
  <li>
    <article class="bteaser">
      <div class="bteaser__media">
        <img src="{{ c.cover.src }}" alt="{{ c.cover.alt|typo }}" width="{{ size[0] }}" height="{{ size[1] }}"{% if c.cover.pos is defined and c.cover.pos %} style="object-position:{{ c.cover.pos }}"{% endif %} loading="lazy" decoding="async">
        {% if c.topic %}<span class="bteaser__topic">{{ c.topic|typo }}</span>{% endif %}
      </div>
      <div class="bteaser__body">
        <h3 class="bteaser__title"><a class="bteaser__link" href="{{ c.url }}">{{ ui.nohyph(c.title) }}</a></h3>
        <p class="bteaser__line">{{ c.line|typo }}</p>
        <span class="tcta tcta--soft" aria-hidden="true">Читать {{ ui.icon('arrow', sm=true) }}</span>
      </div>
    </article>
  </li>
  {% endfor %}
</ul>
{%- endset -%}
{% if title %}
<section class="section container" id="{{ id }}" aria-labelledby="{{ id }}-title">
  {{ ui.section_head(title, id=id ~ '-title', link=link, lead=lead) }}
  {{ body }}
</section>
{% else %}
{{ body }}
{% endif %}
{%- endmacro %}
