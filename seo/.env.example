# ────────────────────────────────────────────────────────────────────────────
#  Доступы к API для инструментов seo/.  РЕАЛЬНЫХ КЛЮЧЕЙ ЗДЕСЬ БЫТЬ НЕ ДОЛЖНО.
#
#  Скопировать и заполнить:   cp seo/.env.example seo/.env && chmod 600 seo/.env
#  Где взять каждое значение: 2-ДОСТУПЫ-К-API.md (номер раздела указан рядом)
#  Проверить, что получилось: node seo/cli/doctor.mjs
#
#  Два места хранения, оба читаются (локальное сильнее):
#    ~/.seo-tools/.env   общий файл на все проекты одного владельца —
#                        токен Яндекса и ключ Google выданы АККАУНТУ, а не
#                        сайту, и копировать их в каждый проект незачем;
#    seo/.env            этот файл: то, что у проекта своё, и переопределения.
#  Оба закрыты в .gitignore. Права 600 — иначе файл читает любой пользователь
#  машины, а в нём лежит всё сразу.
# ────────────────────────────────────────────────────────────────────────────

# ── Яндекс: один токен на Метрику и Вебмастер (раздел 1) ───────────────────
# Приложение на oauth.yandex.ru, тип «Для доступа к API или отладки».
# Права: metrika:read, metrika:write, webmaster:hostinfo, webmaster:verify.
YANDEX_CLIENT_ID=
YANDEX_CLIENT_SECRET=
# Заполняются сами командой `node seo/cli/yandex-token.mjs exchange <код>`
# — руками эти три строки не трогают.
YANDEX_OAUTH_TOKEN=
YANDEX_OAUTH_REFRESH=
YANDEX_OAUTH_EXPIRES=

# ── Google Search Console (раздел 2) ───────────────────────────────────────
# Ключ сервисного аккаунта — ФАЙЛОМ, не переменной:
#   seo/keys/google-service-account.json   (или ~/.seo-tools/google-service-account.json)
# Переменная нужна только если файл лежит в другом месте.
GOOGLE_SERVICE_ACCOUNT_KEY=

# ── PageSpeed Insights + Chrome UX Report (раздел 3) ───────────────────────
# Ключ API из того же проекта Google Cloud. Без ключа API не работает совсем:
# общая анонимная квота исчерпана.
GOOGLE_API_KEY=

# ── Bing Webmaster Tools — необязательно (раздел 5) ────────────────────────
BING_API_KEY=

# ── Яндекс.Директ — только при платной рекламе (раздел 6) ──────────────────
# ОТДЕЛЬНОЕ приложение с единственным правом direct:api. Дописывать direct:api
# в приложение из раздела 1 нельзя: смена прав отзывает все его токены.
YANDEX_DIRECT_TOKEN=
YANDEX_DIRECT_LOGIN=

# ── Переопределения настроек проекта (обычно не нужны) ─────────────────────
# Эти значения берутся из seo/project.json. Здесь — только чтобы подменить
# их на один запуск или на одну машину.
#SEO_SITE_HOST=
#YANDEX_METRIKA_COUNTER=
#GSC_SITE_URL=
#YANDEX_WEBMASTER_HOST_ID=
#INDEXNOW_KEY=
