# Database passwords → copy to /etc/domshchenkov/db.env (outside the repo!, chmod 600).
# Used only by docker compose for ${…} substitution:  docker compose --env-file /etc/domshchenkov/db.env up -d
#   DSH_OWNER_DB_PASSWORD    — schema owner, used by the one-shot `migrate` service only
#   DSH_APP_DB_PASSWORD      — the API and the worker (read/write data, no DDL)
#   DSH_READONLY_DB_PASSWORD — optional: SELECT on the leads_* views only (BI, the admin panel's DB tools)
DSH_OWNER_DB_PASSWORD=change-me-long-random
DSH_APP_DB_PASSWORD=change-me-long-random
DSH_READONLY_DB_PASSWORD=
