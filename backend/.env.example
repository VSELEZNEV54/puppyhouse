# Application settings → copy to /etc/domshchenkov/api.env (outside the repo!, chmod 600). Never commit real values.
# The database passwords are NOT here: they go to /etc/domshchenkov/db.env (see db.env.example), which only
# docker compose reads, so the API process never sees the schema owner's password.

DSH_ENV=prod
DSH_TIMEZONE=Europe/Moscow

# The site and /api are on one origin behind nginx → no CORS for the site.
# The admin panel on another origin (e.g. https://admin.example.ru) needs CORS:
DSH_ADMIN_CORS_ORIGINS=
# link in notifications, {id} = request number
DSH_ADMIN_BASE_URL=

# Notifications
# Telegram (outside Russia): messages carry NO personal data. DSH_TELEGRAM_INCLUDE_PD=true adds name and phone
# ONLY for requests whose consent version has "cross_border": true in src/data/consent.json — publish such a
# version (its text must name the transfer abroad) and file the notice to Роскомнадзор first (ст. 12 152-ФЗ).
DSH_TELEGRAM_BOT_TOKEN=
DSH_TELEGRAM_CHAT_ID=
# a chat per breed key (maltipu, buldog, pudel, kolli):
DSH_TELEGRAM_BREED_CHATS={}
DSH_TELEGRAM_INCLUDE_PD=false
# Bot API address. Change only to send through your own relay outside Russia if api.telegram.org is slow
# or blocked from the server:
# DSH_TELEGRAM_API_BASE=https://api.telegram.org
# E-mail with full details — SMTP of a Russian provider (Яндекс 360: smtp.yandex.ru:465)
DSH_SMTP_HOST=
DSH_SMTP_PORT=465
DSH_SMTP_SSL=true
DSH_SMTP_USER=
DSH_SMTP_PASSWORD=
DSH_SMTP_FROM=
DSH_NOTIFY_EMAILS=
# After editing: `dsh app notify-check` (bot, chats, mailbox login), `--send` sends test messages, then `dsh restart`
# Webhook for the admin panel: receives {event, id, public_id}, signed with HMAC-SHA256 (X-Dsh-Signature)
DSH_WEBHOOK_URL=
DSH_WEBHOOK_SECRET=

# Retention, days (match the privacy policy and the consent text)
DSH_KEEP_CONTACTS_DAYS=1095
DSH_KEEP_EVENTS_DAYS=180
DSH_KEEP_IP_DAYS=30
DSH_KEEP_SPAM_DAYS=30
# Pages viewed before a request are linked to the person only while the consent text names this purpose
DSH_LINK_SITE_ACTIVITY=true

# Secret for the keyed hashes of destroyed phone numbers (erasure records). 24+ random characters; set once and
# keep forever, outside the database backups: `python -m app reapply-erasures` needs the same value after a restore.
DSH_ERASURE_SECRET=change-me-long-random
