#!/usr/bin/env bash
# dsh — everyday commands for the дом-щенков.рф server (installed to /usr/local/bin/dsh by deploy.sh). Run as root.
#   dsh status                         containers, API health, the current release
#   dsh logs [api|worker|migrate|postgres] [-f]
#   dsh app <command> [args]           backend CLI, e.g.: dsh app create-admin --login olga --name "Ольга" --role manager
#                                      (dsh app --help lists them all: create-api-key, sync-catalog, purge, …)
#   dsh app notify-test                a test message to the Telegram chats and mailboxes of api.env
#   dsh app notify-retry               send now the notifications that failed (24 h) or wait for a retry
#   dsh restart                        restart the API and the worker with the settings from /etc/domshchenkov/api.env
#   dsh backup                         an encrypted database backup now (same as the nightly one)
#   dsh update                         git pull in /opt/domshchenkov/src and deploy (pass deploy.sh options after it)
#   dsh rollback                       start the previous release again (API + site; the database stays as it is)
#   dsh domain                         addresses: what points here, certificates; gets the certificate of дом-щенков.рф
#                                      (+ www, dom-shchenkov.ru) once their DNS points here and deploys again (dsh www —
#                                      the same). With autoupdate on this happens by itself within 5 minutes
#   dsh autoupdate on|off|status       every 5 minutes: a new commit on the branch of /opt/domshchenkov/src is deployed
#                                      by itself (a commit that failed to deploy is not retried until the next one);
#                                      log: /var/log/domshchenkov-deploy.log, the running release: /api/v1/health.
#                                      The same run publishes the blog by its schedule (dsh blog run)
#   dsh blog [status|run]              the blog's schedule (content/blog/published.json): an article goes out on its day at
#                                      10:00 Moscow time — `run` rebuilds the site files from the checkout when what is due
#                                      (tools/blog/factory.py stamp) differs from what is on the site, then tells Yandex
#                                      (IndexNow). API, database and nginx are not touched
set -euo pipefail
APP_ROOT="${DSH_APP_ROOT:-/opt/domshchenkov}"
ETC="${DSH_ETC:-/etc/domshchenkov}"
STATE="$APP_ROOT/state"
DOCROOT="${DSH_DOCROOT:-/var/www/domshchenkov}"
CUR="$(cat "$STATE/root" 2>/dev/null || readlink -f "$APP_ROOT/current" 2>/dev/null || true)"
[ -n "$CUR" ] && [ -f "$CUR/backend/docker-compose.yml" ] || { echo "dsh: нет выложенного релиза ($APP_ROOT/current)" >&2; exit 1; }
export DSH_VERSION="$(cat "$STATE/version" 2>/dev/null || echo latest)"
export DSH_INITDB_DIR="$APP_ROOT/initdb"
compose() { docker compose -f "$CUR/backend/docker-compose.yml" --env-file "$ETC/db.env" "$@"; }
wait_api() {  # up to 90 s; 503 counts as running (it reports a problem, e.g. stuck notifications)
  local code=000
  for _ in $(seq 1 45); do
    code="$(curl -s -m 5 --noproxy "*" -o /dev/null -w '%{http_code}' http://127.0.0.1:8000/api/v1/health || true)"
    if [ "$code" = 200 ] || [ "$code" = 503 ]; then return 0; fi
    sleep 2
  done
  echo "API не ответил (код $code): dsh logs api" >&2
  return 1
}

# ---- blog: the schedule of content/blog/published.json (an article goes out on its day at 10:00 Moscow time)
blog_stamp() {  # what should be on the site now (count, links on, hash); empty — no blog in this checkout
  [ -f "$APP_ROOT/src/tools/blog/factory.py" ] || return 0
  python3 "$APP_ROOT/src/tools/blog/factory.py" stamp 2>/dev/null || true
}
blog_refresh() {  # the site files only, from the deployed checkout: same build and copy as deploy.sh, nothing else
  local src="$APP_ROOT/src" want py="$APP_ROOT/build-venv/bin/python" rel_log out
  want="$(blog_stamp)"
  [ -n "$want" ] || return 0
  [ "$want" = "$(cat "$STATE/blog-stamp" 2>/dev/null || true)" ] && return 0
  [ -x "$py" ] || py=python3
  echo "=== $(date -Is) блог: по графику изменилось, что должно быть на сайте ($want) — пересобираю страницы"
  rel_log="$(mktemp)"
  if ! DSH_BUILD_PYTHON="$py" bash "$src/tools/release.sh" --out "$APP_ROOT/releases" --no-tar > "$rel_log" 2>&1; then
    cat "$rel_log"; rm -f "$rel_log"
    echo "$(date -Is) блог: сборка не прошла — на сайте прежние страницы; следующая попытка через 5 минут"
    return 1
  fi
  out="$(sed -n 's/^RELEASE_DIR=//p' "$rel_log")"; rm -f "$rel_log"
  if [ -z "$out" ] || [ ! -f "$out/site/index.html" ] || [ ! -f "$out/site/404.html" ]; then
    echo "$(date -Is) блог: в сборке нет сайта — на сайте прежние страницы"; [ -n "$out" ] && rm -rf "$out"; return 1
  fi
  # called as `blog_refresh || true`: set -e is off inside, so every step checks itself
  if ! bash "$out/backend/deploy/sealed.sh" key "$ETC" "$out/site" \
     || ! rsync -a --delete --delay-updates --chmod=D755,F644 "$out/site/" "$DOCROOT/"; then   # as deploy.sh
    rm -rf "$out"; echo "$(date -Is) блог: страницы не скопировались — следующая попытка через 5 минут"; return 1
  fi
  rm -rf "$out"
  echo "$want" > "$STATE/blog-stamp"
  echo "$(date -Is) блог: страницы обновлены ($want)"
  python3 "$src/tools/blog/factory.py" indexnow || true   # today's articles → Yandex
}

cmd="${1:-status}"; shift || true
case "$cmd" in
  status)
    echo "релиз: $DSH_VERSION ($CUR)"
    compose ps
    printf "health: "; curl -s -m 5 --noproxy "*" -w ' (HTTP %{http_code})\n' http://127.0.0.1:8000/api/v1/health || echo "API не отвечает"
    ;;
  logs)
    svc="${1:-api}"; shift || true
    compose logs --tail 200 "$@" "$svc"
    ;;
  app)
    # the password of create-admin can come from DSH_ADMIN_PASSWORD (otherwise it is asked for)
    env_args=(); [ -n "${DSH_ADMIN_PASSWORD:-}" ] && env_args=(-e DSH_ADMIN_PASSWORD)
    compose run --rm "${env_args[@]}" migrate python -m app "$@"
    ;;
  restart)
    # recreate, not `compose restart`: a restarted container keeps the environment it was created with, so edits
    # of api.env (Telegram, mail) would not apply
    compose up -d --no-deps --force-recreate api worker
    wait_api && echo "API и воркер перезапущены с настройками из $ETC/api.env"
    ;;
  backup)
    set -a; . "$ETC/backup.env"; set +a
    "$CUR/backend/deploy/backup.sh"
    ;;
  update)
    src="$APP_ROOT/src"
    [ -d "$src/.git" ] || { echo "dsh: нет git-копии в $src (выкладка из архива: распакуйте новый релиз и запустите его deploy.sh)" >&2; exit 1; }
    git -C "$src" pull --ff-only
    exec "$src/backend/deploy/deploy.sh" "$@"
    ;;
  autoupdate)
    src="$APP_ROOT/src"
    cron=/etc/cron.d/domshchenkov-autoupdate
    log=/var/log/domshchenkov-deploy.log
    sub="${1:-status}"
    case "$sub" in
      on)
        [ -d "$src/.git" ] || { echo "dsh: автообновление работает от git-копии в $src" >&2; exit 1; }
        printf '%s\n' "# дом-щенков.рф: deploy new commits of $(git -C "$src" rev-parse --abbrev-ref HEAD) (dsh autoupdate off — stop)" \
          "SHELL=/bin/bash" "PATH=/usr/local/sbin:/usr/local/bin:/usr/sbin:/usr/bin:/sbin:/bin" \
          "*/5 * * * * root /usr/local/bin/dsh autoupdate run >> $log 2>&1" > "$cron"
        printf '%s\n' "$log {" "  weekly" "  rotate 8" "  compress" "  missingok" "  notifempty" "}" > /etc/logrotate.d/domshchenkov-deploy
        echo "Автообновление включено: каждые 5 минут новый коммит ветки $(git -C "$src" rev-parse --abbrev-ref HEAD) выкладывается сам."
        echo "Журнал: $log. Выключить: dsh autoupdate off"
        ;;
      off)
        rm -f "$cron"; echo "Автообновление выключено (обновлять вручную: dsh update)"
        ;;
      status)
        if [ -f "$cron" ]; then echo "автообновление: включено"; else echo "автообновление: выключено"; fi
        cat "$STATE/autoupdate" 2>/dev/null || true
        echo "блог: на сайте $(cat "$STATE/blog-stamp" 2>/dev/null || echo —), по графику сейчас $(blog_stamp)"
        [ -f "$log" ] && tail -n 5 "$log" || true
        ;;
      run)  # cron
        exec 9>/run/domshchenkov-autoupdate.lock
        flock -n 9 || exit 0                       # the previous run is still deploying
        git -C "$src" fetch -q origin
        remote="$(git -C "$src" rev-parse '@{u}')"
        if [ "$remote" = "$(git -C "$src" rev-parse HEAD)" ]; then
          # no new commit — but the addresses may have changed: дом-щенков.рф (or www, dom-shchenkov.ru) now points
          # here and got its certificate → deploy the same commit again, the site moves to it (deploy/domain.sh)
          dom=(env "DSH_STATE=$STATE" bash "$src/backend/deploy/domain.sh")
          if [ -f "$src/backend/deploy/domain.sh" ] && "${dom[@]}" due; then
            echo "=== $(date -Is) адреса сайта изменились ($("${dom[@]}" stamp)) — выкладываю ${remote:0:8} заново"
            if "$src/backend/deploy/deploy.sh"; then
              echo "$(date -Is) выложен ${remote:0:8} на https://$("${dom[@]}" canon)" | tee "$STATE/autoupdate"
            else
              "${dom[@]}" stamp > "$STATE/domain-failed"   # not again for the same addresses: wait for a fix
              echo "$(date -Is) адреса изменились, но выкладка не прошла — работает прошлая; подробности выше в $log" | tee "$STATE/autoupdate"
            fi
          fi
          blog_refresh || true   # an article of the blog's schedule is due (10:00 Moscow) → the site files again
          exit 0
        fi
        [ "$remote" = "$(cat "$STATE/autoupdate-failed" 2>/dev/null || true)" ] && exit 0   # failed before: wait for a fix
        echo "=== $(date -Is) новый коммит ${remote:0:8}: $(git -C "$src" log -1 --format=%s "$remote")"
        git -C "$src" reset -q --hard "$remote"    # a deploy-only checkout: nobody edits files there
        stamp="$(blog_stamp)"                      # taken before the build: the build shows at least this
        if "$src/backend/deploy/deploy.sh"; then
          [ -n "$stamp" ] && echo "$stamp" > "$STATE/blog-stamp"
          python3 "$src/tools/blog/factory.py" indexnow >/dev/null 2>&1 || true
          rm -f "$STATE/autoupdate-failed"
          echo "$(date -Is) выложен ${remote:0:8}" | tee "$STATE/autoupdate"
        else
          echo "$remote" > "$STATE/autoupdate-failed"
          echo "$(date -Is) НЕ выложен ${remote:0:8} — работает прошлый релиз; подробности выше в $log" | tee "$STATE/autoupdate"
        fi
        ;;
      *) echo "dsh autoupdate on|off|status" >&2; exit 2 ;;
    esac
    ;;
  blog)
    # the blog's schedule: status — what is on the site and what is due; run — rebuild the site files if they differ
    # (autoupdate does this every 5 minutes; by hand: dsh blog run). Schedule: python3 tools/blog/factory.py status
    case "${1:-status}" in
      status)
        echo "на сайте: $(cat "$STATE/blog-stamp" 2>/dev/null || echo —)"
        echo "по графику сейчас: $(blog_stamp)"
        python3 "$APP_ROOT/src/tools/blog/factory.py" status 2>/dev/null | head -3 || true
        ;;
      run)
        exec 9>/run/domshchenkov-autoupdate.lock
        flock 9   # waits for a running deploy
        blog_refresh
        ;;
      *) echo "dsh blog status|run" >&2; exit 2 ;;
    esac
    ;;
  domain|www)
    # the site's addresses (deploy/domain.sh): status, the certificate of дом-щенков.рф once its DNS points here,
    # then the same release again so nginx serves the new address and the 301s
    src="$APP_ROOT/src"
    dom=(env "DSH_STATE=$STATE" bash "$CUR/backend/deploy/domain.sh")
    [ -f "$src/backend/deploy/domain.sh" ] && dom=(env "DSH_STATE=$STATE" bash "$src/backend/deploy/domain.sh")
    "${dom[@]}" status
    DSH_FORCE=1 "${dom[@]}" cert          # at once, with certbot's own words if it fails
    if "${dom[@]}" due; then
      echo "Адреса изменились — выкладываю текущую версию заново"
      if [ -d "$src/.git" ]; then exec "$src/backend/deploy/deploy.sh" "$@"; else exec "$CUR/backend/deploy/deploy.sh" "$@"; fi
    fi
    echo "Менять нечего: сайт работает на https://$("${dom[@]}" canon)"
    ;;
  rollback)
    pv="$(cat "$STATE/prev_version" 2>/dev/null || true)"; pr="$(cat "$STATE/prev_root" 2>/dev/null || true)"
    [ -n "$pv" ] && [ -f "$pr/backend/docker-compose.yml" ] || { echo "dsh: прошлого релиза нет" >&2; exit 1; }
    echo "Откат на $pv (база не откатывается: миграции только добавляют)"
    docker image inspect "domshchenkov-api:$pv" >/dev/null
    DSH_VERSION="$pv" DSH_INITDB_DIR="$APP_ROOT/initdb" docker compose -f "$pr/backend/docker-compose.yml" --env-file "$ETC/db.env" up -d --no-deps api worker
    rsync -a --delete --delay-updates --chmod=D755,F644 "$pr/site/" /var/www/domshchenkov/
    docker tag "domshchenkov-api:$pv" domshchenkov-api:latest
    cp "$STATE/version" "$STATE/prev_version"; cp "$STATE/root" "$STATE/prev_root"
    echo "$pv" > "$STATE/version"; echo "$pr" > "$STATE/root"; ln -sfn "$pr" "$APP_ROOT/current"
    wait_api
    echo "Готово: работает $pv. Вернуться обратно: dsh rollback"
    ;;
  -h|--help|help)
    sed -n '2,16p' "$0"
    ;;
  *)
    echo "dsh: неизвестная команда $cmd (dsh help)" >&2; exit 2
    ;;
esac
